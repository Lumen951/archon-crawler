<%# Link to the "First" page
  - available local variables
    url:           url to the first page
    current_page:  a page object for the currently displayed page
    total_pages:   total number of pages
    per_page:      number of items to fetch per page
    remote:        data-remote
-%>
<%= link_to url, remote: remote, class: "h-9 px-2 inline-flex items-center justify-center rounded-lg border border-border-primary bg-bg-card text-text-primary text-sm font-medium hover:border-brand hover:text-brand transition", title: t("views.pagination.first") do %>
  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"/>
  </svg>
<% end %>
