<div id="<%= dom_id(task, :card) %>" class="bg-bg-card border border-border-primary rounded-lg p-4">
  <div class="flex items-start justify-between mb-3">
    <div class="flex-1">
      <div class="text-sm font-semibold text-text-primary mb-1">
        正文下载任务
      </div>
      <%= render 'shared/status_badge', status: task.status %>
    </div>
  </div>

  <div class="space-y-2 text-sm">
    <div class="flex justify-between">
      <span class="text-text-secondary">进度:</span>
      <span class="text-text-primary font-medium"><%= task.progress_percentage %>%</span>
    </div>
    <div class="flex justify-between">
      <span class="text-text-secondary">成功/失败:</span>
      <span class="text-text-primary font-medium"><%= task.articles_downloaded %>/<%= task.articles_failed %></span>
    </div>
    <% if task.running? %>
      <div class="flex justify-between">
        <span class="text-text-secondary">心跳:</span>
        <span class="text-text-primary"><%= time_ago_in_words(task.heartbeat_at) %>前</span>
      </div>
    <% end %>
    <div class="flex justify-between">
      <span class="text-text-secondary">开始时间:</span>
      <span class="text-text-primary">
        <% if task.started_at %>
          <%= time_ago_in_words(task.started_at) %>前
        <% else %>
          -
        <% end %>
      </span>
    </div>
    <div class="flex justify-between">
      <span class="text-text-secondary">耗时:</span>
      <span class="text-text-primary">
        <% if task.finished_at && task.started_at %>
          <%= distance_of_time_in_words(task.started_at, task.finished_at) %>
        <% elsif task.running? %>
          运行中...
        <% else %>
          -
        <% end %>
      </span>
    </div>
  </div>

  <% if task.error_message.present? %>
    <div class="mt-3 pt-3 border-t border-border-primary">
      <p class="text-xs text-red-600 truncate" title="<%= task.error_message %>">
        <%= task.error_message %>
      </p>
    </div>
  <% end %>

  <div class="mt-4 pt-3 border-t border-border-primary flex items-center gap-2 flex-wrap">
    <%= link_to wechat_content_download_task_path(task), class: "flex-1 h-9 px-4 rounded-lg bg-bg-secondary text-brand hover:bg-brand hover:text-white font-semibold text-sm transition inline-flex items-center justify-center" do %>
      详情
    <% end %>
    <%= link_to logs_wechat_content_download_task_path(task), class: "flex-1 h-9 px-4 rounded-lg bg-bg-secondary text-brand hover:bg-brand hover:text-white font-semibold text-sm transition inline-flex items-center justify-center" do %>
      日志
    <% end %>
  </div>
</div>
