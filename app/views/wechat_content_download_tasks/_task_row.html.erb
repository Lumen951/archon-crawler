<tr id="<%= dom_id(task, :row) %>" class="hover:bg-bg-secondary transition">
  <td class="px-6 py-4 whitespace-nowrap">
    <%= render 'shared/status_badge', status: task.status %>
    <% if task.error_message.present? %>
      <div class="mt-1 text-xs text-red-600 max-w-xs truncate" title="<%= task.error_message %>">
        <%= task.error_message %>
      </div>
    <% end %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap">
    <div class="text-sm text-text-primary font-medium"><%= task.progress_percentage %>%</div>
    <div class="text-xs text-text-muted mt-0.5">
      成功 <%= task.articles_downloaded %> / 失败 <%= task.articles_failed %> / 共 <%= task.articles_total %>
    </div>
  </td>
  <td class="px-6 py-4 whitespace-nowrap text-sm text-text-secondary">
    <% if task.running? %>
      <%= time_ago_in_words(task.heartbeat_at) %>前
    <% else %>
      -
    <% end %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap text-sm text-text-secondary">
    <% if task.started_at %>
      <%= time_ago_in_words(task.started_at) %>前
    <% else %>
      -
    <% end %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap text-sm text-text-secondary">
    <% if task.finished_at && task.started_at %>
      <%= distance_of_time_in_words(task.started_at, task.finished_at) %>
    <% elsif task.running? %>
      运行中...
    <% else %>
      -
    <% end %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
    <div class="flex items-center justify-end gap-2">
      <%= link_to wechat_content_download_task_path(task), class: "text-brand hover:text-brand-dark font-semibold transition" do %>
        详情
      <% end %>
      <%= link_to logs_wechat_content_download_task_path(task), class: "text-brand hover:text-brand-dark font-semibold transition" do %>
        日志
      <% end %>
    </div>
  </td>
</tr>
