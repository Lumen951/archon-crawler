<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<div class="space-y-6"
     <% if @task.running? %>
       data-controller="task-poller"
       data-task-poller-url-value="<%= poll_wechat_content_download_task_path(@task) %>"
       data-task-poller-interval-value="3000"
     <% end %>>
  <div>
    <h1 class="text-2xl font-bold text-text-primary">正文下载任务详情</h1>
    <p class="text-text-secondary mt-1">
      <%= link_to "← 返回所有任务", wechat_content_download_tasks_path, class: "text-primary hover:underline" %>
    </p>
  </div>

  <%= render 'show_body', task: @task, recent_logs: @recent_logs %>
</div>
