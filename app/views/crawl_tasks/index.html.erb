<div class="space-y-8">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold text-text-primary">抓取任务</h1>
      <p class="text-text-secondary mt-2">监控和管理文章抓取任务</p>
    </div>
    <%= button_to crawl_all_crawl_tasks_path, method: :post,
        class: "h-10 px-5 rounded-xl bg-brand text-white hover:bg-brand-dark font-semibold text-sm transition inline-flex items-center justify-center gap-2 shadow-[0_7px_16px_rgba(59,130,246,.14)]",
        data: { confirm: "为所有活跃公众号启动抓取任务？" } do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
      </svg>
      抓取所有公众号
    <% end %>
  </div>

  <!-- Filter Tabs -->
  <div class="flex space-x-2 border-b border-border-primary overflow-x-auto">
    <%= link_to "全部", crawl_tasks_path, class: "px-4 py-2.5 text-sm font-semibold whitespace-nowrap transition #{params[:status].blank? ? 'border-b-2 border-brand text-brand' : 'text-text-secondary hover:text-brand'}" %>
    <%= link_to "运行中", crawl_tasks_path(status: 'running'), class: "px-4 py-2.5 text-sm font-semibold whitespace-nowrap transition #{params[:status] == 'running' ? 'border-b-2 border-brand text-brand' : 'text-text-secondary hover:text-brand'}" %>
    <%= link_to "已完成", crawl_tasks_path(status: 'completed'), class: "px-4 py-2.5 text-sm font-semibold whitespace-nowrap transition #{params[:status] == 'completed' ? 'border-b-2 border-brand text-brand' : 'text-text-secondary hover:text-brand'}" %>
    <%= link_to "失败", crawl_tasks_path(status: 'failed'), class: "px-4 py-2.5 text-sm font-semibold whitespace-nowrap transition #{params[:status] == 'failed' ? 'border-b-2 border-brand text-brand' : 'text-text-secondary hover:text-brand'}" %>
  </div>

  <!-- Tasks Table -->
  <% if @crawl_tasks.any? %>
    <!-- Desktop Table -->
    <div class="hidden md:block bg-bg-card border border-border-primary rounded-2xl overflow-hidden shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
      <table class="min-w-full divide-y divide-border-primary">
        <thead class="bg-bg-secondary">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">范围</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">状态</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">进度</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">错误</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">开始时间</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">耗时</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-text-secondary uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="bg-bg-card divide-y divide-border-primary">
          <% @crawl_tasks.each do |task| %>
            <tr class="hover:bg-bg-secondary transition">
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-text-primary">
                  <% if task.account_ids.nil? %>
                    全部活跃公众号
                  <% else %>
                    <%= task.account_count %> 个公众号
                  <% end %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <%= render 'shared/status_badge', status: task.status %>
                <% if task.error_message.present? %>
                  <div class="mt-1 text-xs text-red-600 max-w-xs truncate" title="<%= task.error_message %>">
                    <%= task.error_message %>
                  </div>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="text-sm text-text-secondary"><%= task.progress %> 篇文章</span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% if task.error_count > 0 %>
                  <span class="text-sm text-red-600 font-semibold"><%= task.error_count %></span>
                <% else %>
                  <span class="text-sm text-text-muted">0</span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-text-secondary">
                <% if task.started_at %>
                  <%= time_ago_in_words(task.started_at) %>前
                <% else %>
                  待开始
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-text-secondary">
                <% if task.completed_at && task.started_at %>
                  <%= distance_of_time_in_words(task.started_at, task.completed_at) %>
                <% elsif task.running? %>
                  运行中...
                <% else %>
                  -
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <div class="flex items-center justify-end gap-2">
                  <%= link_to crawl_task_path(task), class: "text-brand hover:text-brand-dark font-semibold transition" do %>
                    详情
                  <% end %>
                  <%= link_to logs_crawl_task_path(task), class: "text-brand hover:text-brand-dark font-semibold transition" do %>
                    日志
                  <% end %>
                  <% if task.running? %>
                    <%= button_to pause_crawl_task_path(task), method: :post, class: "h-8 px-3 rounded-lg bg-yellow-100 text-yellow-700 hover:bg-yellow-200 text-xs font-semibold transition" do %>
                      暂停
                    <% end %>
                  <% elsif task.paused? %>
                    <%= button_to resume_crawl_task_path(task), method: :post, class: "h-8 px-3 rounded-lg bg-brand text-white hover:bg-brand-dark text-xs font-semibold transition" do %>
                      恢复
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Mobile Cards -->
    <div class="md:hidden space-y-4">
      <% @crawl_tasks.each do |task| %>
        <div class="bg-bg-card border border-border-primary rounded-xl p-4 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
          <div class="flex items-start justify-between mb-3">
            <div class="flex-1">
              <div class="text-sm font-semibold text-text-primary mb-1">
                <% if task.account_ids.nil? %>
                  全部活跃公众号
                <% else %>
                  <%= task.account_count %> 个公众号
                <% end %>
              </div>
              <%= render 'shared/status_badge', status: task.status %>
            </div>
          </div>

          <div class="space-y-2 text-sm">
            <div class="flex justify-between">
              <span class="text-text-secondary">进度:</span>
              <span class="text-text-primary font-medium"><%= task.progress %> 篇文章</span>
            </div>
            <% if task.error_count > 0 %>
              <div class="flex justify-between">
                <span class="text-text-secondary">错误:</span>
                <span class="text-red-600 font-semibold"><%= task.error_count %></span>
              </div>
            <% end %>
            <div class="flex justify-between">
              <span class="text-text-secondary">开始时间:</span>
              <span class="text-text-primary">
                <% if task.started_at %>
                  <%= time_ago_in_words(task.started_at) %>前
                <% else %>
                  待开始
                <% end %>
              </span>
            </div>
            <div class="flex justify-between">
              <span class="text-text-secondary">耗时:</span>
              <span class="text-text-primary">
                <% if task.completed_at && task.started_at %>
                  <%= distance_of_time_in_words(task.started_at, task.completed_at) %>
                <% elsif task.running? %>
                  运行中...
                <% else %>
                  -
                <% end %>
              </span>
            </div>
          </div>

          <% if task.error_message.present? %>
            <div class="mt-3 pt-3 border-t border-border-primary">
              <p class="text-xs text-red-600 truncate" title="<%= task.error_message %>">
                <%= task.error_message %>
              </p>
            </div>
          <% end %>

          <div class="mt-4 pt-3 border-t border-border-primary flex items-center gap-2 flex-wrap">
            <%= link_to crawl_task_path(task), class: "flex-1 h-9 px-4 rounded-lg bg-bg-secondary text-brand hover:bg-brand hover:text-white font-semibold text-sm transition inline-flex items-center justify-center" do %>
              详情
            <% end %>
            <%= link_to logs_crawl_task_path(task), class: "flex-1 h-9 px-4 rounded-lg bg-bg-secondary text-brand hover:bg-brand hover:text-white font-semibold text-sm transition inline-flex items-center justify-center" do %>
              日志
            <% end %>
            <% if task.running? %>
              <%= button_to pause_crawl_task_path(task), method: :post, class: "flex-1 h-9 px-4 rounded-lg bg-yellow-100 text-yellow-700 hover:bg-yellow-200 font-semibold text-sm transition" do %>
                暂停
              <% end %>
            <% elsif task.paused? %>
              <%= button_to resume_crawl_task_path(task), method: :post, class: "flex-1 h-9 px-4 rounded-lg bg-brand text-white hover:bg-brand-dark font-semibold text-sm transition" do %>
                恢复
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <% if @crawl_tasks.respond_to?(:total_pages) && @crawl_tasks.total_pages > 1 %>
      <div class="mt-6">
        <%= paginate @crawl_tasks %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-bg-card border border-border-primary rounded-2xl text-center py-12 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
      <svg class="w-16 h-16 mx-auto text-text-muted mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
      </svg>
      <p class="text-text-secondary">未找到抓取任务</p>
    </div>
  <% end %>
</div>
