<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<div class="space-y-6"
     <% if @crawl_task.running? || @crawl_task.pending? %>
       data-controller="task-poller"
       data-task-poller-url-value="<%= poll_crawl_task_path(@crawl_task) %>"
       data-task-poller-interval-value="3000"
     <% end %>>
  <div>
    <h1 class="text-3xl font-bold text-gray-900">抓取任务详情</h1>
    <p class="text-gray-600 mt-1">
      <%= link_to "← 返回所有任务", crawl_tasks_path, class: "text-primary hover:underline" %>
    </p>
  </div>

  <%= render 'show_body', crawl_task: @crawl_task, recent_logs: @recent_logs %>
</div>
