<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<div class="space-y-6">
  <%= turbo_stream_from [@crawl_task, :show] %>

  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">抓取任务详情</h1>
      <p class="text-gray-600 mt-1">
        <%= link_to "← 返回所有任务", crawl_tasks_path, class: "text-primary hover:underline" %>
      </p>
    </div>
    <div class="flex items-center space-x-3">
      <% if @crawl_task.running? %>
        <%= button_to "暂停", pause_crawl_task_path(@crawl_task), method: :post, class: "btn btn-warning" %>
        <% if @crawl_task.failed_account_count > 0 %>
          <%= button_to "重试失败帐号 (#{@crawl_task.failed_account_count})", resume_crawl_task_path(@crawl_task), method: :post, class: "btn btn-primary", data: { turbo_confirm: "这将暂停当前任务并重试 #{@crawl_task.failed_account_count} 个失败的帐号。确定继续吗？" } %>
        <% end %>
        <%= button_to "标记失败", fail_crawl_task_path(@crawl_task), method: :post, data: { turbo_confirm: "确定要将此任务标记为失败吗？" }, class: "btn btn-danger" %>
      <% elsif @crawl_task.paused? || @crawl_task.failed? %>
        <%= button_to "恢复", resume_crawl_task_path(@crawl_task), method: :post, class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>

  <%= render 'show_body', crawl_task: @crawl_task, recent_logs: @recent_logs %>
</div>
