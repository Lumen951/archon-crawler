<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-text-primary">任务抓取的文章</h1>
    <p class="text-sm text-text-secondary mt-1">
      任务 #<%= @crawl_task.id %>
      <% if @crawl_task.started_at %>
        · <%= @crawl_task.started_at.strftime('%Y-%m-%d %H:%M') %>
      <% end %>
      · 共 <%= @crawl_task.articles.count %> 篇文章
    </p>
    <p class="text-text-secondary mt-1">
      <%= link_to "← 返回抓取任务", @crawl_task, class: "text-primary hover:underline" %>
    </p>
  </div>

  <% if @articles.any? %>
    <div class="space-y-3">
      <%= render partial: "articles/card", collection: @articles, as: :article %>
    </div>
    <% if @articles.respond_to?(:total_pages) && @articles.total_pages > 1 %>
      <div class="mt-6"><%= paginate @articles %></div>
    <% end %>
  <% else %>
    <div class="bg-bg-card border border-border-primary rounded-lg text-center py-12">
      <svg class="w-16 h-16 mx-auto text-text-muted mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
      <p class="text-text-secondary">该任务暂无抓取到的文章</p>
    </div>
  <% end %>
</div>
