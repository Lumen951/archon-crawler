<div id="<%= dom_id(crawl_task, :show_body) %>" class="space-y-6" data-task-status="<%= crawl_task.status %>">
  <!-- Task Info Card -->
  <div class="card">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h2 class="text-xl font-semibold text-gray-900">
          <% if crawl_task.account_ids.nil? %>
            全部启用的帐号
          <% else %>
            <%= crawl_task.account_count %> 个帐号
          <% end %>
        </h2>
        <p class="text-sm text-gray-600 mt-1">
          <%= crawl_task.account_names.first(5).join("、") %>
          <% if crawl_task.account_count > 5 %>
            等 <%= crawl_task.account_count %> 个
          <% end %>
        </p>
      </div>
      <div class="flex items-center space-x-3">
        <%= render 'shared/status_badge', status: crawl_task.status %>
        <% if crawl_task.running? %>
          <%= button_to "暂停", pause_crawl_task_path(crawl_task), method: :post, class: "btn btn-warning" %>
          <%= button_to "标记失败", fail_crawl_task_path(crawl_task), method: :post, data: { turbo_confirm: "确定要将此任务标记为失败吗？" }, class: "btn btn-danger" %>
        <% elsif crawl_task.paused? || crawl_task.failed? %>
          <%= button_to "重试抓取未完成的帐号", resume_crawl_task_path(crawl_task), method: :post, class: "btn btn-primary" %>
        <% end %>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mt-6">
      <div>
        <p class="text-sm text-gray-600">已抓取文章</p>
        <p class="text-2xl font-bold text-gray-900">
          <% if crawl_task.articles.any? %>
            <%= link_to articles_crawl_task_path(crawl_task), class: "text-brand hover:text-brand-dark font-semibold transition" do %>
              <%= crawl_task.progress %>
            <% end %>
          <% else %>
            <%= crawl_task.progress %>
          <% end %>
        </p>
      </div>
      <div>
        <p class="text-sm text-gray-600">累计错误</p>
        <% if crawl_task.platform_error_counts.present? && crawl_task.platform_error_counts.any? %>
          <p class="text-2xl font-bold <%= crawl_task.error_count > 0 ? 'text-red-600' : 'text-gray-900' %>"><%= crawl_task.error_count %></p>
          <div class="mt-1 space-x-2">
            <% crawl_task.platform_error_counts.each do |platform, count| %>
              <% next if count.to_i.zero? %>
              <span class="inline-block text-xs px-1.5 py-0.5 rounded bg-red-50 text-red-700"><%= platform.sub('Account', '') %>: <%= count %></span>
            <% end %>
          </div>
        <% else %>
          <p class="text-2xl font-bold <%= crawl_task.error_count > 0 ? 'text-red-600' : 'text-gray-900' %>"><%= crawl_task.error_count %></p>
        <% end %>
      </div>
      <div>
        <p class="text-sm text-gray-600">开始时间</p>
        <p class="text-lg font-semibold text-gray-900"><%= crawl_task.started_at&.strftime('%Y-%m-%d %H:%M') || '无' %></p>
      </div>
      <div>
        <p class="text-sm text-gray-600">完成时间</p>
        <p class="text-lg font-semibold text-gray-900"><%= crawl_task.completed_at&.strftime('%Y-%m-%d %H:%M') || '无' %></p>
      </div>
      <div>
        <p class="text-sm text-gray-600">总耗时</p>
        <p class="text-lg font-semibold text-gray-900">
          <% if crawl_task.completed_at && crawl_task.started_at %>
            <%= distance_of_time_in_words(crawl_task.started_at, crawl_task.completed_at) %>
          <% elsif crawl_task.running? && crawl_task.started_at %>
            <span class="text-green-600" data-controller="elapsed-time" data-elapsed-time-start-value="<%= crawl_task.started_at.to_i %>">
              <span data-elapsed-time-target="display">--:--:--</span>
            </span>
          <% else %>
            -
          <% end %>
        </p>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mt-4">
      <div>
        <p class="text-sm text-gray-600">帐号并发</p>
        <p class="text-lg font-semibold text-gray-900"><%= crawl_task.effective_account_concurrency %></p>
      </div>
      <div>
        <p class="text-sm text-gray-600">文章并发</p>
        <p class="text-lg font-semibold text-gray-900"><%= crawl_task.effective_article_concurrency %></p>
      </div>
      <div>
        <p class="text-sm text-gray-600">重试次数</p>
        <p class="text-lg font-semibold <%= crawl_task.retry_count > 0 ? 'text-orange-600' : 'text-gray-900' %>">
          <%= crawl_task.retry_count %> / <%= CrawlTask::MAX_RETRIES %>
        </p>
      </div>
    </div>

    <% if crawl_task.error_message.present? %>
      <div class="mt-6 p-4 bg-red-50 border border-red-200 rounded-lg">
        <p class="text-sm font-medium text-red-900">错误：</p>
        <p class="text-sm text-red-700 mt-1"><%= crawl_task.error_message %></p>
      </div>
    <% end %>
  </div>

  <!-- Account Status -->
  <% if crawl_task.crawl_task_accounts.any? %>
    <div class="card" data-controller="collapsible">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-bold text-gray-900">帐号状态</h2>
        <div class="flex items-center space-x-4 text-sm">
          <span class="text-green-600">✓ 完成 <%= crawl_task.completed_account_count %></span>
          <span class="text-yellow-600">● 进行中 <%= crawl_task.crawl_task_accounts.running.count %></span>
          <span class="text-gray-500">○ 待处理 <%= crawl_task.crawl_task_accounts.pending.count %></span>
          <% if crawl_task.failed_account_count > 0 %>
            <span class="text-red-600">✗ 失败 <%= crawl_task.failed_account_count %></span>
          <% end %>
        </div>
      </div>

      <%
        all_accounts = crawl_task.crawl_task_accounts.includes(:account).order(Arel.sql("CASE status WHEN 0 THEN 0 WHEN 3 THEN 1 WHEN 1 THEN 2 WHEN 2 THEN 3 END"))
        preview_limit = 10
        has_more = all_accounts.size > preview_limit
      %>

      <div class="space-y-2">
        <% all_accounts.first(preview_limit).each do |ta| %>
          <%= render 'crawl_tasks/account_status_row', ta: ta %>
        <% end %>
      </div>

      <% if false && has_more %>
        <div class="hidden space-y-2" data-collapsible-target="content">
          <% all_accounts.drop(preview_limit).each do |ta| %>
            <%= render 'crawl_tasks/account_status_row', ta: ta %>
          <% end %>
        </div>

        <button type="button"
                data-collapsible-target="toggle"
                data-action="collapsible#toggle"
                class="mt-3 w-full py-2 text-sm text-brand hover:text-brand-dark font-medium transition flex items-center justify-center gap-1">
          展开剩余 <%= all_accounts.size - preview_limit %> 个帐号
          <svg class="w-4 h-4 transition-transform" data-collapsible-target="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
      <% end %>
    </div>
  <% end %>

  <!-- Recent Logs -->
  <div class="card">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-xl font-bold text-gray-900">最近日志</h2>
      <%= link_to "查看所有日志 →", logs_crawl_task_path(crawl_task), class: "text-primary hover:underline text-sm font-medium" %>
    </div>

    <% if recent_logs.any? %>
      <div class="space-y-2 font-mono text-sm">
        <% recent_logs.each do |log| %>
          <div class="flex items-start space-x-3 py-2 border-b border-gray-100 last:border-0">
            <span class="text-xs text-gray-500 whitespace-nowrap">
              <%= log.logged_at.strftime('%H:%M:%S') %>
            </span>
            <span class="px-2 py-0.5 rounded text-xs font-medium <%= case log.level when 'error' then 'bg-red-100 text-red-800' when 'warn' then 'bg-yellow-100 text-yellow-800' when 'info' then 'bg-blue-100 text-blue-800' else 'bg-gray-100 text-gray-700' end %>">
              <%= log.level.upcase %>
            </span>
            <span class="flex-1 <%= log.level == 'error' ? 'text-red-700' : 'text-gray-700' %>">
              <%= log.message %>
            </span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500 text-center py-8">
        暂无日志
        <% unless Option.verbose_mode? %>
          <br>
          <span class="text-sm">详细日志已禁用。在<%= link_to "设置", admin_settings_path, class: "text-primary underline" %>中启用</span>
        <% end %>
      </p>
    <% end %>
  </div>
</div>
