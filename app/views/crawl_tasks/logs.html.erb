<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">抓取任务日志</h1>
      <p class="text-gray-600 mt-1">
        <%= link_to "← 返回任务详情", crawl_task_path(@crawl_task), class: "text-primary hover:underline" %>
      </p>
    </div>
  </div>

  <!-- Task Info -->
  <div class="card">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-xl font-semibold text-gray-900">
          <% if @crawl_task.account_ids.nil? %>
            全部启用的帐号
          <% else %>
            <%= @crawl_task.account_count %> 个帐号
          <% end %>
        </h2>
        <p class="text-sm text-gray-600 mt-1">
          开始于 <%= @crawl_task.started_at&.strftime('%Y-%m-%d %H:%M:%S') || '未开始' %>
          <%= render 'shared/status_badge', status: @crawl_task.status %>
        </p>
      </div>
      <div class="text-right text-sm text-gray-600">
        <p><%= @logs.total_count %> 条日志</p>
      </div>
    </div>
  </div>

  <!-- Filter Bar -->
  <div class="card">
    <%= form_with url: logs_crawl_task_path(@crawl_task), method: :get, class: "flex flex-wrap items-end gap-3" do |f| %>
      <div class="flex-1 min-w-[200px]">
        <label for="q" class="block text-sm font-medium text-gray-700 mb-1">搜索日志内容</label>
        <%= f.text_field :q, value: params[:q], placeholder: "输入关键词...", class: "w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary text-sm" %>
      </div>
      <div>
        <label for="level" class="block text-sm font-medium text-gray-700 mb-1">日志级别</label>
        <%= f.select :level,
            options_for_select([
              ["全部级别", ""],
              ["DEBUG", "debug"],
              ["INFO", "info"],
              ["WARN", "warn"],
              ["ERROR", "error"]
            ], params[:level]),
            {},
            class: "rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary text-sm" %>
      </div>
      <div class="flex gap-2">
        <%= f.submit "筛选", class: "btn btn-primary text-sm" %>
        <%= link_to "重置", logs_crawl_task_path(@crawl_task), class: "btn btn-secondary text-sm" %>
      </div>
    <% end %>
  </div>

  <!-- Logs -->
  <div class="card">
    <% if @logs.any? %>
      <div class="space-y-2 font-mono text-sm">
        <% @logs.each do |log| %>
          <div class="flex items-start space-x-3 py-2 border-b border-gray-100 last:border-0">
            <span class="text-xs text-gray-500 whitespace-nowrap">
              <%= log.logged_at.strftime('%H:%M:%S.%L') %>
            </span>
            <span class="px-2 py-0.5 rounded text-xs font-medium <%= case log.level when 'error' then 'bg-red-100 text-red-800' when 'warn' then 'bg-yellow-100 text-yellow-800' when 'info' then 'bg-blue-100 text-blue-800' else 'bg-gray-100 text-gray-700' end %>">
              <%= log.level.upcase %>
            </span>
            <span class="flex-1 <%= log.level == 'error' ? 'text-red-700' : 'text-gray-700' %>">
              <%= log.message %>
            </span>
          </div>
        <% end %>
      </div>

      <div class="mt-6">
        <%= paginate @logs %>
      </div>
    <% else %>
      <p class="text-gray-500 text-center py-8">暂无日志</p>
    <% end %>
  </div>

  <% if !Option.verbose_mode? %>
    <div class="card bg-yellow-50 border-yellow-200">
      <p class="text-sm text-yellow-800">
        ℹ️ 详细日志当前已禁用。在<%= link_to "设置", admin_settings_path, class: "font-semibold underline" %>中启用以查看详细日志。
      </p>
    </div>
  <% end %>
</div>

<% content_for :head do %>
  <style>
    .log-level-debug { @apply bg-gray-100 text-gray-700; }
    .log-level-info { @apply bg-blue-100 text-blue-800; }
    .log-level-warn { @apply bg-yellow-100 text-yellow-800; }
    .log-level-error { @apply bg-red-100 text-red-800; }
  </style>
<% end %>
