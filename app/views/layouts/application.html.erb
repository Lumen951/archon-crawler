<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Mp Crawler" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Mp Crawler">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="referrer" content="no-referrer">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen flex flex-col bg-[var(--bg-primary)] text-[var(--text-primary)] antialiased">
    <%= render 'shared/header' %>

    <main class="flex-1 w-full px-4 sm:px-6 lg:px-8 py-6 sm:py-8 <%= 'pb-20 md:pb-8' if current_user %>">
      <%# Toast container — Turbo Streams append here; initial flashes are converted by Stimulus %>
      <%
        flash_messages = {}
        flash_messages["success"] = flash[:success] || flash[:notice] if flash[:success].present? || flash[:notice].present?
        flash_messages["error"]   = flash[:error]   || flash[:alert]  if flash[:error].present?   || flash[:alert].present?
        flash_messages["warning"] = flash[:warning]                   if flash[:warning].present?
      %>
      <div id="toasts" data-controller="toast" data-toast-target="container"
           class="fixed bottom-20 md:bottom-6 right-4 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none"
           <% if flash_messages.any? %>data-flash="<%= flash_messages.to_json %>"<% end %>>
      </div>

      <% if defined?(@api_key_expires_soon) && @api_key_expires_soon %>
        <div class="mb-4 bg-yellow-50 border border-yellow-200 text-yellow-800 px-4 py-3 rounded-lg">
          ⚠️ 您的 API 密钥即将过期，请在<%= link_to "设置", admin_settings_path, class: "font-semibold underline" %>中更新。
        </div>
      <% end %>

      <%= yield %>
    </main>

    <% if current_user %>
      <!-- Mobile Bottom Navigation -->
      <nav class="md:hidden fixed bottom-0 left-0 right-0 bg-bg-header backdrop-blur-md border-t border-border-primary z-40">
        <div class="flex items-center justify-around h-16 px-2">
          <%= link_to root_path, class: "flex flex-col items-center justify-center flex-1 h-full transition #{current_page?(root_path) ? 'text-brand' : 'text-text-secondary'}" do %>
            <svg class="w-5 h-5 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            <span class="text-xs font-medium">仪表板</span>
          <% end %>
          <%= link_to accounts_path, class: "flex flex-col items-center justify-center flex-1 h-full transition #{current_page?(accounts_path) ? 'text-brand' : 'text-text-secondary'}" do %>
            <svg class="w-5 h-5 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
            <span class="text-xs font-medium">帐号</span>
          <% end %>
          <%= link_to crawl_tasks_path, class: "flex flex-col items-center justify-center flex-1 h-full transition #{current_page?(crawl_tasks_path) ? 'text-brand' : 'text-text-secondary'}" do %>
            <svg class="w-5 h-5 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
            <span class="text-xs font-medium">任务</span>
          <% end %>
        </div>
      </nav>
    <% end %>
  </body>
</html>
