<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= @paper.title %> · Archon</title>
    <style>
      :root { color-scheme: light; }
      * { box-sizing: border-box; }
      body { margin: 0; background: #f5f3ee; color: #252a30; font: 18px/1.8 Georgia, "Noto Serif", serif; }
      .reader-nav { padding: 16px 24px; border-bottom: 1px solid #dad7cf; background: #faf9f6; font: 14px/1.6 sans-serif; }
      .reader-nav a { margin-right: 20px; }
      main { max-width: 980px; padding: 40px 56px 80px; margin: 24px auto; background: white; }
      a { color: #176b73; overflow-wrap: anywhere; }
      h1, h2, h3, h4 { line-height: 1.3; margin-top: 1.6em; }
      h1 { font-size: 2em; }
      p { overflow-wrap: break-word; }
      img { max-width: 100%; height: auto; }
      figure { margin: 2em 0; }
      figcaption, .ltx_caption { font-size: .88em; line-height: 1.6; }
      table { max-width: 100%; border-collapse: collapse; margin: 1em 0; display: block; overflow-x: auto; }
      th, td { padding: 5px 8px; vertical-align: top; }
      pre { white-space: pre-wrap; overflow-wrap: anywhere; }
      math { font-family: "STIX Two Math", "Cambria Math", math; }
      math[display="block"], .ltx_equation, .ltx_equationgroup { overflow-x: auto; padding: 10px 0; }
      .ltx_align_center, .ltx_title_document, .ltx_authors { text-align: center; }
      .ltx_align_right { text-align: right; }
      .ltx_font_bold { font-weight: bold; }
      .ltx_font_italic { font-style: italic; }
      .ltx_small { font-size: .85em; }
      .ltx_note_content { display: block; font-size: .85em; border-left: 2px solid #dad7cf; padding-left: 12px; }
      .ltx_biblist { padding-left: 24px; font-size: .9em; }
      @media (max-width: 640px) {
        body { font-size: 16px; } main { margin: 0; padding: 24px 18px 48px; } h1 { font-size: 1.6em; }
      }
    </style>
  </head>
  <body>
    <nav class="reader-nav">
      <%= link_to "← 返回论文详情", paper_path(@paper) %>
      <%= link_to "arXiv 原文", @full_text.source_url, target: "_blank", rel: "noopener noreferrer" %>
      <span>本地保存 · v<%= @full_text.version %> · <%= @full_text.downloaded_at&.strftime("%Y-%m-%d") %></span>
    </nav>
    <main><%= sanitize @article_html, tags: PaperFullTextDownloader::TAGS, attributes: PaperFullTextDownloader::ATTRIBUTES + %w[href src rel target] %></main>
  </body>
</html>
