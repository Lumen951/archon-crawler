<div class="space-y-6">
  <div>
    <p><%= link_to "← 返回论文库", papers_path, class: "text-sm text-primary hover:underline" %></p>
    <h1 class="mt-3 text-2xl font-bold text-text-primary"><%= @paper.title %></h1>
    <p class="mt-2 text-sm text-text-secondary"><%= @paper.authorships.order(:position).map(&:display_name).join("、") %></p>
    <p class="mt-3"><%= link_to "我的关注作者", paper_subscriptions_path, class: "text-sm text-primary hover:underline" %></p>
  </div>
  <% if @paper.sources.any?(&:arxiv?) %>
    <div class="rounded-lg border border-border-primary bg-bg-card p-5">
      <h2 class="font-semibold text-text-primary">关注作者</h2>
      <p class="mt-2 text-sm text-text-secondary">关注后自动回溯 arXiv 历史论文。姓名命中先列为候选，需要确认归属。</p>
      <div class="mt-4 flex flex-wrap gap-4">
        <% @paper.authorships.each do |authorship| %>
          <div class="space-y-2 text-sm">
            <p><%= authorship.display_name %></p>
            <% if (subscription = @subscriptions_by_author[authorship.paper_author_id]) %>
              <%= link_to subscription.enabled? ? "查看关注与历史论文" : "查看已暂停的关注", paper_subscription_path(subscription), class: "btn btn-secondary" %>
            <% else %>
              <%= button_to "关注并回溯", paper_subscriptions_path, params: { authorship_id: authorship.id }, class: "btn btn-primary" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
  <% @paper.sources.select(&:arxiv?).each do |source| %>
    <% full_texts = source.full_texts.order(version: :desc).to_a %>
    <div class="rounded-lg border border-border-primary bg-bg-card p-5">
      <h2 class="font-semibold text-text-primary">全文阅读</h2>
      <p class="mt-2 text-sm text-text-secondary">保存正文、图片与公式，下载完成后可在本地阅读。全文下载不影响摘要导入。</p>
      <% full_texts.each do |full_text| %>
        <div class="mt-4 space-y-2 text-sm">
          <p>v<%= full_text.version %> · <%= full_text.status_label %></p>
          <% if full_text.error_message.present? %>
            <p class="text-text-secondary"><%= full_text.error_message %></p>
          <% end %>
          <% if full_text.locally_available? %>
            <%= link_to "阅读全文", read_paper_path(@paper, full_text_id: full_text.id), data: { turbo: false }, class: "btn btn-primary" %>
          <% elsif full_text.retryable? && full_text.version == source.arxiv_version %>
            <% if full_text.status_ready? %><p>本地文件缺失，请重新下载。</p><% end %>
            <%= button_to "重试全文下载", download_full_text_paper_path(@paper), params: { source_id: source.id }, class: "btn btn-secondary" %>
          <% end %>
        </div>
      <% end %>
      <% unless full_texts.any? { |record| record.version == source.arxiv_version } %>
        <div class="mt-4">
          <%= button_to "下载 HTML 全文", download_full_text_paper_path(@paper), params: { source_id: source.id }, class: "btn btn-primary" %>
        </div>
      <% end %>
      <p class="mt-3 text-xs text-text-muted">没有 HTML 的论文仍可通过下方来源链接阅读；下载中可刷新此页查看状态。</p>
    </div>
  <% end %>
  <div class="rounded-lg border border-border-primary bg-bg-card p-5">
    <h2 class="font-semibold text-text-primary">摘要</h2>
    <p class="mt-3 whitespace-pre-line text-sm leading-7 text-text-secondary"><%= @paper.abstract.presence || "暂无摘要" %></p>
  </div>
  <div class="rounded-lg border border-border-primary bg-bg-card p-5">
    <h2 class="font-semibold text-text-primary">来源</h2>
    <ul class="mt-3 space-y-2 text-sm">
      <% @paper.sources.each do |source| %><li><%= link_to source.provider == "arxiv" ? "arXiv" : "OpenReview", source.canonical_url, target: "_blank", rel: "noopener", class: "text-primary hover:underline" %> <span class="text-text-muted">（<%= source.external_id %>）</span></li><% end %>
    </ul>
  </div>
</div>
