<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<div class="space-y-6"
     <% if @task.pending? || @task.running? %>
       data-controller="task-poller"
       data-task-poller-url-value="<%= poll_wechat_url_import_task_path(@task) %>"
       data-task-poller-interval-value="3000"
     <% end %>>
  <div>
    <h1 class="text-3xl font-bold text-gray-900">微信文章链接导入任务</h1>
    <p class="text-gray-600 mt-1">
      <%= link_to "← 返回导入页", import_wechat_page_accounts_path, class: "text-primary hover:underline" %>
    </p>
  </div>

  <%= render "show_body", task: @task %>
</div>
