<div class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-text-primary">文章搜索</h1>
      <p class="mt-1 text-sm text-text-secondary">
        <% if @articles.respond_to?(:total_count) %>
          <%= @articles.total_count %> 篇文章
        <% end %>
        <% if params[:keyword].present? %>
          · 关键词「<%= params[:keyword] %>」
        <% end %>
      </p>
    </div>
  </div>

  <%= form_with url: articles_path, method: :get, local: true, class: "bg-bg-card border border-border-primary rounded-lg p-4" do %>
    <div class="flex flex-col sm:flex-row gap-3">
      <div class="relative flex-1">
        <svg class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <%= text_field_tag :keyword, params[:keyword], placeholder: "搜索标题、摘要或正文…（多个词用空格分隔）", class: "w-full h-9 pl-9 pr-3 rounded-md border border-border-primary bg-bg-card text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-brand/15 focus:border-brand transition" %>
      </div>
      <%= select_tag :platform, options_for_select([["全部平台", ""], ["微信公众号", "wechat"], ["小红书", "rednote"], ["Twitter", "twitter"], ["网站", "website"]], params[:platform]), class: "h-9 px-3 rounded-md border border-border-primary bg-bg-card text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-brand/15 focus:border-brand transition", data: { controller: "auto-submit" } %>
      <button type="submit" class="btn btn-primary">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        搜索
      </button>
    </div>
  <% end %>

  <% if @articles.any? %>
    <div class="space-y-3">
      <%= render partial: "articles/card", collection: @articles, as: :article %>
    </div>
    <% if @articles.total_pages > 1 %>
      <div class="mt-6"><%= paginate @articles %></div>
    <% end %>
  <% else %>
    <div class="bg-bg-card border border-border-primary rounded-lg text-center py-12">
      <svg class="w-16 h-16 mx-auto text-text-muted mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 11 14 0z"/></svg>
      <p class="text-text-secondary">没有匹配的文章</p>
      <p class="text-text-muted text-sm mt-1">换个关键词试试</p>
    </div>
  <% end %>
</div>
