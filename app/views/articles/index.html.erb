<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-text-primary">文章搜索</h1>
      <p class="mt-1 text-sm text-text-secondary">
        <% if @articles.respond_to?(:total_count) %>
          <%= @articles.total_count %> 篇文章
        <% end %>
        <% if params[:keyword].present? %>
          · 关键词「<%= params[:keyword] %>」
        <% end %>
      </p>
    </div>
  </div>

  <!-- Search Form -->
  <%= form_with url: articles_path, method: :get, local: true, class: "bg-bg-card border border-border-primary rounded-lg p-4" do %>
    <div class="flex flex-col sm:flex-row gap-3">
      <div class="relative flex-1">
        <svg class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <%= text_field_tag :keyword, params[:keyword],
              placeholder: "搜索标题或摘要…（多个词用空格分隔）",
              class: "w-full h-9 pl-9 pr-3 rounded-md border border-border-primary bg-bg-card text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-brand/15 focus:border-brand transition" %>
      </div>
      <%= select_tag :platform,
            options_for_select([["全部平台", ""], ["微信公众号", "wechat"], ["小红书", "rednote"], ["Twitter", "twitter"], ["网站", "website"]], params[:platform]),
            class: "h-9 px-3 rounded-md border border-border-primary bg-bg-card text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-brand/15 focus:border-brand transition" %>
      <button type="submit"
              class="btn btn-primary">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        搜索
      </button>
    </div>
  <% end %>

  <% if @articles.any? %>
    <!-- Desktop Table -->
    <div class="hidden md:block bg-bg-card border border-border-primary rounded-lg overflow-hidden">
      <table class="min-w-full divide-y divide-border-primary">
        <thead class="bg-bg-secondary">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">标题</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">账号</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">发布时间</th>
          </tr>
        </thead>
        <tbody class="bg-bg-card divide-y divide-border-primary">
          <% @articles.each do |article| %>
            <tr class="hover:bg-bg-secondary transition">
              <td class="px-6 py-4">
                <div class="flex items-center gap-2">
                  <%= link_to article.title, article_path(article), target: "_blank", rel: "noopener noreferrer", class: "text-brand hover:text-brand-dark font-medium transition" %>
                  <%= link_to article.url, target: "_blank", rel: "noopener noreferrer", class: "text-text-muted hover:text-brand transition", title: "查看原文" do %>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                  <% end %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-text-secondary">
                <%= link_to article.account.nickname, account_path(article.account), class: "hover:text-brand transition" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-text-secondary">
                <%= article.published_at&.strftime('%Y-%m-%d') %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Mobile Cards -->
    <div class="md:hidden space-y-3">
      <% @articles.each do |article| %>
        <div class="bg-bg-card border border-border-primary rounded-lg p-4">
          <div class="flex items-start justify-between gap-2">
            <%= link_to article_path(article), target: "_blank", rel: "noopener noreferrer", class: "block flex-1" do %>
              <h3 class="font-semibold text-text-primary mb-2 line-clamp-2"><%= article.title %></h3>
            <% end %>
            <%= link_to article.url, target: "_blank", rel: "noopener noreferrer", class: "text-text-muted hover:text-brand transition flex-shrink-0 mt-1", title: "查看原文" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            <% end %>
          </div>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-text-secondary">
            <%= link_to article.account.nickname, account_path(article.account), class: "inline-flex items-center gap-1 hover:text-brand transition" %>
            <span class="inline-flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <%= article.published_at&.strftime('%Y-%m-%d') %>
            </span>
          </div>
        </div>
      <% end %>
    </div>

    <% if @articles.total_pages > 1 %>
      <div class="mt-6">
        <%= paginate @articles %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-bg-card border border-border-primary rounded-lg text-center py-12">
      <svg class="w-16 h-16 mx-auto text-text-muted mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
      <p class="text-text-secondary">没有匹配的文章</p>
      <p class="text-text-muted text-sm mt-1">换个关键词试试</p>
    </div>
  <% end %>
</div>
