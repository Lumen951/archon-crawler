<div class="w-full max-w-4xl mx-auto">
  <!-- Header -->
  <div class="mb-6">
    <div class="mb-4 inline-flex items-center gap-3 text-text-secondary">
      <% if @article.account.round_head_img.present? %>
        <img src="<%= @article.account.round_head_img %>" alt="<%= @article.account.nickname %>" class="h-8 w-8 rounded-full flex-shrink-0">
      <% else %>
        <div class="h-8 w-8 rounded-full bg-bg-secondary flex items-center justify-center text-text-secondary text-sm flex-shrink-0">
          <%= @article.account.rednote? ? '📕' : '💬' %>
        </div>
      <% end %>
      <span class="font-medium text-text-primary"><%= @article.account.nickname %></span>
      <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium <%= @article.account.platform_badge_class %>">
        <%= @article.account.platform_name %>
      </span>
    </div>

    <h1 class="text-2xl sm:text-2xl font-bold text-text-primary mb-4"><%= @article.title %></h1>

    <div class="flex flex-wrap items-center gap-4 text-sm text-text-secondary">
      <span class="inline-flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
        <%= @article.author.presence || @article.account.nickname %>
      </span>

      <% if @article.published_at %>
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <%= @article.published_at.strftime('%Y年%m月%d日') %>
        </span>
      <% end %>

      <%= link_to @article.url, target: "_blank", rel: "noopener noreferrer",
            class: "inline-flex items-center gap-1.5 text-brand hover:text-brand-dark font-medium transition" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
        查看原文
      <% end %>

      <% if @article.url&.include?("mp.weixin.qq.com/s") %>
        <%= link_to download_content_article_path(@article),
              data: { turbo_method: :post, turbo_confirm: "确定要重新下载文章内容吗？这将覆盖现有内容。" },
              class: "inline-flex items-center gap-1.5 text-amber-600 hover:text-amber-700 font-medium transition text-sm" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
          重新下载
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Content Analysis Panel -->
  <div class="mb-8 bg-bg-secondary border border-border-primary rounded-lg overflow-hidden hidden">
    <div class="px-6 py-4 bg-bg-card border-b border-border-primary">
      <h2 class="text-lg font-semibold text-text-primary flex items-center gap-2">
        <svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
        </svg>
        内容分析 <span class="text-sm font-normal text-text-muted">(对比预览)</span>
      </h2>
    </div>

    <div class="p-6 space-y-6">
      <!-- Metadata Row -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-bg-card rounded-lg p-3 border border-border-primary">
          <div class="text-xs text-text-muted mb-1">平台</div>
          <div class="font-medium text-text-primary"><%= @article.platform&.upcase %></div>
        </div>
        <div class="bg-bg-card rounded-lg p-3 border border-border-primary">
          <div class="text-xs text-text-muted mb-1">内容类型</div>
          <div class="font-medium text-text-primary"><%= @article.content_type %></div>
        </div>
        <div class="bg-bg-card rounded-lg p-3 border border-border-primary">
          <div class="text-xs text-text-muted mb-1">质量评分</div>
          <div class="font-medium <%= @article.content_quality_score >= 70 ? 'text-green-600' : @article.content_quality_score >= 40 ? 'text-yellow-600' : 'text-red-600' %>">
            <%= @article.content_quality_score %>/100
          </div>
        </div>
        <div class="bg-bg-card rounded-lg p-3 border border-border-primary">
          <div class="text-xs text-text-muted mb-1">媒体数量</div>
          <div class="font-medium text-text-primary"><%= @article.media_urls.size %> 个</div>
        </div>
      </div>

      <!-- Engagement Stats -->
      <% stats = @article.engagement_stats %>
      <% if stats.any? %>
        <div class="bg-bg-card rounded-lg p-4 border border-border-primary">
          <div class="text-sm font-medium text-text-secondary mb-3">互动数据</div>
          <div class="flex flex-wrap gap-4">
            <% stats.each do |key, value| %>
              <div class="flex items-center gap-1.5">
                <span class="text-lg font-semibold text-text-primary"><%= value %></span>
                <span class="text-xs text-text-muted"><%= key %></span>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Tags -->
      <% if @article.tags.any? %>
        <div class="bg-bg-card rounded-lg p-4 border border-border-primary">
          <div class="text-sm font-medium text-text-secondary mb-3">标签</div>
          <div class="flex flex-wrap gap-2">
            <% @article.tags.each do |tag| %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-brand/10 text-brand"><%= tag %></span>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Content Comparison -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <!-- Original -->
        <div class="bg-bg-card rounded-lg border border-border-primary overflow-hidden">
          <div class="px-4 py-2 bg-red-50 border-b border-border-primary">
            <div class="text-sm font-medium text-red-700">原始 content_markdown</div>
            <div class="text-xs text-red-500"><%= @article.content_markdown&.length || 0 %> 字符</div>
          </div>
          <div class="p-4 max-h-64 overflow-y-auto">
            <pre class="text-xs text-text-secondary whitespace-pre-wrap break-words"><%= @article.content_markdown&.truncate(1000) || "(空)" %></pre>
          </div>
        </div>

        <!-- Cleaned -->
        <div class="bg-bg-card rounded-lg border border-border-primary overflow-hidden">
          <div class="px-4 py-2 bg-green-50 border-b border-border-primary">
            <div class="text-sm font-medium text-green-700">清洗后 clean_content_markdown</div>
            <div class="text-xs text-green-500"><%= @article.clean_content_markdown&.length || 0 %> 字符</div>
          </div>
          <div class="p-4 max-h-64 overflow-y-auto">
            <pre class="text-xs text-text-secondary whitespace-pre-wrap break-words"><%= @article.clean_content_markdown&.truncate(1000) || "(空)" %></pre>
          </div>
        </div>
      </div>

      <!-- Best Digest -->
      <div class="bg-bg-card rounded-lg p-4 border border-brand/30">
        <div class="text-sm font-medium text-brand mb-2">推荐摘要 (best_digest)</div>
        <p class="text-text-primary"><%= @article.best_digest %></p>
      </div>

      <!-- Media Preview -->
      <% if @article.media_urls.any? %>
        <div class="bg-bg-card rounded-lg p-4 border border-border-primary">
          <div class="text-sm font-medium text-text-secondary mb-3">媒体资源 (<%= @article.media_urls.size %>)</div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
            <% @article.media_urls.first(4).each do |url| %>
              <img src="<%= url %>" alt="" class="w-full h-24 object-cover rounded-lg">
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Content -->
  <div class="bg-bg-card border border-border-primary rounded-lg overflow-hidden">
    <% if @cached_content.present? %>
      <div class="p-6 sm:p-8 article-content">
        <%= raw @cached_content %>
        <% if false %>
        <%= sanitize @cached_content,
              tags: %w[p br h1 h2 h3 h4 h5 h6 strong em a img ul ol li blockquote pre code span div section],
              attributes: %w[href src alt class style width height] %>
        <% end %>
      </div>
    <% elsif @article.best_digest.present? %>
      <div class="p-6 sm:p-8">
        <p class="text-text-secondary"><%= @article.best_digest %></p>
        <div class="mt-6 text-center">
          <%= link_to @article.url, target: "_blank", rel: "noopener noreferrer",
                class: "inline-flex items-center gap-2 text-brand hover:text-brand-dark font-medium transition" do %>
            查看完整文章
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="p-6 sm:p-8 text-center">
        <svg class="w-16 h-16 mx-auto text-text-muted mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        <p class="text-text-secondary mb-4">暂无文章内容</p>
        <%= link_to @article.url, target: "_blank", rel: "noopener noreferrer",
              class: "inline-flex items-center gap-2 text-brand hover:text-brand-dark font-medium transition" do %>
          前往原文查看
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Navigation -->
  <div class="mt-8 flex justify-between items-center">
    <% prev_article = @article.account.articles.where("published_at < ?", @article.published_at || Time.current).order(published_at: :desc).first %>
    <% next_article = @article.account.articles.where("published_at > ?", @article.published_at || Time.current).order(published_at: :asc).first %>

    <div>
      <% if prev_article %>
        <%= link_to article_path(prev_article), class: "inline-flex items-center gap-2 text-text-secondary hover:text-brand transition" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          <span class="hidden sm:inline"><%= prev_article.title.truncate(30) %></span>
          <span class="sm:hidden">上一篇</span>
        <% end %>
      <% end %>
    </div>

    <div>
      <% if next_article %>
        <%= link_to article_path(next_article), class: "inline-flex items-center gap-2 text-text-secondary hover:text-brand transition" do %>
          <span class="hidden sm:inline"><%= next_article.title.truncate(30) %></span>
          <span class="sm:hidden">下一篇</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<style>
  .article-content {
    line-height: 1.8;
    color: var(--text-primary, #1f2937);
    white-space: pre-wrap;
  }

  .article-content p {
    margin-bottom: 1em;
  }

  .article-content img {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
    margin: 1.5rem auto;
    display: block;
  }

  .article-content h1, .article-content h2, .article-content h3,
  .article-content h4, .article-content h5, .article-content h6 {
    font-weight: 700;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
    color: var(--text-primary, #111827);
  }

  .article-content h1 { font-size: 1.75rem; }
  .article-content h2 { font-size: 1.5rem; }
  .article-content h3 { font-size: 1.25rem; }

  .article-content a {
    color: var(--brand, #2563eb);
    text-decoration: underline;
  }

  .article-content a:hover {
    color: var(--brand-dark, #1d4ed8);
  }

  .article-content blockquote {
    border-left: 4px solid var(--border-primary, #e5e7eb);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--text-secondary, #6b7280);
    font-style: italic;
  }

  .article-content pre {
    background: var(--bg-secondary, #f9fafb);
    border: 1px solid var(--border-primary, #e5e7eb);
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .article-content code {
    background: var(--bg-secondary, #f9fafb);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }

  .article-content pre code {
    background: none;
    padding: 0;
  }

  .article-content ul, .article-content ol {
    margin: 1rem 0;
    padding-left: 1.5rem;
  }

  .article-content li {
    margin-bottom: 0.5rem;
  }

  .article-content section {
    margin-bottom: 1rem;
  }
</style>
