<div class="space-y-6">
  <div class="flex items-start justify-between">
    <div>
      <h1 class="text-2xl font-bold text-text-primary"><%= @account.nickname %></h1>
      <p class="text-text-secondary mt-1 flex items-center gap-3">
        <span class="px-2 py-0.5 rounded text-xs font-medium <%= @account.platform_badge_class %>">活动研究</span>
        <%= link_to "← 返回帐号列表", accounts_path, class: "text-primary hover:underline" %>
        <% if current_user_is_admin? %>
          <%= link_to "编辑活动配置", edit_event_account_path(@account), class: "text-primary hover:underline" %>
        <% end %>
      </p>
    </div>
  </div>

  <!-- 活动配置摘要 -->
  <% search_queries = event_search_queries(@account.nickname, keywords: @account.keywords) %>
  <div class="card">
    <h2 class="text-lg font-semibold text-text-primary mb-3">活动配置</h2>
    <dl class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
      <div>
        <dt class="text-text-secondary">研究目的</dt>
        <dd class="text-text-primary mt-0.5 whitespace-pre-wrap"><%= @account.purpose.presence || "—" %></dd>
      </div>
      <div>
        <dt class="text-text-secondary">追加关键词</dt>
        <dd class="mt-0.5">
          <% if @account.keywords.any? %>
            <div class="flex flex-wrap gap-1.5">
              <% @account.keywords.each do |keyword| %>
                <span class="px-2 py-0.5 rounded bg-amber-50 text-amber-700 text-xs"><%= keyword %></span>
              <% end %>
            </div>
          <% else %>
            <span class="text-text-primary">—</span>
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-text-secondary">指定页面（最先抓取的种子 URL）</dt>
        <dd class="text-text-primary mt-0.5 break-all">
          <% if @account.event_url.present? %>
            <%= link_to @account.event_url, @account.event_url, target: "_blank", rel: "noopener", class: "text-primary hover:underline" %>
          <% else %>
            —
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-text-secondary">其它背景信息</dt>
        <dd class="text-text-primary mt-0.5 whitespace-pre-wrap"><%= @account.other_information.presence || "—" %></dd>
      </div>
    </dl>

    <div class="mt-5 border-t border-border-primary pt-4">
      <h3 class="text-sm font-semibold text-text-primary">实际搜索组合</h3>
      <p class="mt-1 text-xs text-text-secondary">每轮调研会按以下顺序逐条搜索；单条失败不会阻断其它组合。</p>

      <div class="mt-3">
        <p class="text-xs font-medium text-text-secondary">固定搜索组合（13 条）</p>
        <div class="mt-1.5 flex flex-wrap gap-1.5">
          <% search_queries.fixed_queries.each do |query| %>
            <span class="rounded bg-bg-secondary px-2 py-1 text-xs text-text-primary"><%= query %></span>
          <% end %>
        </div>
      </div>

      <div class="mt-3">
        <p class="text-xs font-medium text-text-secondary">追加搜索组合</p>
        <% if search_queries.appended_queries.any? %>
          <div class="mt-1.5 flex flex-wrap gap-1.5">
            <% search_queries.appended_queries.each do |query| %>
              <span class="rounded bg-amber-50 px-2 py-1 text-xs text-amber-700"><%= query %></span>
            <% end %>
          </div>
        <% else %>
          <p class="mt-1 text-xs text-text-secondary">未配置追加关键词。</p>
        <% end %>
      </div>
    </div>
  </div>

  <% poll_worthy = @active_run.present? %>
  <div <% if poll_worthy %>data-controller="task-poller"
       data-task-poller-url-value="<%= poll_event_account_path(@account, run_id: @run&.id) %>"
       data-task-poller-interval-value="3000"<% end %>>
    <%= render 'research_body' %>
  </div>
</div>
