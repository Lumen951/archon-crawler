<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-text-primary">调研日志</h1>
      <p class="text-text-secondary mt-1">
        <%= link_to "← 返回 #{@account.nickname}", event_account_path(@account, run_id: @run&.id), class: "text-primary hover:underline" %>
        <% if @run %>
          · Run #<%= @run.id %>
          <span class="ml-1 px-2 py-0.5 rounded text-xs font-medium <%= @run.status_badge_class %>"><%= @run.status %></span>
        <% end %>
      </p>
    </div>
  </div>

  <!-- Filter Bar -->
  <div class="card">
    <%= form_with url: logs_event_account_path(@account, run_id: @run&.id), method: :get, class: "flex flex-wrap items-end gap-3" do |f| %>
      <div class="flex-1 min-w-[200px]">
        <label for="q" class="block text-sm font-medium text-text-primary mb-1">搜索日志内容</label>
        <%= f.text_field :q, value: params[:q], placeholder: "输入关键词...", class: "form-input" %>
      </div>
      <div>
        <label for="level" class="block text-sm font-medium text-text-primary mb-1">日志级别</label>
        <%= f.select :level,
            options_for_select([
              ["全部级别", ""],
              ["DEBUG", "debug"],
              ["INFO", "info"],
              ["WARN", "warn"],
              ["ERROR", "error"]
            ], params[:level]),
            {},
            class: "form-input" %>
      </div>
      <div class="flex gap-2">
        <%= f.submit "筛选", class: "btn btn-primary text-sm" %>
        <%= link_to "重置", logs_event_account_path(@account, run_id: @run&.id), class: "btn btn-secondary text-sm" %>
      </div>
    <% end %>
  </div>

  <!-- Logs -->
  <div class="card">
    <% if @logs.any? %>
      <div class="space-y-2 font-mono text-sm">
        <% @logs.each do |log| %>
          <div class="flex items-start space-x-3 py-2 border-b border-border-primary last:border-0">
            <span class="text-xs text-text-secondary whitespace-nowrap">
              <%= log.logged_at.strftime('%H:%M:%S.%L') %>
            </span>
            <span class="px-2 py-0.5 rounded text-xs font-medium <%= case log.level when 'error' then 'bg-red-100 text-red-800' when 'warn' then 'bg-yellow-100 text-yellow-800' when 'info' then 'bg-blue-100 text-blue-800' else 'bg-bg-secondary text-text-primary' end %>">
              <%= log.level.upcase %>
            </span>
            <span class="flex-1 <%= log.level == 'error' ? 'text-red-700' : 'text-text-primary' %> break-all">
              <%= log.message %>
            </span>
          </div>
        <% end %>
      </div>

      <div class="mt-6">
        <%= paginate @logs %>
      </div>
    <% else %>
      <p class="text-text-secondary text-center py-8">暂无日志</p>
    <% end %>
  </div>

  <% if !Option.verbose_mode? %>
    <div class="card bg-yellow-50 border-yellow-200">
      <p class="text-sm text-yellow-800">
        ℹ️ 调研的 info/warn/error 日志始终保留；DEBUG 级别日志需要在<%= link_to "设置", admin_settings_path, class: "font-semibold underline" %>中开启详细模式。
      </p>
    </div>
  <% end %>
</div>
