<div class="flex justify-center min-h-screen bg-slate-50">
  <div class="w-full max-w-md">
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8">
      <h3 class="text-xl font-bold text-slate-900 mb-6">登录</h3>

      <%= form_with url: session_path do |form| %>
        <div class="mb-4">
          <%= form.label :email_address, "邮箱", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "请输入邮箱", value: params[:email_address], class: "w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200" %>
        </div>
        <div class="mb-5">
          <%= form.label :password, "密码", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "请输入密码", maxlength: 72, class: "w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200" %>
        </div>
        <%= form.submit "登录", class: "w-full py-2.5 bg-blue-600 text-white font-semibold rounded-lg text-sm hover:bg-blue-700 transition-colors cursor-pointer" %>
      <% end %>

      <hr class="my-6 border-slate-200">

      <div>
        <h4 class="text-sm font-semibold text-slate-900 mb-1">使用魔法链接登录</h4>
        <p class="text-xs text-slate-500 mb-4">输入邮箱，我们会发送一个 15 分钟内有效的登录链接。</p>

        <%= form_with url: magic_link_session_path, method: :post do |form| %>
          <div class="mb-4">
            <%= form.label :email_address, "邮箱", class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= form.email_field :email_address, required: true, autocomplete: "username", placeholder: "请输入邮箱", value: params[:email_address], class: "w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200" %>
          </div>
          <%= form.submit "发送魔法登录链接", class: "w-full py-2.5 bg-white text-slate-700 font-semibold rounded-lg text-sm border border-slate-200 hover:border-blue-400 hover:text-blue-600 transition-colors cursor-pointer" %>
        <% end %>
      </div>

      <% if Rails.env.development? || Rails.env.test? %>
        <hr class="my-6 border-slate-200">
        <div>
          <%= button_to "🚀 开发者快速登录", dev_login_session_path, method: :post, class: "w-full py-2.5 bg-emerald-600 text-white font-semibold rounded-lg text-sm hover:bg-emerald-700 transition-colors cursor-pointer" %>
          <p class="text-xs text-slate-400 mt-2 text-center">dev@example.com · 仅开发环境可见</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
