<div class="flex justify-center min-h-screen items-center bg-slate-50">
  <div class="w-full max-w-md">
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8">
      <h3 class="text-xl font-bold text-slate-900 mb-6">登录</h3>

      <%= form_with url: session_path do |form| %>
        <div class="mb-4">
          <%= form.label :email_address, "邮箱", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "请输入邮箱", value: params[:email_address], class: "w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200" %>
        </div>
        <div class="mb-5">
          <%= form.label :password, "密码", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "请输入密码", maxlength: 72, class: "w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200" %>
        </div>
        <%= form.submit "登录", class: "w-full py-2.5 bg-blue-600 text-white font-semibold rounded-lg text-sm hover:bg-blue-700 transition-colors cursor-pointer" %>
      <% end %>

      <div class="text-center mt-4">
        <p class="text-xs text-slate-500">忘记密码？请联系管理员重置</p>
      </div>
    </div>
  </div>
</div>
