<div class="flex justify-center min-h-screen bg-bg-secondary">
  <div class="w-full max-w-md">
    <div class="bg-bg-card rounded-lg border border-border-primary shadow-sm p-8">
      <h3 class="text-xl font-bold text-text-primary mb-6">登录</h3>

      <%= link_to oauth_login_path(provider: 'mp'), class: "flex items-center justify-center gap-2 w-full py-2.5 mb-6 bg-bg-card border border-border-primary text-text-primary font-semibold rounded-lg text-sm hover:bg-bg-secondary transition-colors" do %>
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M13.8 12H3"/>
        </svg>
        使用 MiraclePlus 账号登录
      <% end %>

      <div class="relative mb-6">
        <hr class="border-border-primary">
        <span class="absolute left-1/2 -translate-x-1/2 -top-2.5 bg-bg-card px-2 text-xs text-text-muted">或</span>
      </div>

      <%= form_with url: session_path do |form| %>
        <div class="mb-4">
          <%= form.label :email_address, "邮箱", class: "block text-sm font-medium text-text-primary mb-1" %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "请输入邮箱", value: params[:email_address], class: "form-input" %>
        </div>
        <div class="mb-5">
          <%= form.label :password, "密码", class: "block text-sm font-medium text-text-primary mb-1" %>
          <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "请输入密码", maxlength: 72, class: "form-input" %>
        </div>
        <%= form.submit "登录", class: "btn btn-primary w-full cursor-pointer" %>
      <% end %>

      <hr class="my-6 border-border-primary">

      <div>
        <h4 class="text-sm font-semibold text-text-primary mb-1">使用魔法链接登录</h4>
        <p class="text-xs text-text-secondary mb-4">输入邮箱，我们会发送一个 15 分钟内有效的登录链接。</p>

        <%= form_with url: magic_link_session_path, method: :post do |form| %>
          <div class="mb-4">
            <%= form.label :email_address, "邮箱", class: "block text-sm font-medium text-text-primary mb-1" %>
            <%= form.email_field :email_address, required: true, autocomplete: "username", placeholder: "请输入邮箱", value: params[:email_address], class: "form-input" %>
          </div>
          <%= form.submit "发送魔法登录链接", class: "w-full py-2.5 bg-bg-card text-text-primary font-semibold rounded-lg text-sm border border-border-primary hover:border-blue-400 hover:text-brand transition-colors cursor-pointer" %>
        <% end %>
      </div>

      <% if Rails.env.development? || Rails.env.test? %>
        <hr class="my-6 border-border-primary">
        <div>
          <%= button_to "🚀 开发者快速登录", dev_login_session_path, method: :post, class: "w-full py-2.5 bg-emerald-600 text-white font-semibold rounded-lg text-sm hover:bg-emerald-700 transition-colors cursor-pointer" %>
          <p class="text-xs text-text-muted mt-2 text-center">dev@example.com · 仅开发环境可见</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
