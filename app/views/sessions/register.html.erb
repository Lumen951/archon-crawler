<% content_for :title, "企业邮箱注册 · ARCHON" %>
<div class="max-w-lg mx-auto p-6">
  <h1 class="text-2xl font-bold mb-4">注册 Archon</h1>
  <p class="text-text-secondary mb-6">使用 @archon.tech 邮箱注册，成功后即可使用密码登录。新账号为普通用户，无需邮件验证。</p>
  <% if @user.errors.any? %>
    <ul role="alert" class="mb-4">
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>
  <%= form_with model: @user, url: registration_path, class: "space-y-4" do |form| %>
    <div><%= form.label :name, "姓名", class: "form-label" %><%= form.text_field :name, autocomplete: "name", class: "form-input" %></div>
    <div><%= form.label :email_address, "企业邮箱", class: "form-label" %><%= form.email_field :email_address, required: true, autocomplete: "email", placeholder: "name@archon.tech", class: "form-input" %></div>
    <div><%= form.label :password, "密码（至少 12 个字符，最多 72 字节）", class: "form-label" %><%= form.password_field :password, required: true, minlength: 12, maxlength: 72, autocomplete: "new-password", class: "form-input" %></div>
    <div><%= form.label :password_confirmation, "确认密码", class: "form-label" %><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "form-input" %></div>
    <%= form.submit "注册账号", class: "btn btn-primary w-full" %>
  <% end %>
  <p class="mt-6"><%= link_to "已有账号？返回登录", new_session_path %></p>
</div>
