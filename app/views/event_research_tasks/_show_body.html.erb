<div id="<%= dom_id(task, :show_body) %>" class="space-y-6" data-task-status="<%= task.status %>">
  <div class="card">
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
      <div>
        <h2 class="text-xl font-semibold text-text-primary"><%= task.total %> 个活动</h2>
        <p class="mt-1 text-sm text-text-secondary">来源：<%= { "manual_single" => "单个启动", "manual_selected" => "多选启动", "manual_all" => "筛选全选", "scheduled" => "定时任务" }[task.source] %> · 并发 <%= task.effective_account_concurrency %></p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <%= render "shared/status_badge", status: task.status %>
        <% if task.running? %>
          <%= button_to "暂停", pause_event_research_task_path(task), method: :post, class: "btn btn-warning" %>
          <%= button_to "标记失败", fail_event_research_task_path(task), method: :post, class: "btn btn-danger", data: { turbo_confirm: "确定标记该任务为失败吗？" } %>
        <% elsif task.paused? || task.failed? %>
          <%= button_to "恢复未完成活动", resume_event_research_task_path(task), method: :post, class: "btn btn-primary" %>
        <% end %>
        <% if task.event_weekly_digest %>
          <%= link_to "查看研究报告", event_weekly_digest_path(task.event_weekly_digest), class: "btn btn-secondary" %>
        <% end %>
        <% if task.completed? || task.failed? %>
          <%= button_to "删除任务", event_research_task_path(task), method: :delete, class: "btn btn-danger", data: { turbo_confirm: "确定删除该研究任务吗？" } %>
        <% end %>
      </div>
    </div>

    <div class="mt-6 grid grid-cols-2 md:grid-cols-5 gap-4">
      <div><p class="text-sm text-text-secondary">进度</p><p class="text-2xl font-bold text-text-primary"><%= task.progress %>/<%= task.total %></p></div>
      <div><p class="text-sm text-text-secondary">完成</p><p class="text-2xl font-bold text-green-600"><%= task.completed_account_count %></p></div>
      <div><p class="text-sm text-text-secondary">失败</p><p class="text-2xl font-bold <%= task.failed_account_count.positive? ? "text-red-600" : "text-text-primary" %>"><%= task.failed_account_count %></p></div>
      <div><p class="text-sm text-text-secondary">跳过</p><p class="text-2xl font-bold text-text-primary"><%= task.skipped_account_count %></p></div>
      <div><p class="text-sm text-text-secondary">开始时间</p><p class="text-lg font-semibold text-text-primary"><%= task.started_at&.strftime("%Y-%m-%d %H:%M") || "—" %></p></div>
    </div>
    <% if task.error_message.present? %><div class="mt-5 rounded-lg bg-red-50 border border-red-100 p-3 text-sm text-red-700"><%= task.error_message %></div><% end %>
  </div>

  <div class="card">
    <h2 class="text-xl font-bold text-text-primary mb-4">活动状态</h2>
    <div class="space-y-2">
      <% items.each do |item| %>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 rounded-lg border border-border-primary px-4 py-3">
          <div><div class="font-medium text-text-primary"><%= item.account.nickname %></div><% if item.error_message.present? %><div class="mt-1 text-sm text-text-secondary"><%= item.error_message %></div><% end %></div>
          <div class="flex items-center gap-3"><%= render "shared/status_badge", status: item.status %><% if item.event_research_run %><%= link_to "查看调研", event_account_path(item.account, run_id: item.event_research_run_id), class: "text-sm text-primary hover:underline" %><% end %></div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card">
    <div class="flex items-center justify-between mb-4"><h2 class="text-xl font-bold text-text-primary">最近日志</h2><%= link_to "查看所有日志 →", logs_event_research_task_path(task), class: "text-sm text-primary hover:underline" %></div>
    <% if recent_logs.any? %><div class="space-y-2 font-mono text-sm"><% recent_logs.each do |log| %><div class="flex gap-3 border-b border-border-primary py-2 last:border-0"><span class="text-text-muted"><%= log.logged_at.strftime("%H:%M:%S") %></span><span class="<%= log.level == "error" ? "text-red-700" : "text-text-primary" %>"><%= log.message %></span></div><% end %></div><% else %><p class="text-sm text-text-secondary">暂无日志</p><% end %>
  </div>
</div>
