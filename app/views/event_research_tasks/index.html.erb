<div class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div><h1 class="text-2xl font-bold text-text-primary">活动研究任务</h1><p class="mt-1 text-sm text-text-secondary">跟踪单个、多选、筛选全选和定时活动研究。</p></div>
    <%= link_to "活动列表", accounts_path(scope: "event"), class: "btn btn-primary" %>
  </div>
  <% if @tasks.any? %><div class="card overflow-x-auto"><table class="min-w-full divide-y divide-border-primary"><thead class="bg-bg-secondary"><tr><th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary">创建时间</th><th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary">来源</th><th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary">状态</th><th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary">进度</th><th class="px-4 py-3 text-right text-xs font-semibold text-text-secondary">操作</th></tr></thead><tbody class="divide-y divide-border-primary"><% @tasks.each do |task| %><tr><td class="px-4 py-3 text-sm"><%= task.created_at.strftime("%Y-%m-%d %H:%M") %></td><td class="px-4 py-3 text-sm"><%= { "manual_single" => "单个", "manual_selected" => "多选", "manual_all" => "筛选全选", "scheduled" => "定时" }[task.source] %></td><td class="px-4 py-3"><%= render "shared/status_badge", status: task.status %></td><td class="px-4 py-3 text-sm"><%= task.progress %>/<%= task.total %>（完成 <%= task.completed_account_count %>，失败 <%= task.failed_account_count %>，跳过 <%= task.skipped_account_count %>）</td><td class="px-4 py-3 text-right"><%= link_to "查看", event_research_task_path(task), class: "text-primary hover:underline text-sm" %></td></tr><% end %></tbody></table></div><% else %><div class="card text-center py-12 text-text-secondary">还没有活动研究任务。</div><% end %>
</div>
