<%#
  OAuth consent screen. Reached by an MCP client opening the user's browser at
  /oauth/authorize; the user is already signed in by the time this renders.

  Every pre_auth parameter has to be echoed back on submit, including `resource`
  (RFC 8707) — POST /oauth/authorize rebuilds the pre-authorization from these
  fields, so anything omitted here is silently dropped from the issued token.
%>
<% pre_auth_fields = capture do %>
  <%= hidden_field_tag :client_id, @pre_auth.client.uid, id: nil %>
  <%= hidden_field_tag :redirect_uri, @pre_auth.redirect_uri, id: nil %>
  <%= hidden_field_tag :state, @pre_auth.state, id: nil %>
  <%= hidden_field_tag :response_type, @pre_auth.response_type, id: nil %>
  <%= hidden_field_tag :response_mode, @pre_auth.response_mode, id: nil %>
  <%= hidden_field_tag :scope, @pre_auth.scope, id: nil %>
  <%= hidden_field_tag :code_challenge, @pre_auth.code_challenge, id: nil %>
  <%= hidden_field_tag :code_challenge_method, @pre_auth.code_challenge_method, id: nil %>
  <%= hidden_field_tag :resource, @pre_auth.custom_access_token_attributes[:resource], id: nil %>
<% end %>

<div class="max-w-md mx-auto w-full">
  <div class="bg-bg-card rounded-lg border border-border-primary shadow-sm p-6">
    <div class="text-center mb-6">
      <div class="mx-auto flex items-center justify-center h-10 w-10 rounded-full bg-brand-soft">
        <svg class="h-5 w-5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
      </div>
      <h3 class="mt-4 text-lg font-bold text-text-primary">授权 MCP 客户端</h3>
      <p class="mt-2 text-sm text-text-secondary">
        <span class="font-medium text-text-primary"><%= @pre_auth.client.name %></span>
        请求访问您的 MP-Crawler 数据
      </p>
      <p class="mt-1 text-xs text-text-muted">
        以 <%= current_user.email_address %> 的身份授权
      </p>
    </div>

    <% if @pre_auth.scopes.count > 0 %>
      <div class="rounded-md bg-bg-secondary p-4 mb-6">
        <p class="text-sm font-medium text-text-primary mb-2">该客户端将能够：</p>
        <ul class="space-y-1">
          <% @pre_auth.scopes.each do |scope| %>
            <li class="flex items-start text-sm text-text-secondary">
              <svg class="h-4 w-4 text-brand mt-0.5 mr-2 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span><%= McpOauth::SCOPE_DESCRIPTIONS.fetch(scope, scope) %></span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="rounded-md bg-yellow-50 p-4 mb-6">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm text-yellow-700">
            仅在您确实刚刚从该客户端发起了登录时才继续。授权后可随时在设置中撤销。
          </p>
        </div>
      </div>
    </div>

    <div class="flex space-x-4">
      <%= form_tag oauth_authorization_path, method: :post, class: "flex-1" do %>
        <%= pre_auth_fields %>
        <button type="submit"
                class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-primary hover:bg-brand-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand/30">
          授权
        </button>
      <% end %>

      <%= form_tag oauth_authorization_path, method: :delete, class: "flex-1" do %>
        <%= pre_auth_fields %>
        <button type="submit"
                class="w-full flex justify-center py-2 px-4 border border-border-primary rounded-md shadow-sm text-sm font-medium text-text-primary bg-bg-card hover:bg-bg-secondary focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand/30">
          拒绝
        </button>
      <% end %>
    </div>
  </div>
</div>
