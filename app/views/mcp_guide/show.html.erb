<% content_for :title, "MCP Server - MP-Crawler" %>

<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">MP-Crawler MCP Server</h1>
    <p class="mt-2 text-gray-600">让 AI 助手直接查询和管理您的公众号、小红书、Twitter 账号</p>
  </div>

  <% if @new_token.present? %>
    <div class="mb-6 rounded-md bg-amber-50 border border-amber-200 p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3 flex-1">
          <p class="text-sm font-medium text-amber-800">请立即复制保存此 Token，关闭页面后将无法再次查看：</p>
          <div class="mt-2 flex items-center gap-2">
            <code class="text-sm bg-amber-100 px-2 py-1 rounded font-mono break-all"><%= @new_token %></code>
            <button onclick="navigator.clipboard.writeText('<%= @new_token %>').then(()=>this.textContent='已复制')" class="text-sm text-amber-700 underline hover:text-amber-900">复制</button>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <% if flash[:notice].present? %>
    <div class="mb-4 rounded-md bg-green-50 p-4"><p class="text-sm text-green-700"><%= flash[:notice] %></p></div>
  <% end %>
  <% if flash[:error].present? %>
    <div class="mb-4 rounded-md bg-red-50 p-4"><p class="text-sm text-red-700"><%= flash[:error] %></p></div>
  <% end %>

  <!-- Step 1: Token -->
  <section class="mb-10">
    <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
      <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-indigo-600 text-white text-sm font-bold">1</span>
      获取 Token
    </h2>

    <% if current_user %>
      <%= form_with url: create_token_mcp_guide_path, method: :post, class: "flex items-end gap-3 mb-4" do |f| %>
        <div>
          <label class="block text-sm text-gray-600 mb-1">Token 名称</label>
          <%= f.text_field :token_name, value: "MCP Client", class: "border rounded px-3 py-1.5 text-sm w-48" %>
        </div>
        <%= f.submit "创建 Token", class: "bg-indigo-600 text-white text-sm px-4 py-1.5 rounded hover:bg-indigo-700 cursor-pointer" %>
      <% end %>

      <% if @api_keys.any? %>
        <table class="text-sm w-full">
          <thead><tr class="text-left text-gray-500"><th class="pb-2">名称</th><th class="pb-2">Token</th><th class="pb-2">创建时间</th><th class="pb-2"></th></tr></thead>
          <tbody>
            <% @api_keys.each do |key| %>
              <tr class="border-t">
                <td class="py-2"><%= key.name %></td>
                <td class="py-2 font-mono text-gray-500">
                  <% if key.active? %>
                    <span><%= key.token.to_s[0..7] %>****</span>
                    <button type="button"
                            onclick="mcpCopy(this, '<%= key.token %>')"
                            class="ml-2 text-xs text-indigo-600 hover:underline">复制</button>
                  <% else %>
                    <span class="text-gray-400"><%= key.token.to_s[0..7] %>****</span>
                  <% end %>
                </td>
                <td class="py-2 text-gray-500"><%= key.created_at.strftime("%Y-%m-%d %H:%M") %></td>
                <td class="py-2">
                  <% if key.active? %>
                    <%= button_to "撤销", revoke_token_mcp_guide_path(id: key.id), method: :delete, class: "text-red-600 hover:underline text-sm", data: { turbo_confirm: "确定撤销 Token \"#{key.name}\"？" } %>
                  <% else %>
                    <span class="text-gray-400 text-sm">已撤销</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <p class="text-xs text-gray-400 mt-2">点击「复制」可复制完整 Token 用于下方客户端配置。</p>
      <% end %>
    <% else %>
      <p class="text-gray-600">请先 <%= link_to "登录", new_session_path, class: "text-indigo-600 underline" %> 后创建 Token</p>
    <% end %>
  </section>

  <!-- Step 2: Connect -->
  <section class="mb-10">
    <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
      <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-indigo-600 text-white text-sm font-bold">2</span>
      配置 AI 客户端
    </h2>

    <p class="text-sm text-gray-600 mb-3">把下面这句话发给你的 AI 客户端，它会自动帮你完成配置：</p>
    <% install_prompt = "请用 CLI 命令帮我添加一个 MCP Server，参数如下：name: mp-crawler，url: #{@mcp_endpoint_url}，type: http，authorization: Bearer #{@new_token || 'YOUR_TOKEN'}，scope: project。请用 CLI 完成操作，不要直接创建或者修改 json，如果 Bearer Token 没有提供，或者是 placeholder，请提示用户输入。" %>
    <div class="group/p relative flex items-start gap-2 p-4 rounded-lg border border-gray-200 bg-gray-50 hover:bg-white hover:border-gray-300 hover:shadow-sm transition-all cursor-pointer"
         onclick="copyPrompt(this, <%= install_prompt.to_json %>)">
      <p class="flex-1 text-sm text-gray-700 leading-relaxed font-mono"><%= install_prompt %></p>
      <button class="copy-btn shrink-0 px-2 py-1 text-xs font-medium text-gray-400 bg-white border border-gray-200 rounded opacity-0 group-hover/p:opacity-100 transition-all whitespace-nowrap">复制</button>
    </div>
    <% if @new_token.blank? %>
      <p class="text-xs text-gray-400 mt-2">请先完成 Step 1 生成 Token，提示语中的 <code class="bg-gray-100 px-1 rounded">YOUR_TOKEN</code> 将自动替换为你的真实 Token。</p>
    <% end %>
  </section>

  <!-- Step 3: Tools -->
  <section class="mb-10">
    <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
      <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-indigo-600 text-white text-sm font-bold">3</span>
      可用工具
    </h2>

    <div class="space-y-4">
      <% tools = [
        { name: "list_accounts", badge: "查询", desc: "列出所有账号，支持按平台、状态、活跃度、标签、关键词过滤", params: [
          ["platform", "可选", "wechat / rednote / twitter"],
          ["status", "可选", "active / inactive"],
          ["activity_level", "可选", "active / slow / dormant / dead / never / uncrawled"],
          ["tag_id", "可选", "按标签 ID 过滤"],
          ["keyword", "可选", "按账号名称搜索"],
          ["fields", "可选", "只返回指定字段（如 id、nickname、tags），减少数据量"],
          ["page / per_page", "可选", "分页（默认 1 / 25，最大 100）"],
        ]},
        { name: "get_account", badge: "详情", desc: "获取单个账号详细信息，含活动统计、标签、最近文章", params: [
          ["account_id", "必填", "账号 ID"],
          ["fields", "可选", "只返回指定字段，减少数据量"],
          ["include_articles", "可选", "是否包含最近文章（默认 true，设为 false 可大幅减少数据量）"],
          ["articles_limit", "可选", "最近文章数量（默认 10，最大 20）"],
        ]},
        { name: "list_articles", badge: "查询", desc: "查询某账号的文章列表，支持日期范围过滤", params: [
          ["account_id", "必填", "账号 ID"],
          ["start_date / end_date", "可选", "日期范围 YYYY-MM-DD"],
          ["fields", "可选", "只返回指定字段（如 id、title、url、published_at、digest、content_preview）"],
          ["page / per_page", "可选", "分页（默认 1 / 25，最大 100）"],
        ]},
        { name: "update_accounts", badge: "操作", desc: "批量启用/停用账号、添加/移除标签（需提供账号 ID 列表）", params: [
          ["account_ids", "必填", "账号 ID 列表"],
          ["status", "可选", "active / inactive"],
          ["add_tag_ids / remove_tag_ids", "可选", "标签 ID 列表"],
          ["add_tag_names", "可选", "标签名称（不存在则自动创建）"],
        ]},
        { name: "batch_update_accounts_by_filter", badge: "操作", desc: "按过滤条件批量更新账号（打标签/改状态），无需先列出再操作，支持 dry_run 预览", params: [
          ["filter", "可选", "过滤条件（platform / status / activity_level / tag_id / keyword），为空则匹配全部"],
          ["status", "可选", "设置状态 active / inactive"],
          ["add_tag_ids / remove_tag_ids", "可选", "标签 ID 列表"],
          ["add_tag_names", "可选", "标签名称（不存在则自动创建）"],
          ["dry_run", "可选", "仅返回匹配数量，不实际执行（默认 false）"],
        ]},
        { name: "list_tags", badge: "查询", desc: "列出所有标签及其关联账号数量", params: [
          ["keyword", "可选", "按标签名称搜索"],
          ["fields", "可选", "只返回指定字段（如 id、name、color、accounts_count）"],
        ]},
        { name: "get_activity_stats", badge: "统计", desc: "获取各平台账号活跃度统计概览", params: [] },
      ] %>

      <% tools.each do |tool| %>
        <details class="border rounded-lg">
          <summary class="px-4 py-3 cursor-pointer hover:bg-gray-50 flex items-center gap-3">
            <code class="text-sm font-mono text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded"><%= tool[:name] %></code>
            <span class="text-xs px-2 py-0.5 rounded-full
              <%= case tool[:badge]
                  when '查询' then 'bg-blue-100 text-blue-700'
                  when '详情' then 'bg-green-100 text-green-700'
                  when '操作' then 'bg-orange-100 text-orange-700'
                  when '统计' then 'bg-purple-100 text-purple-700'
                  end %>"><%= tool[:badge] %></span>
            <span class="text-sm text-gray-600"><%= tool[:desc] %></span>
          </summary>
          <div class="px-4 pb-4">
            <% if tool[:params].any? %>
              <table class="text-sm w-full mt-2">
                <thead><tr class="text-left text-gray-500"><th class="pb-1">参数</th><th class="pb-1">必填</th><th class="pb-1">说明</th></tr></thead>
                <tbody>
                  <% tool[:params].each do |p| %>
                    <tr class="border-t">
                      <td class="py-1 font-mono text-sm"><%= p[0] %></td>
                      <td class="py-1"><span class="<%= p[1] == '必填' ? 'text-red-600' : 'text-gray-400' %>"><%= p[1] %></span></td>
                      <td class="py-1 text-gray-600"><%= p[2] %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            <% else %>
              <p class="text-sm text-gray-500 mt-2">无参数</p>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>
  </section>

  <!-- Example Prompts -->
  <section class="mb-10">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">示例 Prompt</h2>
    <div class="space-y-2">
      <% prompts = [
        "帮我看看哪些公众号已经停更超过 90 天，列出来",
        "分析所有账号的活跃度，把从未发布过的账号停用",
        "给所有小红书账号打上「小红书」标签",
        "查看中山大学相关的公众号最近 7 天发了什么文章",
        "统计各平台账号数量和活跃度分布",
        "把所有活跃的微信公众号标记为「重点」标签，先告诉我有多少个",
      ] %>
      <% prompts.each do |p| %>
        <div class="flex items-center gap-2 p-3 bg-gray-50 rounded-lg">
          <span class="text-sm text-gray-800 flex-1"><%= p %></span>
          <button onclick="navigator.clipboard.writeText(this.previousElementSibling.textContent).then(()=>this.textContent='已复制')" class="text-xs text-gray-500 hover:text-indigo-600">复制</button>
        </div>
      <% end %>
    </div>
  </section>
</div>

<script>
  function mcpCopy(btn, token) {
    navigator.clipboard.writeText(token).then(() => {
      const original = btn.textContent;
      btn.textContent = '已复制 ✓';
      setTimeout(() => { btn.textContent = original; }, 2000);
    });
  }

  function copyPrompt(el, text) {
    navigator.clipboard.writeText(text).then(() => {
      const btn = el.querySelector('.copy-btn');
      if (!btn) return;
      btn.innerText = '✓ 已复制';
      btn.classList.add('text-green-600', 'border-green-300', 'opacity-100');
      setTimeout(() => {
        btn.innerText = '复制';
        btn.classList.remove('text-green-600', 'border-green-300');
      }, 2000);
    });
  }
</script>
