<div class="space-y-6">
  <div>
    <p><%= link_to "← 返回每日简报", daily_reports_path, class: "text-primary hover:underline text-sm" %></p>
    <h1 class="mt-2 text-2xl font-bold text-text-primary"><%= @report.title %></h1>
    <p class="mt-1 text-sm text-text-secondary">收录文章 <%= @report.article_count %> 篇，论文 <%= @report.paper_count %> 篇。状态：<%= @report.status %></p>
  </div>

  <% if @report.error_message.present? %>
    <div class="rounded-lg bg-red-50 border border-red-100 px-4 py-3 text-sm text-red-700"><%= @report.error_message %></div>
  <% end %>

  <% if @report.readable_markdown.present? %>
    <article class="prose max-w-none text-text-primary"><%= daily_report_content(@report.readable_markdown) %></article>
  <% elsif @report.completed? %>
    <div class="card text-center py-12"><p class="text-text-secondary">该日期没有可整理的文章或论文。</p></div>
  <% else %>
    <div class="card text-center py-12"><p class="text-text-secondary">简报尚未生成完成。</p></div>
  <% end %>
</div>
