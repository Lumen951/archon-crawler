<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-text-primary">每日简报</h1>
    <p class="mt-1 text-sm text-text-secondary">每日 09:00 汇总前一日新入库的文章和论文，并纳入当日已收录的活动行内容。</p>
  </div>

  <% if @reports.any? %>
    <div class="bg-bg-card border border-border-primary rounded-lg overflow-hidden">
      <table class="min-w-full divide-y divide-border-primary">
        <thead class="bg-bg-secondary"><tr>
          <th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary">日期</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary">状态</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary">文章</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary">论文</th>
          <th class="px-4 py-3 text-right text-xs font-semibold text-text-secondary">操作</th>
        </tr></thead>
        <tbody class="divide-y divide-border-primary">
          <% @reports.each do |report| %>
            <tr>
              <td class="px-4 py-3 text-sm"><%= link_to report.title, daily_report_path(report), class: "text-primary hover:underline" %></td>
              <td class="px-4 py-3"><%= render "shared/status_badge", status: report.status %></td>
              <td class="px-4 py-3 text-sm"><%= report.article_count %></td>
              <td class="px-4 py-3 text-sm"><%= report.paper_count %></td>
              <td class="px-4 py-3 text-right"><%= link_to "查看", daily_report_path(report), class: "text-primary hover:underline text-sm" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="card text-center py-12"><p class="text-text-secondary">还没有每日简报。</p></div>
  <% end %>
</div>
