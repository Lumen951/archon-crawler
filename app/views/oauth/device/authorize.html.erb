<div class="min-h-screen flex items-center justify-center bg-bg-secondary py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <div>
      <h2 class="mt-6 text-center text-3xl font-extrabold text-text-primary">
        授权设备
      </h2>
      <p class="mt-2 text-center text-sm text-text-secondary">
        MP-Crawler MCP 服务
      </p>
    </div>

    <% if @user_code.blank? %>
      <!-- No code provided yet -->
      <div class="rounded-md bg-brand-soft p-4">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-blue-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm text-brand-dark">
              请在终端中运行 MCP 客户端，获取授权码后在此输入。
            </p>
          </div>
        </div>
      </div>

      <form class="mt-8 space-y-6" method="get" action="<%= oauth_device_authorize_path %>">
        <div>
          <label for="code" class="block text-sm font-medium text-text-primary">授权码</label>
          <input type="text" name="code" id="code" placeholder="ABCD-1234"
                 class="mt-1 form-input"
                 maxlength="9" autocomplete="off" autofocus>
        </div>
        <div>
          <button type="submit"
                  class="group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-primary hover:bg-brand-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand/30">
            查找设备
          </button>
        </div>
      </form>

    <% elsif @device_code.nil? %>
      <!-- Code provided but not found -->
      <div class="rounded-md bg-red-50 p-4">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm text-red-700">
              授权码 <strong><%= @user_code %></strong> 无效或已过期。
            </p>
          </div>
        </div>
      </div>

      <div class="mt-4 text-center">
        <a href="<%= oauth_device_authorize_path %>" class="text-brand hover:text-brand text-sm">
          返回重新输入
        </a>
      </div>

    <% elsif @device_code.authorized? %>
      <!-- Already authorized -->
      <div class="rounded-md bg-green-50 p-4">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm text-green-700">
              授权成功！请返回终端继续操作。
            </p>
          </div>
        </div>
      </div>

    <% elsif @device_code.denied? %>
      <!-- Already denied -->
      <div class="rounded-md bg-red-50 p-4">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm text-red-700">
              已拒绝此授权请求。
            </p>
          </div>
        </div>
      </div>

    <% else %>
      <!-- Pending - show approval form -->
      <div class="bg-bg-card shadow rounded-lg p-6">
        <div class="text-center mb-6">
          <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-brand-soft">
            <svg class="h-6 w-6 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="mt-4 text-lg font-medium text-text-primary">
            设备请求授权
          </h3>
          <p class="mt-2 text-sm text-text-secondary">
            授权码: <span class="font-mono font-bold text-lg"><%= @user_code %></span>
          </p>
          <p class="mt-1 text-sm text-text-secondary">
            客户端: <span class="font-medium"><%= @device_code.client_id %></span>
          </p>
          <p class="mt-1 text-xs text-text-muted">
            过期时间: <%= @device_code.expires_at.strftime("%Y-%m-%d %H:%M") %>
          </p>
        </div>

        <div class="rounded-md bg-yellow-50 p-4 mb-6">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <p class="text-sm text-yellow-700">
                请确认此授权码与终端中显示的一致。授权后，该客户端将能够访问您的 MP-Crawler 数据。
              </p>
            </div>
          </div>
        </div>

        <div class="flex space-x-4">
          <form method="post" action="<%= oauth_device_authorize_path %>" class="flex-1">
            <input type="hidden" name="code" value="<%= @user_code %>">
            <input type="hidden" name="action_type" value="approve">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <button type="submit"
                    class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-primary hover:bg-brand-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand/30">
              授权
            </button>
          </form>

          <form method="post" action="<%= oauth_device_authorize_path %>" class="flex-1">
            <input type="hidden" name="code" value="<%= @user_code %>">
            <input type="hidden" name="action_type" value="deny">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <button type="submit"
                    class="w-full flex justify-center py-2 px-4 border border-border-primary rounded-md shadow-sm text-sm font-medium text-text-primary bg-bg-card hover:bg-bg-secondary focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand/30">
              拒绝
            </button>
          </form>
        </div>
      </div>
    <% end %>

    <% if flash[:notice].present? %>
      <div class="rounded-md bg-green-50 p-4 mt-4">
        <p class="text-sm text-green-700"><%= flash[:notice] %></p>
      </div>
    <% end %>

    <% if flash[:error].present? %>
      <div class="rounded-md bg-red-50 p-4 mt-4">
        <p class="text-sm text-red-700"><%= flash[:error] %></p>
      </div>
    <% end %>
  </div>
</div>
