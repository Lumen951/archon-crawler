<div class="flex justify-center">
  <div class="w-full max-w-2xl">
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm">
      <div class="p-6 border-b border-slate-200">
        <h3 class="text-xl font-bold text-slate-900">编辑用户</h3>
      </div>
      <div class="p-6">
        <%= form_with model: [:admin, @user], local: true do |form| %>
          <% if @user.errors.any? %>
            <div class="mb-4 bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl text-sm">
              <p class="font-semibold mb-1"><%= @user.errors.count %>个错误阻止了保存：</p>
              <ul class="list-disc list-inside space-y-0.5">
                <% @user.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="mb-4">
            <%= form.label :email_address, "邮箱", class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= form.email_field :email_address, class: "w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200", required: true %>
          </div>

          <div class="mb-4">
            <%= form.label :name, "姓名", class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= form.text_field :name, class: "w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200" %>
          </div>

          <div class="mb-6">
            <%= form.label :role, "角色", class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= form.select :role, User.roles.keys.map { |role| [role == "admin" ? "管理员" : "用户", role] }, {}, class: "w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200" %>
          </div>

          <hr class="my-6 border-slate-200">

          <div class="mb-4">
            <%= form.label :password, "新密码（留空则不修改）", class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= form.password_field :password, class: "w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200", autocomplete: "new-password" %>
          </div>

          <div class="mb-6">
            <%= form.label :password_confirmation, "确认新密码", class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= form.password_field :password_confirmation, class: "w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200", autocomplete: "new-password" %>
          </div>

          <div class="flex gap-3">
            <%= form.submit "更新用户", class: "px-5 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-sm font-semibold cursor-pointer" %>
            <%= link_to "取消", admin_user_path(@user), class: "px-5 py-2.5 bg-white border border-slate-200 text-slate-700 rounded-lg hover:bg-slate-50 transition-colors text-sm font-semibold" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
