<div class="flex justify-center min-h-screen items-center bg-bg-secondary">
  <div class="w-full max-w-md">
    <div class="bg-bg-card rounded-lg border border-border-primary shadow-sm p-8">
      <h3 class="text-xl font-bold text-text-primary mb-6">用户凭证</h3>

      <div class="bg-brand-soft border border-border-primary rounded-lg p-4 mb-6">
        <p class="text-sm text-text-primary mb-4">用户已创建成功！请将以下登录凭证分享给用户：</p>

        <div class="space-y-3">
          <textarea id="credentials" readonly class="w-full px-3 py-3 bg-bg-card border border-border-primary rounded-lg text-sm font-mono resize-none" rows="4"><%= "登录地址：#{root_url}\n邮箱：#{@user.email_address}\n密码：#{@generated_password}" %></textarea>

          <button onclick="copyAllCredentials()" class="btn btn-primary w-full">
            复制登录信息
          </button>
        </div>
      </div>

      <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-6">
        <p class="text-xs text-amber-800">
          <strong>注意：</strong>此页面只会显示一次，离开后将无法再次查看密码。请确保已将凭证安全地发送给用户。
        </p>
      </div>

      <div class="flex gap-3">
        <%= link_to "返回用户列表", admin_users_path, class: "btn btn-primary flex-1" %>
      </div>
    </div>
  </div>
</div>

<script>
function copyAllCredentials() {
  const textarea = document.getElementById('credentials');
  textarea.select();
  navigator.clipboard.writeText(textarea.value).then(() => {
    alert('登录信息已复制到剪贴板');
  });
}
</script>
