<%
  color_map = {
    "blue"   => { bg: "bg-brand-soft",   icon: "text-brand",   val: "text-brand-dark"   },
    "green"  => { bg: "bg-green-50",  icon: "text-green-500",  val: "text-green-700"  },
    "teal"   => { bg: "bg-teal-50",   icon: "text-teal-500",   val: "text-teal-700"   },
    "indigo" => { bg: "bg-indigo-50", icon: "text-brand", val: "text-brand-dark" },
    "violet" => { bg: "bg-violet-50", icon: "text-violet-500", val: "text-violet-700" },
    "amber"  => { bg: "bg-amber-50",  icon: "text-amber-500",  val: "text-amber-700"  },
    "red"    => { bg: "bg-red-50",    icon: "text-red-500",    val: "text-red-700"    },
    "slate"  => { bg: "bg-bg-secondary", icon: "text-text-secondary", val: "text-text-primary" },
  }
  c = color_map[color] || color_map["slate"]
%>
<div class="bg-bg-card border border-border-primary rounded-lg p-5 flex items-center gap-4">
  <div class="w-10 h-10 rounded-lg <%= c[:bg] %> flex items-center justify-center shrink-0">
    <i class="fas <%= icon %> <%= c[:icon] %>"></i>
  </div>
  <div class="min-w-0">
    <p class="text-xs text-text-secondary truncate"><%= label %></p>
    <p class="text-2xl font-bold <%= c[:val] %> leading-tight"><%= value %></p>
  </div>
</div>
