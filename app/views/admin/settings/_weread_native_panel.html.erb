<div id="weread_native_panel">
  <% if @weread_native_session_valid %>
    <!-- Logged in state -->
    <div class="mb-4 p-4 bg-green-50 border border-green-200 rounded-lg">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-green-900">会话状态：✓ 已登录</p>
          <% if @weread_native_expires_at %>
            <p class="text-sm text-green-700 mt-1">
              过期时间：<%= Time.parse(@weread_native_expires_at).strftime('%Y-%m-%d %H:%M:%S') rescue @weread_native_expires_at %>
            </p>
          <% end %>
          <% if @weread_native_account_info.present? %>
            <% info = JSON.parse(@weread_native_account_info) rescue {} %>
            <% if info['name'].present? %>
              <p class="text-sm text-green-700 mt-1">账号：<%= info['name'] %></p>
            <% elsif info['vid'].present? %>
              <p class="text-sm text-green-700 mt-1 font-mono">VID: <%= info['vid'] %></p>
            <% end %>
          <% end %>
          <% if @weread_native_key_check %>
            <p class="text-sm mt-1">
              上次验证：
              <% if @weread_native_key_check[:valid] == true %>
                <span class="text-green-700 font-semibold">✓ 有效</span>
              <% else %>
                <span class="text-red-700 font-semibold">✗ 无效</span>
              <% end %>
              <span class="text-gray-500 text-xs ml-1">(<%= Time.parse(@weread_native_key_check[:checked_at]).strftime('%Y-%m-%d %H:%M') %>)</span>
            </p>
          <% end %>
        </div>
        <div class="flex flex-col items-end gap-2">
          <%= button_to "验证会话", validate_weread_native_key_admin_settings_path, method: :post,
              class: "text-sm px-3 py-1.5 rounded bg-green-600 text-white hover:bg-green-700 transition" %>
          <%= button_to "退出登录", weread_native_logout_admin_settings_path, method: :post,
              class: "text-sm px-3 py-1.5 rounded bg-red-600 text-white hover:bg-red-700 transition",
              data: { confirm: "确定要退出微信读书（直连）登录吗？" } %>
        </div>
      </div>
    </div>
  <% else %>
    <!-- Not logged in state -->
    <div class="mb-4 p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
      <p class="text-sm text-yellow-800">未登录微信读书（直连）。请点击下方按钮获取二维码，然后使用微信扫码登录。</p>
    </div>

    <%= render "admin/settings/qr_login", provider: "weread_native" %>
  <% end %>
</div>
