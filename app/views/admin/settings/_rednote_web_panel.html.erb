<%# 小红书网页版 Cookie 会话状态（由远程浏览器登录写入，见 BrowserLogin::RednoteWeb） %>
<div id="rednote_web_panel">
  <% if @rednote_web_session_valid %>
    <div class="notice notice-success flex items-start justify-between gap-3">
      <div>
        <p class="font-medium">网页版 Cookie：✓ 已保存</p>
        <% if @rednote_web_expires_at %>
          <p class="text-green-700 mt-0.5">
            本地有效期至：<%= Time.parse(@rednote_web_expires_at).strftime('%Y-%m-%d %H:%M:%S') rescue @rednote_web_expires_at %>
          </p>
        <% end %>
        <% if @rednote_web_account_info.present? %>
          <% info = JSON.parse(@rednote_web_account_info) rescue {} %>
          <% if info['nickname'].present? %>
            <p class="text-green-700 mt-0.5">昵称：<%= info['nickname'] %></p>
          <% end %>
        <% end %>
      </div>
      <%= button_to "清除 Cookie", rednote_web_logout_admin_settings_path, method: :post,
          class: "btn btn-danger btn-sm shrink-0 self-center",
          data: { confirm: "确定要清除小红书网页版 Cookie 吗？" } %>
    </div>
  <% else %>
    <div class="notice notice-warning mb-4">
      未保存网页版登录态。点击下方按钮打开远程浏览器，用小红书 App 扫描页面上的二维码即可。
    </div>
  <% end %>
</div>
