<%# 小红书网页版 Cookie 会话状态（由远程浏览器登录写入，见 BrowserLogin::RednoteWeb） %>
<div id="rednote_web_panel">
  <% if @rednote_web_session_valid %>
    <div class="mb-4 p-4 bg-green-50 border border-green-200 rounded-lg">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-green-900">网页版 Cookie：✓ 已保存</p>
          <% if @rednote_web_expires_at %>
            <p class="text-sm text-green-700 mt-1">
              本地有效期至：<%= Time.parse(@rednote_web_expires_at).strftime('%Y-%m-%d %H:%M:%S') rescue @rednote_web_expires_at %>
            </p>
          <% end %>
          <% if @rednote_web_account_info.present? %>
            <% info = JSON.parse(@rednote_web_account_info) rescue {} %>
            <% if info['nickname'].present? %>
              <p class="text-sm text-green-700 mt-1">昵称：<%= info['nickname'] %></p>
            <% end %>
          <% end %>
        </div>
        <%= button_to "清除 Cookie", rednote_web_logout_admin_settings_path, method: :post,
            class: "text-sm px-3 py-1.5 rounded bg-red-600 text-white hover:bg-red-700 transition",
            data: { confirm: "确定要清除小红书网页版 Cookie 吗？" } %>
      </div>
    </div>
  <% else %>
    <div class="mb-4 p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
      <p class="text-sm text-yellow-800">未保存网页版登录态。点击下方按钮打开远程浏览器，用小红书 App 扫描页面上的二维码即可。</p>
    </div>
  <% end %>
</div>
