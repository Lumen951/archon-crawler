<div class="space-y-6">
  <div>
    <h1 class="text-3xl font-bold text-gray-900">设置</h1>
    <p class="text-gray-600 mt-1">配置您的 API 密钥和系统设置</p>
  </div>

  <!-- API Key Section -->
  <div class="card">
    <h2 class="text-xl font-bold text-gray-900 mb-4">微信 API 密钥</h2>

    <% if @api_key_value.present? %>
      <div class="mb-4 p-4 bg-blue-50 border border-blue-200 rounded-lg">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-blue-900">当前 API 密钥</p>
            <p class="text-sm text-blue-700 mt-1 font-mono"><%= mask_api_key(@api_key_value) %></p>
            <p class="text-sm text-blue-700 mt-1">
              过期时间：<%= @api_key_expires_at ? Time.parse(@api_key_expires_at).strftime('%Y-%m-%d %H:%M') : '永不过期' %>
              <% if @api_key_expires_at && Time.parse(@api_key_expires_at) < 24.hours.from_now %>
                <span class="ml-2 text-red-600 font-semibold">⚠️ 即将过期！</span>
              <% end %>
            </p>
          </div>
          <span class="text-sm text-blue-600">
            <%= Option.api_key_valid? ? '✓ 有效' : '✗ 已过期' %>
          </span>
        </div>
      </div>
    <% else %>
      <div class="mb-4 p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
        <p class="text-sm text-yellow-800">未配置 API 密钥。请在下方添加。</p>
      </div>
    <% end %>

    <%= form_with url: admin_settings_path, method: :patch, class: "space-y-4" do |f| %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">API 密钥</label>
        <input type="text" name="api_key" placeholder="输入您从 down.mptext.top 获取的 API 密钥"
               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
        <p class="mt-1 text-sm text-gray-500">
          从 <a href="https://down.mptext.top/dashboard/api" target="_blank" class="text-primary hover:underline">https://down.mptext.top/dashboard/api</a> 获取您的 API 密钥
        </p>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">过期时间（天）</label>
        <select name="expires_days" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
          <option value="4" selected>4 天（推荐）</option>
          <option value="3">3 天</option>
          <option value="5">5 天</option>
        </select>
      </div>

      <button type="submit" class="btn btn-primary">更新 API 密钥</button>
    <% end %>
  </div>

  <!-- RedNote API Key -->
  <div class="card">
    <h2 class="text-xl font-bold text-gray-900 mb-4">小红书 API 密钥</h2>

    <% if @rednote_api_key.present? %>
      <div class="mb-4 p-4 bg-green-50 border border-green-200 rounded-lg">
        <p class="text-sm font-medium text-green-900">当前 API 密钥</p>
        <p class="text-sm text-green-700 mt-1 font-mono"><%= mask_api_key(@rednote_api_key) %></p>
      </div>
    <% end %>

    <%= form_with url: admin_settings_path, method: :patch, class: "space-y-4" do |f| %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">API 密钥</label>
        <%= text_field_tag :rednote_api_key, nil,
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent",
            placeholder: "输入小红书 API 密钥" %>
      </div>

      <div class="flex items-center justify-end">
        <button type="submit" class="btn btn-primary">保存小红书密钥</button>
      </div>
    <% end %>
  </div>

  <!-- Crawl Settings -->
  <div class="card">
    <h2 class="text-xl font-bold text-gray-900 mb-4">抓取设置</h2>

    <%= form_with url: admin_settings_path, method: :patch, class: "space-y-4" do |f| %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">默认账号并发数</label>
        <input type="number" name="default_account_concurrency" value="<%= @default_account_concurrency %>" min="1" max="20"
               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
        <p class="mt-1 text-sm text-gray-500">
          同时抓取的帐号数量（1-20）。数值越高速度越快，但系统负载也越大。
        </p>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">默认文章并发数</label>
        <input type="number" name="default_article_concurrency" value="<%= @default_article_concurrency %>" min="5" max="50"
               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
        <p class="mt-1 text-sm text-gray-500">
          每个帐号抓取时的并发请求数（5-50）。数值越高速度越快，但 API 负载也越大。
        </p>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">最大抓取页数</label>
        <input type="number" name="max_crawl_pages" value="<%= @max_crawl_pages %>" min="1" max="100"
               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
        <p class="mt-1 text-sm text-gray-500">
          每个帐号最多抓取的文章页数（1-100）。每页约20篇文章。
        </p>
      </div>

      <button type="submit" class="btn btn-primary">更新设置</button>
    <% end %>
  </div>

  <!-- Logging Settings -->
  <div class="card">
    <h2 class="text-xl font-bold text-gray-900 mb-4">日志设置</h2>

    <%= form_with url: admin_settings_path, method: :patch, class: "space-y-4" do |f| %>
      <div>
        <label class="flex items-center space-x-3 cursor-pointer">
          <input type="hidden" name="verbose_mode" value="0">
          <input type="checkbox" name="verbose_mode" value="1" <%= 'checked' if @verbose_mode %>
                 class="w-5 h-5 text-primary border-gray-300 rounded focus:ring-2 focus:ring-primary">
          <div>
            <span class="text-sm font-medium text-gray-700">启用详细日志</span>
            <p class="text-xs text-gray-500">在抓取期间记录详细信息（调试级别）</p>
          </div>
        </label>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">日志保留天数</label>
        <input type="number" name="log_retention_days" value="<%= @log_retention_days %>" min="1" max="90"
               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
        <p class="mt-1 text-sm text-gray-500">
          自动删除超过此天数的日志（1-90）
        </p>
      </div>

      <button type="submit" class="btn btn-primary">更新日志设置</button>
    <% end %>
  </div>

  <!-- Info Section -->
  <div class="card bg-gray-50">
    <h3 class="font-semibold text-gray-900 mb-2">重要说明</h3>
    <ul class="space-y-2 text-sm text-gray-600">
      <li>• API 密钥每 4 天过期一次，必须手动更新</li>
      <li>• 当密钥过期时，所有正在运行的抓取任务将自动暂停</li>
      <li>• 您需要登录 <a href="https://down.mptext.top" target="_blank" class="text-primary hover:underline">down.mptext.top</a> 使用您的微信公众号来获取新密钥</li>
      <li>• 更高的并发数 = 更快的抓取速度，但可能触发速率限制</li>
    </ul>
  </div>
</div>
