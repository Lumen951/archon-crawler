<script>
  // WeChat Tab Switcher
  (function() {
    const tabs = document.querySelectorAll('.wechat-tab');
    const panels = document.querySelectorAll('.wechat-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tab;

        // Deactivate all tabs
        tabs.forEach(t => {
          t.classList.remove('border-primary', 'text-primary');
          t.classList.add('border-transparent', 'text-gray-500');
        });

        // Activate clicked tab
        tab.classList.remove('border-transparent', 'text-gray-500');
        tab.classList.add('border-primary', 'text-primary');

        // Show target panel, hide others
        panels.forEach(p => {
          if (p.dataset.tabPanel === target) {
            p.classList.remove('hidden');
          } else {
            p.classList.add('hidden');
          }
        });
      });
    });
  })();
</script>

<script>
  // MP Native QR Code Poller
  const WechatMpQrPoller = {
    pollTimer: null,
    uuid: null,

    async requestQrCode() {
      const btn = document.getElementById('mp_native_get_qr_btn');
      const area = document.getElementById('mp_native_qr_area');
      const img = document.getElementById('mp_native_qr_image');
      const status = document.getElementById('mp_native_qr_status');

      // Stop any existing polling
      this.stopPolling();

      btn.disabled = true;
      btn.textContent = '获取中...';

      try {
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
        const resp = await fetch('/admin/settings/wechat_mp_request_qrcode', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrfToken,
          },
        });

        if (!resp.ok) {
          const data = await resp.json();
          throw new Error(data.error || '获取二维码失败');
        }

        const data = await resp.json();
        this.uuid = data.uuid;
        // Add cache-busting timestamp
        img.src = data.image_path + '?t=' + Date.now();
        img.onerror = () => {
          status.textContent = '二维码图片加载失败，请重试';
          status.className = 'text-sm mt-3 text-red-600';
          btn.disabled = false;
          btn.textContent = '获取登录二维码';
        };
        area.style.display = 'block';
        status.textContent = '等待扫码...';
        status.className = 'text-sm mt-3 text-gray-500';
        btn.textContent = '重新获取二维码';

        // Start polling
        this.startPolling();
      } catch (err) {
        status.textContent = '获取二维码失败: ' + err.message;
        status.className = 'text-sm mt-3 text-red-600';
        area.style.display = 'block';
        btn.disabled = false;
        btn.textContent = '获取登录二维码';
      }
    },

    startPolling() {
      if (this.pollTimer) clearInterval(this.pollTimer);

      const status = document.getElementById('mp_native_qr_status');
      const img = document.getElementById('mp_native_qr_image');

      this.pollTimer = setInterval(async () => {
        try {
          const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
          const resp = await fetch('/admin/settings/wechat_mp_qrcode_status', {
            headers: { 'X-CSRF-Token': csrfToken },
          });

          if (!resp.ok) throw new Error('HTTP ' + resp.status);

          const data = await resp.json();

          switch (data.status) {
            case 'waiting':
              status.textContent = '等待扫码...';
              status.className = 'text-sm mt-3 text-gray-500';
              break;
            case 'scanned':
              status.textContent = '已扫码，请在手机上确认登录...';
              status.className = 'text-sm mt-3 text-blue-600 font-semibold';
              break;
            case 'success':
              status.textContent = '登录成功！页面即将刷新...';
              status.className = 'text-sm mt-3 text-green-600 font-semibold';
              this.stopPolling();
              img.style.opacity = '0.5';
              setTimeout(() => { window.location.reload(); }, 1500);
              break;
            case 'expired':
              status.textContent = '二维码已过期，请重新获取';
              status.className = 'text-sm mt-3 text-red-600';
              this.stopPolling();
              break;
            case 'error':
              status.textContent = '错误: ' + (data.message || '未知错误');
              status.className = 'text-sm mt-3 text-red-600';
              this.stopPolling();
              break;
          }
        } catch (err) {
          status.textContent = '轮询出错: ' + err.message;
          status.className = 'text-sm mt-3 text-red-600';
          this.stopPolling();
        }
      }, 2000); // Poll every 2 seconds
    },

    stopPolling() {
      if (this.pollTimer) {
        clearInterval(this.pollTimer);
        this.pollTimer = null;
      }
      const btn = document.getElementById('mp_native_get_qr_btn');
      if (btn) btn.disabled = false;
    }
  };
</script>

<script>
  // WeRead QR Code Poller
  const WereadQrPoller = {
    pollTimer: null,

    async requestQrCode() {
      const btn = document.getElementById('weread_get_qr_btn');
      const area = document.getElementById('weread_qr_area');
      const img = document.getElementById('weread_qr_image');
      const status = document.getElementById('weread_qr_status');

      this.stopPolling();

      btn.disabled = true;
      btn.textContent = '获取中...';

      try {
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
        const resp = await fetch('/admin/settings/weread_request_qrcode', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrfToken,
          },
        });

        if (!resp.ok) {
          const data = await resp.json();
          throw new Error(data.error || '获取二维码失败');
        }

        const data = await resp.json();
        // Use qrserver API to render QR code image
        const scanUrl = data.scan_url;
        img.src = 'https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=' + encodeURIComponent(scanUrl) + '&t=' + Date.now();
        img.onerror = () => {
          status.textContent = '二维码图片加载失败，请重试';
          status.className = 'text-sm mt-3 text-red-600';
          btn.disabled = false;
          btn.textContent = '获取登录二维码';
        };
        area.style.display = 'block';
        status.textContent = '等待扫码...';
        status.className = 'text-sm mt-3 text-gray-500';
        btn.textContent = '重新获取二维码';

        this.startPolling();
      } catch (err) {
        status.textContent = '错误: ' + err.message;
        status.className = 'text-sm mt-3 text-red-600';
        area.style.display = 'block';
        btn.disabled = false;
        btn.textContent = '获取登录二维码';
      }
    },

    startPolling() {
      if (this.pollTimer) clearInterval(this.pollTimer);

      const status = document.getElementById('weread_qr_status');
      const img = document.getElementById('weread_qr_image');

      this.pollTimer = setInterval(async () => {
        try {
          const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
          const resp = await fetch('/admin/settings/weread_qrcode_status', {
            headers: { 'X-CSRF-Token': csrfToken },
          });

          if (!resp.ok) throw new Error('HTTP ' + resp.status);

          const data = await resp.json();

          switch (data.status) {
            case 'waiting':
              status.textContent = data.message || '等待扫码...';
              status.className = 'text-sm mt-3 text-gray-500';
              break;
            case 'scanned':
              status.textContent = data.message || '已扫码，请在手机上确认登录...';
              status.className = 'text-sm mt-3 text-blue-600 font-semibold';
              break;
            case 'success':
              status.textContent = (data.message || '登录成功') + ' 页面即将刷新...';
              status.className = 'text-sm mt-3 text-green-600 font-semibold';
              this.stopPolling();
              img.style.opacity = '0.5';
              setTimeout(() => { window.location.reload(); }, 1500);
              break;
            case 'expired':
              status.textContent = '二维码已过期，请重新获取';
              status.className = 'text-sm mt-3 text-red-600';
              this.stopPolling();
              break;
            case 'error':
              status.textContent = '错误: ' + (data.message || '未知错误');
              status.className = 'text-sm mt-3 text-red-600';
              this.stopPolling();
              break;
          }
        } catch (err) {
          status.textContent = '轮询出错: ' + err.message;
          status.className = 'text-sm mt-3 text-red-600';
          this.stopPolling();
        }
      }, 3000);
    },

    stopPolling() {
      if (this.pollTimer) {
        clearInterval(this.pollTimer);
        this.pollTimer = null;
      }
      const btn = document.getElementById('weread_get_qr_btn');
      if (btn) btn.disabled = false;
    }
  };
</script>

<script>
  // Hash → WeChat tab 切换：支持 /admin/settings#weread 等锚点直达
  // 微信读书推送里的 settings 链接会带 #weread，加载后自动切到 WeRead Tab 并滚动过去。
  (function() {
    function activateTabFromHash() {
      const hash = window.location.hash;
      if (!hash || hash === '#') return;

      const tabName = hash.replace('#', '');
      const tab = document.querySelector(`.wechat-tab[data-tab="${tabName}"]`);
      if (!tab) return; // 非 wechat tab 的锚点（如 #feishu）交给浏览器原生滚动

      tab.click();

      const target = document.querySelector(`[data-tab-panel="${tabName}"]`) ||
                     document.getElementById(tabName);
      if (target) {
        setTimeout(() => target.scrollIntoView({ block: 'start' }), 0);
      }
    }

    document.addEventListener('DOMContentLoaded', activateTabFromHash);
    document.addEventListener('turbo:load', activateTabFromHash);
  })();
</script>
