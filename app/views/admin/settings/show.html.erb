<div class="space-y-6">
  <div>
    <h1 class="text-3xl font-bold text-gray-900">设置</h1>
    <p class="text-gray-600 mt-1">配置您的 API 密钥和系统设置</p>
  </div>

  <!-- WeChat API Provider Section -->
  <div class="card">
    <h2 class="text-xl font-bold text-gray-900 mb-4">微信 API 设置</h2>

    <!-- Provider Selector -->
    <div class="mb-6">
      <label class="block text-sm font-medium text-gray-700 mb-2">API 提供商</label>
      <%= form_with url: admin_settings_path, method: :patch, class: "flex items-center gap-3", data: { turbo: false } do |f| %>
        <select name="wechat_api_provider" id="wechat_provider_select"
                class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                onchange="this.form.requestSubmit()">
          <option value="mptext" <%= 'selected' if @wechat_api_provider == 'mptext' %>>MPText (down.mptext.top)</option>
          <option value="dajiala" <%= 'selected' if @wechat_api_provider == 'dajiala' %>>Dajiala (dajiala.com)</option>
        </select>
        <noscript><button type="submit" class="btn btn-primary text-sm">切换</button></noscript>
      <% end %>
      <p class="mt-1 text-sm text-gray-500">选择用于抓取微信公众号文章的 API 服务</p>
    </div>

    <!-- MPText Section -->
    <div id="mptext_section" style="display: <%= @wechat_api_provider == 'mptext' ? 'block' : 'none' %>">
      <h3 class="text-lg font-semibold text-gray-800 mb-3">MPText API</h3>

      <% if @api_key_value.present? %>
        <div class="mb-4 p-4 bg-blue-50 border border-blue-200 rounded-lg">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-blue-900">当前 API 密钥</p>
              <p class="text-sm text-blue-700 mt-1 font-mono"><%= mask_api_key(@api_key_value) %></p>
              <p class="text-sm text-blue-700 mt-1">
                过期时间：<%= @api_key_expires_at ? Time.parse(@api_key_expires_at).strftime('%Y-%m-%d %H:%M') : '永不过期' %>
                <% if @api_key_expires_at && Time.parse(@api_key_expires_at) < 24.hours.from_now %>
                  <span class="ml-2 text-red-600 font-semibold">⚠️ 即将过期！</span>
                <% end %>
              </p>
              <% if @wechat_key_check %>
                <p class="text-sm mt-1">
                  上次验证：
                  <% if @wechat_key_check[:valid] == true %>
                    <span class="text-green-700 font-semibold">✓ 有效</span>
                  <% elsif @wechat_key_check[:valid] == false %>
                    <span class="text-red-700 font-semibold">✗ 无效</span>
                  <% else %>
                    <span class="text-yellow-700 font-semibold">? 验证失败</span>
                  <% end %>
                  <span class="text-gray-500 text-xs ml-1">(<%= Time.parse(@wechat_key_check[:checked_at]).strftime('%Y-%m-%d %H:%M') %>)</span>
                </p>
              <% end %>
            </div>
            <div class="flex flex-col items-end gap-2">
              <%= button_to "验证接口", validate_wechat_key_admin_settings_path, method: :post,
                  class: "text-sm px-3 py-1.5 rounded bg-blue-600 text-white hover:bg-blue-700 transition" %>
            </div>
          </div>
        </div>
      <% else %>
        <div class="mb-4 p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
          <p class="text-sm text-yellow-800">未配置 API 密钥。请在下方添加。</p>
        </div>
      <% end %>

      <%= form_with url: admin_settings_path, method: :patch, class: "space-y-4" do |f| %>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">API 密钥</label>
          <input type="text" name="api_key" placeholder="输入您从 down.mptext.top 获取的 API 密钥"
                 class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
          <p class="mt-1 text-sm text-gray-500">
            从 <a href="https://down.mptext.top/dashboard/api" target="_blank" class="text-primary hover:underline">https://down.mptext.top/dashboard/api</a> 获取您的 API 密钥
          </p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">过期时间（天）</label>
          <select name="expires_days" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
            <option value="4" selected>4 天（推荐）</option>
            <option value="3">3 天</option>
            <option value="5">5 天</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">更新 API 密钥</button>
      <% end %>
    </div>

    <!-- Dajiala Section -->
    <div id="dajiala_section" style="display: <%= @wechat_api_provider == 'dajiala' ? 'block' : 'none' %>">
      <h3 class="text-lg font-semibold text-gray-800 mb-3">Dajiala API</h3>

      <% if @dajiala_api_key.present? %>
        <div class="mb-4 p-4 bg-indigo-50 border border-indigo-200 rounded-lg">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-indigo-900">当前 API 密钥</p>
              <p class="text-sm text-indigo-700 mt-1 font-mono"><%= mask_api_key(@dajiala_api_key) %></p>
              <% if @dajiala_key_check %>
                <p class="text-sm mt-1">
                  上次验证：
                  <% if @dajiala_key_check[:valid] == true %>
                    <span class="text-green-700 font-semibold">✓ 有效</span>
                  <% elsif @dajiala_key_check[:valid] == false %>
                    <span class="text-red-700 font-semibold">✗ 无效</span>
                  <% else %>
                    <span class="text-yellow-700 font-semibold">? 验证失败</span>
                  <% end %>
                  <span class="text-gray-500 text-xs ml-1">(<%= Time.parse(@dajiala_key_check[:checked_at]).strftime('%Y-%m-%d %H:%M') %>)</span>
                </p>
              <% end %>
            </div>
            <div class="flex flex-col items-end gap-2">
              <%= button_to "验证接口", validate_dajiala_key_admin_settings_path, method: :post,
                  class: "text-sm px-3 py-1.5 rounded bg-indigo-600 text-white hover:bg-indigo-700 transition" %>
            </div>
          </div>
        </div>
      <% else %>
        <div class="mb-4 p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
          <p class="text-sm text-yellow-800">未配置 Dajiala API 密钥。请在下方添加。</p>
        </div>
      <% end %>

      <%= form_with url: admin_settings_path, method: :patch, class: "space-y-4" do |f| %>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">API 密钥</label>
          <input type="text" name="dajiala_api_key" placeholder="输入您的 Dajiala API 密钥"
                 class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
          <p class="mt-1 text-sm text-gray-500">
            从 <a href="https://www.dajiala.com" target="_blank" class="text-primary hover:underline">dajiala.com</a> 获取您的 API 密钥
          </p>
        </div>

        <button type="submit" class="btn btn-primary">保存 Dajiala 密钥</button>
      <% end %>
    </div>
  </div>

  <!-- RedNote API Key -->
  <div class="card">
    <h2 class="text-xl font-bold text-gray-900 mb-4">小红书 API 密钥</h2>

    <% if @rednote_api_key.present? %>
      <div class="mb-4 p-4 bg-green-50 border border-green-200 rounded-lg">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-green-900">当前 API 密钥</p>
            <p class="text-sm text-green-700 mt-1 font-mono"><%= mask_api_key(@rednote_api_key) %></p>
            <% if @rednote_key_check %>
              <p class="text-sm mt-1">
                上次验证：
                <% if @rednote_key_check[:valid] == true %>
                  <span class="text-green-700 font-semibold">✓ 有效</span>
                <% elsif @rednote_key_check[:valid] == false %>
                  <span class="text-red-700 font-semibold">✗ 无效</span>
                <% else %>
                  <span class="text-yellow-700 font-semibold">? 验证失败</span>
                <% end %>
                <span class="text-gray-500 text-xs ml-1">(<%= Time.parse(@rednote_key_check[:checked_at]).strftime('%Y-%m-%d %H:%M') %>)</span>
              </p>
            <% end %>
          </div>
          <%= button_to "验证接口", validate_rednote_key_admin_settings_path, method: :post,
              class: "text-sm px-3 py-1.5 rounded bg-green-600 text-white hover:bg-green-700 transition self-start" %>
        </div>
      </div>
    <% end %>

    <%= form_with url: admin_settings_path, method: :patch, class: "space-y-4" do |f| %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">API 密钥</label>
        <%= text_field_tag :rednote_api_key, nil,
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent",
            placeholder: "输入小红书 API 密钥" %>
      </div>

      <div class="flex items-center justify-end">
        <button type="submit" class="btn btn-primary">保存小红书密钥</button>
      </div>
    <% end %>
  </div>

  <!-- Twitter Cookies -->
  <div class="card">
    <h2 class="text-xl font-bold text-gray-900 mb-4">Twitter Cookies</h2>

    <% if @twitter_ct0.present? && @twitter_auth_token.present? %>
      <div class="mb-4 p-4 bg-sky-50 border border-sky-200 rounded-lg">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-sky-900">当前 Cookies</p>
            <p class="text-sm text-sky-700 mt-1 font-mono">ct0: <%= mask_api_key(@twitter_ct0) %></p>
            <p class="text-sm text-sky-700 mt-1 font-mono">auth_token: <%= mask_api_key(@twitter_auth_token) %></p>
            <% if @twitter_proxy.present? %>
              <p class="text-sm text-sky-700 mt-1 font-mono">代理: <%= mask_api_key(@twitter_proxy) %></p>
            <% end %>
            <% if @twitter_key_check %>
              <p class="text-sm mt-1">
                上次验证：
                <% if @twitter_key_check[:valid] == true %>
                  <span class="text-green-700 font-semibold">✓ 有效</span>
                <% elsif @twitter_key_check[:valid] == false %>
                  <span class="text-red-700 font-semibold">✗ 无效</span>
                <% else %>
                  <span class="text-yellow-700 font-semibold">? 验证失败</span>
                <% end %>
                <span class="text-gray-500 text-xs ml-1">(<%= Time.parse(@twitter_key_check[:checked_at]).strftime('%Y-%m-%d %H:%M') %>)</span>
              </p>
            <% end %>
          </div>
          <%= button_to "验证接口", validate_twitter_key_admin_settings_path, method: :post,
              class: "text-sm px-3 py-1.5 rounded bg-sky-600 text-white hover:bg-sky-700 transition self-start" %>
        </div>
      </div>
    <% else %>
      <div class="mb-4 p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
        <p class="text-sm text-yellow-800">未配置 Twitter cookies。请在下方添加。</p>
        <p class="text-xs text-yellow-700 mt-1">从浏览器中获取 x.com 的 ct0 和 auth_token cookies</p>
      </div>
    <% end %>

    <%= form_with url: admin_settings_path, method: :patch, class: "space-y-4" do |f| %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">ct0 Cookie</label>
        <%= text_field_tag :twitter_ct0, nil,
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent",
            placeholder: "输入 ct0 cookie 值" %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">auth_token Cookie</label>
        <%= text_field_tag :twitter_auth_token, nil,
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent",
            placeholder: "输入 auth_token cookie 值" %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">代理服务器（可选）</label>
        <%= text_field_tag :twitter_proxy, @twitter_proxy,
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent",
            placeholder: "http://user:pass@host:port 或留空" %>
        <p class="mt-1 text-sm text-gray-500">
          HTTP/HTTPS 代理地址，格式：http://user:pass@host:port（留空则不使用代理）
        </p>
      </div>

      <div class="flex items-center justify-end">
        <button type="submit" class="btn btn-primary">保存 Twitter Cookies</button>
      </div>
    <% end %>
  </div>

  <!-- TikHub API Key -->
  <div class="card">
    <h2 class="text-xl font-bold text-gray-900 mb-4">TikHub API 密钥</h2>
    <p class="text-sm text-gray-600 mb-4">用于小红书用户搜索功能（按名称搜索帐号）</p>

    <% if @tikhub_api_key.present? %>
      <div class="mb-4 p-4 bg-purple-50 border border-purple-200 rounded-lg">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-purple-900">当前 API 密钥</p>
            <p class="text-sm text-purple-700 mt-1 font-mono"><%= mask_api_key(@tikhub_api_key) %></p>
            <% if @tikhub_key_check %>
              <p class="text-sm mt-1">
                上次验证：
                <% if @tikhub_key_check[:valid] == true %>
                  <span class="text-green-700 font-semibold">✓ 有效</span>
                <% elsif @tikhub_key_check[:valid] == false %>
                  <span class="text-red-700 font-semibold">✗ 无效</span>
                <% else %>
                  <span class="text-yellow-700 font-semibold">? 验证失败</span>
                <% end %>
                <span class="text-gray-500 text-xs ml-1">(<%= Time.parse(@tikhub_key_check[:checked_at]).strftime('%Y-%m-%d %H:%M') %>)</span>
              </p>
            <% end %>
          </div>
          <%= button_to "验证接口", validate_tikhub_key_admin_settings_path, method: :post,
              class: "text-sm px-3 py-1.5 rounded bg-purple-600 text-white hover:bg-purple-700 transition self-start" %>
        </div>
      </div>
    <% else %>
      <div class="mb-4 p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
        <p class="text-sm text-yellow-800">未配置 TikHub API 密钥。小红书按名称搜索功能将不可用。</p>
        <p class="text-xs text-yellow-700 mt-1">从 <a href="https://tikhub.io" target="_blank" class="text-primary hover:underline">tikhub.io</a> 获取 API Token</p>
      </div>
    <% end %>

    <%= form_with url: admin_settings_path, method: :patch, class: "space-y-4" do |f| %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">API Token</label>
        <%= text_field_tag :tikhub_api_key, nil,
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent",
            placeholder: "输入 TikHub API Token" %>
        <p class="mt-1 text-sm text-gray-500">
          从 <a href="https://tikhub.io" target="_blank" class="text-primary hover:underline">tikhub.io</a> 用户中心获取 API Token
        </p>
      </div>

      <div class="flex items-center justify-end">
        <button type="submit" class="btn btn-primary">保存 TikHub 密钥</button>
      </div>
    <% end %>
  </div>

  <!-- Crawl Settings -->
  <div class="card">
    <h2 class="text-xl font-bold text-gray-900 mb-4">抓取设置</h2>

    <%= form_with url: admin_settings_path, method: :patch, class: "space-y-4" do |f| %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">默认账号并发数</label>
        <input type="number" name="default_account_concurrency" value="<%= @default_account_concurrency %>" min="1" max="20"
               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
        <p class="mt-1 text-sm text-gray-500">
          同时抓取的帐号数量（1-20）。数值越高速度越快，但系统负载也越大。
        </p>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">默认文章并发数</label>
        <input type="number" name="default_article_concurrency" value="<%= @default_article_concurrency %>" min="5" max="50"
               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
        <p class="mt-1 text-sm text-gray-500">
          每个帐号抓取时的并发请求数（5-50）。数值越高速度越快，但 API 负载也越大。
        </p>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">最大抓取页数</label>
        <input type="number" name="max_crawl_pages" value="<%= @max_crawl_pages %>" min="1" max="100"
               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
        <p class="mt-1 text-sm text-gray-500">
          每个帐号最多抓取的文章页数（1-100）。每页约20篇文章。
        </p>
      </div>

      <button type="submit" class="btn btn-primary">更新设置</button>
    <% end %>
  </div>

  <!-- Logging Settings -->
  <div class="card">
    <h2 class="text-xl font-bold text-gray-900 mb-4">日志设置</h2>

    <%= form_with url: admin_settings_path, method: :patch, class: "space-y-4" do |f| %>
      <div>
        <label class="flex items-center space-x-3 cursor-pointer">
          <input type="hidden" name="verbose_mode" value="0">
          <input type="checkbox" name="verbose_mode" value="1" <%= 'checked' if @verbose_mode %>
                 class="w-5 h-5 text-primary border-gray-300 rounded focus:ring-2 focus:ring-primary">
          <div>
            <span class="text-sm font-medium text-gray-700">启用详细日志</span>
            <p class="text-xs text-gray-500">在抓取期间记录详细信息（调试级别）</p>
          </div>
        </label>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">日志保留天数</label>
        <input type="number" name="log_retention_days" value="<%= @log_retention_days %>" min="1" max="90"
               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
        <p class="mt-1 text-sm text-gray-500">
          自动删除超过此天数的日志（1-90）
        </p>
      </div>

      <button type="submit" class="btn btn-primary">更新日志设置</button>
    <% end %>
  </div>

  <!-- Info Section -->
  <div class="card bg-gray-50">
    <h3 class="font-semibold text-gray-900 mb-2">重要说明</h3>
    <ul class="space-y-2 text-sm text-gray-600">
      <li>• <strong>MPText</strong>：API 密钥每 4 天过期一次，必须手动更新；当密钥过期时，抓取任务将自动暂停</li>
      <li>• <strong>Dajiala</strong>：使用公众号名称抓取文章，无需 fakeid；如遇频率限制可切换回 MPText</li>
      <li>• 两个提供商的搜索导入功能均使用 MPText API</li>
      <li>• 更高的并发数 = 更快的抓取速度，但可能触发速率限制</li>
    </ul>
  </div>
</div>
