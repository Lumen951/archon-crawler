<div class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <h2 class="text-2xl font-bold text-text-primary">MCP 使用日志</h2>
    <%= link_to admin_analytics_path, class: "btn btn-default" do %>
      返回管理首页
    <% end %>
  </div>

  <%# ── 概览 ── %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <%= render "admin/analytics/stat_card", label: "总调用数（当前筛选）", value: @total, icon: "fa-bolt", color: "blue" %>
    <%= render "admin/analytics/stat_card", label: "报错数", value: @error_count, icon: "fa-triangle-exclamation", color: "red" %>
    <%= render "admin/analytics/stat_card", label: "涉及用户数", value: @distinct_users, icon: "fa-users", color: "indigo" %>
  </div>

  <%# ── 筛选 ── %>
  <%= search_form_for @q, url: admin_mcp_tool_calls_path, html: { method: :get, class: "bg-bg-card border border-border-primary rounded-lg p-4" } do |f| %>
    <div class="grid grid-cols-1 md:grid-cols-5 gap-3 items-end">
      <div>
        <label class="block text-xs font-semibold text-text-secondary mb-1">用户邮箱</label>
        <%= f.search_field :user_email_address_cont, placeholder: "包含…", class: "form-input" %>
      </div>
      <div>
        <label class="block text-xs font-semibold text-text-secondary mb-1">工具</label>
        <%= f.select :tool_name_eq, options_for_select(@tool_names, params.dig(:q, :tool_name_eq)), { include_blank: "全部" }, class: "form-input" %>
      </div>
      <div>
        <label class="block text-xs font-semibold text-text-secondary mb-1">方法</label>
        <%= f.select :method_eq, options_for_select(@methods, params.dig(:q, :method_eq)), { include_blank: "全部" }, class: "form-input" %>
      </div>
      <div>
        <label class="block text-xs font-semibold text-text-secondary mb-1">状态</label>
        <%= f.select :status_eq, options_for_select([["成功", 0], ["失败", 1]], params.dig(:q, :status_eq)), { include_blank: "全部" }, class: "form-input" %>
      </div>
      <div class="flex gap-2">
        <%= f.submit "筛选", class: "btn btn-primary cursor-pointer" %>
        <%= link_to "重置", admin_mcp_tool_calls_path, class: "btn btn-default" %>
      </div>
    </div>
  <% end %>

  <%# ── 列表 ── %>
  <div class="bg-bg-card border border-border-primary rounded-lg overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-bg-secondary text-xs text-text-secondary uppercase">
          <tr>
            <th class="px-4 py-3 text-left font-semibold">时间</th>
            <th class="px-4 py-3 text-left font-semibold">用户</th>
            <th class="px-4 py-3 text-left font-semibold">方法</th>
            <th class="px-4 py-3 text-left font-semibold">工具 / 目标</th>
            <th class="px-4 py-3 text-left font-semibold">状态</th>
            <th class="px-4 py-3 text-left font-semibold">耗时</th>
            <th class="px-4 py-3 text-left font-semibold">响应大小</th>
            <th class="px-4 py-3 text-left font-semibold">IP</th>
            <th class="px-4 py-3 text-left font-semibold"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border-primary">
          <% @mcp_tool_calls.each do |call| %>
            <tr class="hover:bg-bg-secondary transition">
              <td class="px-4 py-3 text-text-secondary whitespace-nowrap"><%= call.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
              <td class="px-4 py-3 text-text-primary">
                <% if call.user %>
                  <%= link_to call.user.email_address, admin_user_path(call.user), class: "text-brand hover:underline" %>
                <% else %>
                  <span class="text-text-muted">—</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-text-secondary font-mono text-xs"><%= call.method %></td>
              <td class="px-4 py-3 font-medium text-text-primary max-w-[220px] truncate" title="<%= call.target_label %>"><%= call.target_label %></td>
              <td class="px-4 py-3">
                <% if call.error? %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-700">失败</span>
                <% else %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-teal-100 text-teal-700">成功</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-text-secondary"><%= call.duration_ms ? "#{call.duration_ms}ms" : "—" %></td>
              <td class="px-4 py-3 text-text-secondary"><%= call.response_size ? number_to_human_size(call.response_size) : "—" %></td>
              <td class="px-4 py-3 text-text-secondary text-xs"><%= call.ip_address.presence || "—" %></td>
              <td class="px-4 py-3 text-right">
                <%= link_to "详情", admin_mcp_tool_call_path(call), class: "text-xs text-brand hover:underline font-semibold" %>
              </td>
            </tr>
          <% end %>
          <% if @mcp_tool_calls.empty? %>
            <tr><td colspan="9" class="px-4 py-8 text-center text-text-muted">暂无记录</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%# ── 分页 ── %>
  <% if @page > 1 || @has_next %>
    <div class="flex justify-between items-center">
      <% if @page > 1 %>
        <%= link_to "← 上一页", admin_mcp_tool_calls_path(params.to_unsafe_h.merge(page: @page - 1).except(:controller, :action)), class: "btn btn-default" %>
      <% else %><span></span><% end %>
      <span class="text-sm text-text-secondary">第 <%= @page %> 页</span>
      <% if @has_next %>
        <%= link_to "下一页 →", admin_mcp_tool_calls_path(params.to_unsafe_h.merge(page: @page + 1).except(:controller, :action)), class: "btn btn-default" %>
      <% else %><span></span><% end %>
    </div>
  <% end %>
</div>
