<div class="max-w-2xl mx-auto">
  <div class="mb-6">
    <%= link_to admin_tags_path, class: "text-sm text-brand hover:text-brand-dark font-semibold transition" do %>
      ← 返回标签列表
    <% end %>
  </div>

  <div class="bg-bg-card border border-border-primary rounded-lg p-6">
    <h2 class="text-2xl font-bold text-text-primary mb-6">编辑标签</h2>

    <%= form_with(model: [:admin, @tag], class: "space-y-6") do |f| %>
      <div>
        <%= f.label :name, "标签名称", class: "block text-sm font-medium text-text-primary mb-1" %>
        <%= f.text_field :name,
            class: "w-full h-10 px-4 rounded-lg border border-border-primary bg-bg-secondary text-text-primary focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand text-sm transition" %>
      </div>

      <div>
        <%= f.label :color, "颜色", class: "block text-sm font-medium text-text-primary mb-1" %>
        <div class="flex items-center gap-3">
          <%= f.color_field :color, class: "h-10 w-16 rounded-lg border border-border-primary cursor-pointer" %>
          <span class="text-sm text-text-secondary">选择标签颜色</span>
        </div>
      </div>

      <div>
        <%= f.label :description, "描述", class: "block text-sm font-medium text-text-primary mb-1" %>
        <%= f.text_area :description, rows: 3,
            class: "w-full px-4 py-2 rounded-lg border border-border-primary bg-bg-secondary text-text-primary focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand text-sm transition" %>
      </div>

      <div>
        <%= f.label :position, "排序", class: "block text-sm font-medium text-text-primary mb-1" %>
        <%= f.number_field :position,
            class: "w-32 h-10 px-4 rounded-lg border border-border-primary bg-bg-secondary text-text-primary focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand text-sm transition" %>
        <p class="text-xs text-text-muted mt-1">数字越小越靠前</p>
      </div>

      <div class="flex justify-end gap-3">
        <%= link_to "取消", admin_tags_path, class: "btn btn-default" %>
        <%= f.submit "保存", class: "btn btn-primary cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
