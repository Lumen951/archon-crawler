<div class="space-y-8">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-2xl font-bold text-text-primary">标签管理</h2>
      <p class="mt-1 text-sm text-text-secondary"><%= @tags.size %> 个标签</p>
    </div>
    <%= button_to refresh_counts_admin_tags_path, method: :post, class: "btn btn-default gap-2" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
      </svg>
      刷新计数
    <% end %>
  </div>

  <% if @tags.any? %>
    <!-- Desktop Table -->
    <div class="hidden md:block bg-bg-card border border-border-primary rounded-lg overflow-hidden">
      <table class="min-w-full divide-y divide-border-primary">
        <thead class="bg-bg-secondary">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">标签</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">帐号数</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">描述</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">排序</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-text-secondary uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="bg-bg-card divide-y divide-border-primary">
          <% @tags.each do |tag| %>
            <tr class="hover:bg-bg-secondary transition">
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center gap-2">
                  <span class="w-4 h-4 rounded-full flex-shrink-0" style="background-color: <%= tag.color %>"></span>
                  <span class="text-sm font-medium text-text-primary"><%= tag.name %></span>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-text-secondary">
                <%= tag.tag_accounts_count %>
              </td>
              <td class="px-6 py-4 text-sm text-text-secondary max-w-xs truncate">
                <%= tag.description.presence || "-" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-text-secondary">
                <%= tag.position %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right">
                <div class="flex items-center justify-end gap-2">
                  <%= link_to edit_admin_tag_path(tag), class: "btn btn-default btn-sm" do %>
                    编辑
                  <% end %>
                  <%= button_to admin_tag_path(tag), method: :delete, data: { turbo_confirm: "确定删除标签「#{tag.name}」？将移除 #{tag.tag_accounts_count} 个帐号关联。" }, class: "h-8 px-3 rounded-lg border border-red-200 bg-bg-card text-red-600 hover:border-red-400 hover:bg-red-50 text-xs font-semibold transition" do %>
                    删除
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Mobile Cards -->
    <div class="md:hidden space-y-4">
      <% @tags.each do |tag| %>
        <div class="bg-bg-card border border-border-primary rounded-lg p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-4 h-4 rounded-full flex-shrink-0" style="background-color: <%= tag.color %>"></span>
            <span class="text-sm font-semibold text-text-primary"><%= tag.name %></span>
            <span class="text-xs text-text-secondary">(<%= tag.tag_accounts_count %> 个帐号)</span>
          </div>
          <% if tag.description.present? %>
            <p class="text-sm text-text-secondary mb-3"><%= tag.description %></p>
          <% end %>
          <div class="flex gap-2">
            <%= link_to edit_admin_tag_path(tag), class: "flex-1 h-9 px-4 rounded-lg bg-bg-secondary text-brand hover:bg-brand hover:text-white font-semibold text-sm transition inline-flex items-center justify-center" do %>
              编辑
            <% end %>
            <%= button_to admin_tag_path(tag), method: :delete, data: { turbo_confirm: "确定删除标签「#{tag.name}」？" }, class: "flex-1 h-9 px-4 rounded-lg bg-red-100 text-red-600 hover:bg-red-200 font-semibold text-sm transition" do %>
              删除
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-bg-card border border-border-primary rounded-lg text-center py-12">
      <p class="text-text-secondary mb-2">暂无标签</p>
      <p class="text-text-muted text-sm">在帐号管理页面批量打标签时会自动创建</p>
    </div>
  <% end %>
</div>
