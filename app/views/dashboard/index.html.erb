<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-text-primary">工作台</h1>
    <p class="mt-1 text-sm text-text-secondary">源策未来多源内容与研究追踪概览</p>
  </div>

  <!-- 统计卡片：整卡可点击，直达对应页面 -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
    <%= link_to accounts_path, class: "block bg-bg-card border border-border-primary rounded-lg p-4 transition hover:border-brand/60" do %>
      <div class="text-xs font-medium text-text-secondary">内容源总数</div>
      <div class="mt-1 flex items-baseline gap-2">
        <span class="text-2xl font-bold text-text-primary"><%= @total_accounts %></span>
        <span class="text-xs text-text-muted">启用 <%= @active_accounts %></span>
      </div>
    <% end %>
    <%= link_to articles_path, class: "block bg-bg-card border border-border-primary rounded-lg p-4 transition hover:border-brand/60" do %>
      <div class="text-xs font-medium text-text-secondary">内容总数</div>
      <div class="mt-1 text-2xl font-bold text-text-primary"><%= @total_articles %></div>
    <% end %>
    <%= link_to crawl_tasks_path(status: 'running'), class: "block bg-bg-card border border-border-primary rounded-lg p-4 transition hover:border-brand/60" do %>
      <div class="text-xs font-medium text-text-secondary">活跃任务</div>
      <div class="mt-1 text-2xl font-bold <%= @pending_tasks > 0 ? 'text-orange-600' : 'text-text-primary' %>"><%= @pending_tasks %></div>
    <% end %>
    <%= link_to accounts_path, class: "block bg-bg-card border border-border-primary rounded-lg p-4 transition hover:border-brand/60" do %>
      <div class="text-xs font-medium text-text-secondary">待采集内容源</div>
      <div class="mt-1 text-2xl font-bold <%= @due_accounts > 0 ? 'text-brand' : 'text-text-primary' %>"><%= @due_accounts %></div>
    <% end %>
  </div>

  <% if @followed_tags_count > 0 %>
    <!-- 我的关注：一行横向摘要，标签太多时收敛为 +N -->
    <div class="bg-bg-card border border-border-primary rounded-lg px-5 py-4">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <span class="flex items-center gap-1.5 text-sm font-semibold text-brand">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
          </svg>
          我的关注
        </span>
        <span class="text-sm text-text-secondary">今日新文章 <span class="font-bold text-text-primary"><%= @followed_articles_today %></span></span>
        <span class="text-sm text-text-secondary">关注 <%= @followed_tags_count %> 个标签 · 关联 <%= @followed_accounts_count %> 个帐号</span>
        <div class="flex flex-wrap items-center gap-1">
          <% current_user.followed_tags.each do |tag| %>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium" style="background-color: <%= tag.color %>15; color: <%= tag.color %>">
              <span class="w-1.5 h-1.5 rounded-full" style="background-color: <%= tag.color %>"></span>
              <%= tag.name %>
            </span>
          <% end %>
        </div>
        <%= link_to "按标签浏览文章 →", articles_path, class: "ml-auto text-sm font-semibold text-brand hover:text-brand-dark transition" %>
      </div>
    </div>
  <% end %>

  <!-- 最近的抓取任务：占满整行，操作台最常用的动态 -->
  <div>
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-lg font-bold text-text-primary">最近的抓取任务</h2>
      <%= link_to crawl_tasks_path, class: "text-brand hover:text-brand-dark text-sm font-semibold transition" do %>
        查看全部 →
      <% end %>
    </div>

    <%= render 'crawl_tasks/tasks_table', tasks: @recent_tasks %>
  </div>

  <!-- RSS 订阅：低频配置项，默认折叠避免挤占首屏 -->
  <details class="bg-bg-card border border-border-primary rounded-lg group">
    <summary class="flex items-center justify-between px-5 py-4 cursor-pointer select-none list-none">
      <span class="flex items-center gap-2 text-sm font-semibold text-text-primary">
        <svg class="w-4 h-4 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z"/>
        </svg>
        RSS 订阅
        <span class="text-xs font-normal text-text-secondary hidden group-open:inline">（复制地址到你的阅读器即可）</span>
      </span>
      <svg class="w-4 h-4 text-text-secondary transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
      </svg>
    </summary>

    <div class="px-5 pb-5 pt-4 border-t border-border-primary grid md:grid-cols-2 xl:grid-cols-3 gap-x-8 gap-y-5">
      <% if current_user && current_user.api_keys.active.any? %>
        <div>
          <h3 class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-2">个人订阅 <span class="normal-case font-normal">· 按关注标签过滤</span></h3>
          <div class="flex items-center gap-1.5">
            <%= link_to "RSS", user_rss_path(current_user.api_keys.active.first.token),
                class: "text-xs text-brand hover:text-brand-dark font-semibold transition",
                target: "_blank",
                title: user_rss_url(current_user.api_keys.active.first.token) %>
            <%= render 'shared/copy_button', text: user_rss_url(current_user.api_keys.active.first.token) %>
          </div>
        </div>
      <% end %>

      <div>
        <h3 class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-2">文章订阅</h3>
        <div class="space-y-1.5">
          <% [
            ['今天', 'today'],
            ['昨天', 'yesterday'],
            ['最近7天', '7days'],
            ['最近1月', '1month']
          ].each do |label, period| %>
            <div class="flex items-center justify-between gap-2">
              <span class="text-sm text-text-secondary"><%= label %></span>
              <div class="flex items-center gap-1.5">
                <%= link_to "RSS", all_accounts_rss_path(period: period),
                    class: "text-xs text-brand hover:text-brand-dark font-semibold transition",
                    target: "_blank",
                    title: all_accounts_rss_url(period: period) %>
                <%= render 'shared/copy_button', text: all_accounts_rss_url(period: period) %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div>
        <h3 class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-2">帐号列表</h3>
        <div class="space-y-1.5">
          <div class="flex items-center justify-between gap-2">
            <span class="text-sm text-text-secondary">全部帐号</span>
            <div class="flex items-center gap-1.5">
              <%= link_to "RSS", accounts_list_rss_path,
                  class: "text-xs text-brand hover:text-brand-dark font-semibold transition",
                  target: "_blank",
                  title: accounts_list_rss_url %>
              <%= render 'shared/copy_button', text: accounts_list_rss_url %>
            </div>
          </div>
          <div class="flex items-center justify-between gap-2">
            <span class="text-sm text-text-secondary">启用的帐号</span>
            <div class="flex items-center gap-1.5">
              <%= link_to "RSS", active_accounts_list_rss_path,
                  class: "text-xs text-brand hover:text-brand-dark font-semibold transition",
                  target: "_blank",
                  title: active_accounts_list_rss_url %>
              <%= render 'shared/copy_button', text: active_accounts_list_rss_url %>
            </div>
          </div>
        </div>
      </div>

      <div>
        <h3 class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-2">网站监控订阅</h3>
        <div class="space-y-1.5">
          <div class="flex items-center justify-between gap-2">
            <span class="text-sm text-text-secondary">全部变更</span>
            <div class="flex items-center gap-1.5">
              <%= link_to "RSS", monitor_changes_rss_path,
                  class: "text-xs text-brand hover:text-brand-dark font-semibold transition",
                  target: "_blank",
                  title: monitor_changes_rss_url %>
              <%= render 'shared/copy_button', text: monitor_changes_rss_url %>
            </div>
          </div>
          <div class="flex items-center justify-between gap-2">
            <span class="text-sm text-text-secondary">重要变更</span>
            <div class="flex items-center gap-1.5">
              <%= link_to "RSS", important_monitor_changes_rss_path,
                  class: "text-xs text-brand hover:text-brand-dark font-semibold transition",
                  target: "_blank",
                  title: important_monitor_changes_rss_url %>
              <%= render 'shared/copy_button', text: important_monitor_changes_rss_url %>
            </div>
          </div>
          <div class="flex items-center justify-between gap-2">
            <span class="text-sm text-text-secondary">监控页面</span>
            <div class="flex items-center gap-1.5">
              <%= link_to "RSS", monitor_pages_rss_path,
                  class: "text-xs text-brand hover:text-brand-dark font-semibold transition",
                  target: "_blank",
                  title: monitor_pages_rss_url %>
              <%= render 'shared/copy_button', text: monitor_pages_rss_url %>
            </div>
          </div>
        </div>
      </div>

      <% tags = Tag.ordered %>
      <% if tags.any? %>
        <div class="md:col-span-2 xl:col-span-1">
          <h3 class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-2">标签订阅</h3>
          <div class="space-y-1.5">
            <% tags.each do |tag| %>
              <div class="flex items-center justify-between gap-2">
                <span class="flex items-center gap-1.5 text-sm text-text-secondary">
                  <span class="w-2 h-2 rounded-full flex-shrink-0" style="background-color: <%= tag.color %>"></span>
                  <%= tag.name %>
                </span>
                <div class="flex items-center gap-1.5">
                  <%= link_to "RSS", tag_rss_path(tag),
                      class: "text-xs text-brand hover:text-brand-dark font-semibold transition",
                      target: "_blank",
                      title: tag_rss_url(tag) %>
                  <%= render 'shared/copy_button', text: tag_rss_url(tag) %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </details>
</div>
