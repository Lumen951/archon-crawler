<div class="space-y-8">
  <div>
    <h1 class="text-3xl font-bold text-text-primary">控制台</h1>
    <p class="text-text-secondary mt-2">微信公众号文章抓取系统概览</p>
  </div>

  <!-- RSS Feed Section -->
  <div class="bg-bg-card border border-border-primary rounded-2xl p-6 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
    <h2 class="text-lg font-semibold text-text-primary mb-4 flex items-center gap-2">
      <svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z"/>
      </svg>
      RSS 订阅
    </h2>

    <!-- Article Feeds -->
    <div class="mb-4">
      <h3 class="text-sm font-medium text-text-secondary mb-3">文章订阅</h3>
      <div class="flex flex-wrap gap-3">
        <div class="flex items-center gap-2">
          <span class="text-sm text-text-secondary">今天:</span>
          <%= link_to "RSS", all_accounts_rss_path(period: 'today'),
              class: "text-sm text-brand hover:text-brand-dark font-semibold transition",
              target: "_blank",
              title: all_accounts_rss_url(period: 'today') %>
          <%= render 'shared/copy_button', text: all_accounts_rss_url(period: 'today') %>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-sm text-text-secondary">昨天:</span>
          <%= link_to "RSS", all_accounts_rss_path(period: 'yesterday'),
              class: "text-sm text-brand hover:text-brand-dark font-semibold transition",
              target: "_blank",
              title: all_accounts_rss_url(period: 'yesterday') %>
          <%= render 'shared/copy_button', text: all_accounts_rss_url(period: 'yesterday') %>
        <div class="flex items-center gap-2">
          <span class="text-sm text-text-secondary">最近7天:</span>
          <%= link_to "RSS", all_accounts_rss_path(period: '7days'),
              class: "text-sm text-brand hover:text-brand-dark font-semibold transition",
              target: "_blank",
              title: all_accounts_rss_url(period: '7days') %>
          <%= render 'shared/copy_button', text: all_accounts_rss_url(period: '7days') %>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-sm text-text-secondary">最近1个月:</span>
          <%= link_to "RSS", all_accounts_rss_path(period: '1month'),
              class: "text-sm text-brand hover:text-brand-dark font-semibold transition",
              target: "_blank",
              title: all_accounts_rss_url(period: '1month') %>
          <%= render 'shared/copy_button', text: all_accounts_rss_url(period: '1month') %>
        </div>
      </div>
    </div>

    <!-- Account List Feeds -->
    <div class="pt-4 border-t border-border-primary">
      <h3 class="text-sm font-medium text-text-secondary mb-3">公众号列表订阅</h3>
      <div class="flex flex-wrap gap-3">
        <div class="flex items-center gap-2">
          <span class="text-sm text-text-secondary">全部公众号:</span>
          <%= link_to "RSS", accounts_list_rss_path,
              class: "text-sm text-brand hover:text-brand-dark font-semibold transition",
              target: "_blank",
              title: accounts_list_rss_url %>
          <%= render 'shared/copy_button', text: accounts_list_rss_url %>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-sm text-text-secondary">启用的公众号:</span>
          <%= link_to "RSS", active_accounts_list_rss_path,
              class: "text-sm text-brand hover:text-brand-dark font-semibold transition",
              target: "_blank",
              title: active_accounts_list_rss_url %>
          <%= render 'shared/copy_button', text: active_accounts_list_rss_url %>
        </div>
      </div>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
    <div class="bg-bg-card border border-border-primary rounded-xl p-6 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
      <div class="text-sm font-medium text-text-secondary">公众号总数</div>
      <div class="mt-2 text-3xl font-bold text-text-primary"><%= @total_accounts %></div>
    </div>

    <div class="bg-bg-card border border-border-primary rounded-xl p-6 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
      <div class="text-sm font-medium text-text-secondary">启用的公众号</div>
      <div class="mt-2 text-3xl font-bold text-green-600"><%= @active_accounts %></div>
    </div>

    <div class="bg-bg-card border border-border-primary rounded-xl p-6 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
      <div class="text-sm font-medium text-text-secondary">文章总数</div>
      <div class="mt-2 text-3xl font-bold text-blue-600"><%= @total_articles %></div>
    </div>

    <div class="bg-bg-card border border-border-primary rounded-xl p-6 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
      <div class="text-sm font-medium text-text-secondary">活跃任务</div>
      <div class="mt-2 text-3xl font-bold text-orange-600"><%= @pending_tasks %></div>
    </div>
  </div>

  <!-- Recent Crawl Tasks -->
  <div>
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-xl font-bold text-text-primary flex items-center gap-2">
        <svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
        </svg>
        最近的抓取任务
      </h2>
      <%= link_to crawl_tasks_path, class: "text-brand hover:text-brand-dark text-sm font-semibold transition" do %>
        查看全部 →
      <% end %>
    </div>

    <%= render 'crawl_tasks/tasks_table', tasks: @recent_tasks %>
  </div>
</div>
