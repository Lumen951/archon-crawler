<div class="space-y-6">
  <div>
    <h1 class="text-3xl font-bold text-text-primary">控制台</h1>
    <p class="text-text-secondary mt-2">帐号文章抓取系统概览</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Left Sidebar -->
    <div class="lg:col-span-4 space-y-6">
      <!-- Stats Cards -->
      <div class="grid grid-cols-2 gap-3">
        <div class="bg-bg-card border border-border-primary rounded-xl p-4 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
          <div class="text-xs font-medium text-text-secondary">帐号总数</div>
          <div class="mt-1 text-2xl font-bold text-text-primary"><%= @total_accounts %></div>
        </div>
        <div class="bg-bg-card border border-border-primary rounded-xl p-4 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
          <div class="text-xs font-medium text-text-secondary">启用的帐号</div>
          <div class="mt-1 text-2xl font-bold text-green-600"><%= @active_accounts %></div>
        </div>
        <div class="bg-bg-card border border-border-primary rounded-xl p-4 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
          <div class="text-xs font-medium text-text-secondary">文章总数</div>
          <div class="mt-1 text-2xl font-bold text-blue-600"><%= @total_articles %></div>
        </div>
        <div class="bg-bg-card border border-border-primary rounded-xl p-4 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
          <div class="text-xs font-medium text-text-secondary">活跃任务</div>
          <div class="mt-1 text-2xl font-bold text-orange-600"><%= @pending_tasks %></div>
        </div>
      </div>

      <% if @followed_tags_count > 0 %>
        <!-- Followed Tags Stats -->
        <div class="bg-bg-card border border-brand/20 rounded-xl p-4 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
          <h3 class="text-xs font-semibold text-brand mb-3 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
            </svg>
            我的关注
          </h3>
          <div class="grid grid-cols-3 gap-2">
            <div class="text-center">
              <div class="text-lg font-bold text-text-primary"><%= @followed_tags_count %></div>
              <div class="text-[10px] text-text-muted">关注标签</div>
            </div>
            <div class="text-center">
              <div class="text-lg font-bold text-text-primary"><%= @followed_accounts_count %></div>
              <div class="text-[10px] text-text-muted">关联帐号</div>
            </div>
            <div class="text-center">
              <div class="text-lg font-bold text-text-primary"><%= @followed_articles_today %></div>
              <div class="text-[10px] text-text-muted">今日文章</div>
            </div>
          </div>
          <div class="mt-2.5 flex flex-wrap gap-1">
            <% current_user.followed_tags.each do |tag| %>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium" style="background-color: <%= tag.color %>15; color: <%= tag.color %>">
                <span class="w-1.5 h-1.5 rounded-full" style="background-color: <%= tag.color %>"></span>
                <%= tag.name %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- RSS Feeds -->
      <div class="bg-bg-card border border-border-primary rounded-xl p-5 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
        <h2 class="text-sm font-semibold text-text-primary mb-3 flex items-center gap-2">
          <svg class="w-4 h-4 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z"/>
          </svg>
          RSS 订阅
        </h2>

        <div class="space-y-4">
          <!-- Personal Feed -->
          <% if current_user && current_user.api_keys.active.any? %>
            <div>
              <h3 class="text-xs font-medium text-text-muted uppercase tracking-wider mb-2">个人订阅</h3>
              <p class="text-[10px] text-text-muted mb-1.5">基于你关注的标签过滤文章</p>
              <div class="flex items-center gap-1.5">
                <%= link_to "RSS", user_rss_path(current_user.api_keys.active.first.token),
                    class: "text-xs text-brand hover:text-brand-dark font-semibold transition",
                    target: "_blank",
                    title: user_rss_url(current_user.api_keys.active.first.token) %>
                <%= render 'shared/copy_button', text: user_rss_url(current_user.api_keys.active.first.token) %>
              </div>
            </div>
          <% end %>

          <!-- Article Feeds -->
          <div>
            <h3 class="text-xs font-medium text-text-muted uppercase tracking-wider mb-2">文章订阅</h3>
            <div class="space-y-1.5">
              <% [
                ['今天', 'today'],
                ['昨天', 'yesterday'],
                ['最近7天', '7days'],
                ['最近1月', '1month']
              ].each do |label, period| %>
                <div class="flex items-center justify-between gap-2">
                  <span class="text-sm text-text-secondary"><%= label %></span>
                  <div class="flex items-center gap-1.5">
                    <%= link_to "RSS", all_accounts_rss_path(period: period),
                        class: "text-xs text-brand hover:text-brand-dark font-semibold transition",
                        target: "_blank",
                        title: all_accounts_rss_url(period: period) %>
                    <%= render 'shared/copy_button', text: all_accounts_rss_url(period: period) %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>

          <!-- Account List Feeds -->
          <div class="pt-3 border-t border-border-primary">
            <h3 class="text-xs font-medium text-text-muted uppercase tracking-wider mb-2">帐号列表</h3>
            <div class="space-y-1.5">
              <div class="flex items-center justify-between gap-2">
                <span class="text-sm text-text-secondary">全部帐号</span>
                <div class="flex items-center gap-1.5">
                  <%= link_to "RSS", accounts_list_rss_path,
                      class: "text-xs text-brand hover:text-brand-dark font-semibold transition",
                      target: "_blank",
                      title: accounts_list_rss_url %>
                  <%= render 'shared/copy_button', text: accounts_list_rss_url %>
                </div>
              </div>
              <div class="flex items-center justify-between gap-2">
                <span class="text-sm text-text-secondary">启用的帐号</span>
                <div class="flex items-center gap-1.5">
                  <%= link_to "RSS", active_accounts_list_rss_path,
                      class: "text-xs text-brand hover:text-brand-dark font-semibold transition",
                      target: "_blank",
                      title: active_accounts_list_rss_url %>
                  <%= render 'shared/copy_button', text: active_accounts_list_rss_url %>
                </div>
              </div>
            </div>
          </div>

          <!-- Tag Feeds -->
          <% tags = Tag.ordered %>
          <% if tags.any? %>
            <div class="pt-3 border-t border-border-primary">
              <h3 class="text-xs font-medium text-text-muted uppercase tracking-wider mb-2">标签订阅</h3>
              <div class="space-y-1.5">
                <% tags.each do |tag| %>
                  <div class="flex items-center justify-between gap-2">
                    <span class="flex items-center gap-1.5 text-sm text-text-secondary">
                      <span class="w-2 h-2 rounded-full flex-shrink-0" style="background-color: <%= tag.color %>"></span>
                      <%= tag.name %>
                    </span>
                    <div class="flex items-center gap-1.5">
                      <%= link_to "RSS", tag_rss_path(tag),
                          class: "text-xs text-brand hover:text-brand-dark font-semibold transition",
                          target: "_blank",
                          title: tag_rss_url(tag) %>
                      <%= render 'shared/copy_button', text: tag_rss_url(tag) %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="lg:col-span-8 space-y-6">
      <!-- Recent Crawl Tasks -->
      <div>
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-lg font-bold text-text-primary flex items-center gap-2">
            <svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
            最近的抓取任务
          </h2>
          <%= link_to crawl_tasks_path, class: "text-brand hover:text-brand-dark text-sm font-semibold transition" do %>
            查看全部 →
          <% end %>
        </div>

        <%= render 'crawl_tasks/tasks_table', tasks: @recent_tasks %>
      </div>

      <!-- Recent Articles -->
      <% if @recent_articles.any? %>
        <div>
          <h2 class="text-lg font-bold text-text-primary flex items-center gap-2 mb-3">
            <svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
            </svg>
            最近文章
            <% if current_user&.followed_tags&.any? %>
              <span class="text-xs font-normal text-text-secondary">（已按关注标签过滤）</span>
            <% end %>
          </h2>

          <div class="bg-bg-card border border-border-primary rounded-2xl overflow-hidden shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
            <div class="divide-y divide-border-primary">
              <% @recent_articles.each do |article| %>
                <div class="px-5 py-3 hover:bg-bg-secondary transition">
                  <div class="flex items-start justify-between gap-3">
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-2 mb-0.5">
                        <span class="text-xs text-text-muted"><%= article.account.nickname %></span>
                        <% article.account.tags.each do |tag| %>
                          <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded text-[10px] font-medium" style="background-color: <%= tag.color %>20; color: <%= tag.color %>">
                            <span class="w-1 h-1 rounded-full" style="background-color: <%= tag.color %>"></span>
                            <%= tag.name %>
                          </span>
                        <% end %>
                      </div>
                      <%= link_to article.title.presence || "无标题", article.url, target: "_blank", class: "text-sm font-medium text-text-primary hover:text-brand transition line-clamp-1" %>
                      <% if article.best_digest.present? %>
                        <p class="text-xs text-text-secondary mt-0.5 line-clamp-1"><%= truncate(article.best_digest, length: 150) %></p>
                      <% end %>
                    </div>
                    <div class="text-xs text-text-muted whitespace-nowrap flex-shrink-0">
                      <% if article.published_at %>
                        <%= article.published_at.strftime("%m-%d %H:%M") %>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
