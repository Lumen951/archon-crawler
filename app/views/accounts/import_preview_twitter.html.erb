<div class="space-y-6">
  <div class="flex items-center justify-between gap-4 flex-wrap">
    <div>
      <h1 class="text-2xl font-bold text-text-primary">Twitter 搜索结果</h1>
      <p class="text-text-secondary mt-1">共找到 <span class="font-semibold text-text-primary"><%= @search_results.size %></span> 个帐号，请勾选要导入的</p>
    </div>
    <%= link_to "← 返回导入页", import_twitter_page_accounts_path, class: "btn btn-secondary" %>
  </div>

  <div class="card">
    <%= form_with url: import_twitter_accounts_path, method: :post, local: true, id: "twitter-preview-form" do %>
      <div class="flex items-center justify-between gap-3 mb-4">
        <div class="text-sm text-text-secondary">选择要导入的 Twitter 帐号</div>
        <label class="inline-flex items-center gap-2 text-sm text-text-primary select-none">
          <input type="checkbox" id="select-all-twitter" class="rounded border-border-primary text-primary focus:ring-primary">
          全选
        </label>
      </div>

      <div class="overflow-x-auto border border-border-primary rounded-lg">
        <table class="min-w-full divide-y divide-border-primary">
          <thead class="bg-bg-secondary">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">选择</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">帐号</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">User ID</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">粉丝数</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">推文数</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border-primary bg-bg-card">
            <% @search_results.each_with_index do |user, idx| %>
              <% rest_id = user["rest_id"] || user[:rest_id] %>
              <% screen_name = user["screen_name"] || user[:screen_name] %>
              <% name = user["name"] || user[:name] %>
              <% image = user["profile_image_url_https"] || user[:image] %>
              <% followers = user["followers_count"] || user[:followers_count] || 0 %>
              <% tweets_count = user["statuses_count"] || user[:statuses_count] || 0 %>
              <tr class="hover:bg-bg-secondary transition">
                <td class="px-4 py-3 align-top">
                  <input type="checkbox"
                         name="selected_user_ids[]"
                         value="<%= rest_id %>"
                         id="selected-twitter-<%= idx %>"
                         class="twitter-checkbox rounded border-border-primary text-primary focus:ring-primary"
                         checked>
                </td>
                <td class="px-4 py-3">
                  <label for="selected-twitter-<%= idx %>" class="cursor-pointer flex items-center gap-3">
                    <% if image.present? %>
                      <img src="<%= image %>" alt="<%= screen_name %>" class="h-10 w-10 rounded-full flex-shrink-0">
                    <% else %>
                      <div class="h-10 w-10 rounded-full bg-sky-100 flex-shrink-0 flex items-center justify-center text-sky-500">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                      </div>
                    <% end %>
                    <div>
                      <span class="font-medium text-text-primary"><%= name %></span>
                      <span class="text-sm text-text-secondary ml-1">@<%= screen_name %></span>
                    </div>
                  </label>
                </td>
                <td class="px-4 py-3 text-sm text-text-secondary font-mono"><%= rest_id %></td>
                <td class="px-4 py-3 text-sm text-text-primary"><%= number_with_delimiter(followers) %></td>
                <td class="px-4 py-3 text-sm text-text-primary"><%= number_with_delimiter(tweets_count) %></td>
              </tr>

              <%= hidden_field_tag "accounts_data[#{rest_id}][screen_name]", screen_name %>
              <%= hidden_field_tag "accounts_data[#{rest_id}][name]", name %>
              <%= hidden_field_tag "accounts_data[#{rest_id}][image]", image %>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="mt-5 flex justify-end gap-2">
        <%= link_to "重新搜索", import_twitter_page_accounts_path, class: "btn btn-secondary" %>
        <button type="submit" class="btn btn-primary">导入选中帐号</button>
      </div>
    <% end %>
  </div>
</div>

<script>
const selectAllTwitter = document.getElementById('select-all-twitter');
const twitterCheckboxes = document.querySelectorAll('.twitter-checkbox');

if (selectAllTwitter) {
  selectAllTwitter.addEventListener('change', (e) => {
    twitterCheckboxes.forEach((checkbox) => {
      checkbox.checked = e.target.checked;
    });
  });

  twitterCheckboxes.forEach((checkbox) => {
    checkbox.addEventListener('change', () => {
      const allChecked = Array.from(twitterCheckboxes).every((item) => item.checked);
      selectAllTwitter.checked = allChecked;
    });
  });

  const allCheckedOnLoad = Array.from(twitterCheckboxes).every((item) => item.checked);
  selectAllTwitter.checked = allCheckedOnLoad;
}
</script>
