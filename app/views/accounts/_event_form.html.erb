<%# 活动研究账号共用表单：form_url / form_method / submit_label 由调用方传入 %>
<%= form_with url: form_url, method: form_method, scope: :event_account, local: true do |f| %>
  <div class="space-y-4">
    <div>
      <label class="block text-sm font-medium text-text-primary mb-2">活动名称 <span class="text-red-500">*</span></label>
      <%= f.text_field :name, value: @account.nickname, required: true,
            placeholder: "例如：科创中国创新创业投资大会",
            class: "w-full px-4 py-3 border border-border-primary rounded-lg text-sm focus:ring-2 focus:ring-primary focus:border-transparent" %>
      <p class="mt-2 text-sm text-text-secondary">调研的检索主体，会按它生成获奖名单、获奖项目等固定搜索词。</p>
    </div>

    <div>
      <label class="block text-sm font-medium text-text-primary mb-2">指定页面（可选）</label>
      <%= f.url_field :url, value: @account.event_url,
            placeholder: "https://... 官网、获奖公示页等",
            class: "w-full px-4 py-3 border border-border-primary rounded-lg text-sm focus:ring-2 focus:ring-primary focus:border-transparent" %>
      <p class="mt-2 text-sm text-text-secondary">填写后这页会最先被抓取并排进分析材料最前面。</p>
    </div>

    <div>
      <label class="block text-sm font-medium text-text-primary mb-2">搜索关键词（可选，每行一个）</label>
      <%= f.text_area :keywords, value: @account.keywords.join("\n"), rows: 4,
            placeholder: "例如：\n获奖名单\n决赛\n路演",
            class: "w-full px-4 py-3 border border-border-primary rounded-lg text-sm focus:ring-2 focus:ring-primary focus:border-transparent" %>
      <p class="mt-2 text-sm text-text-secondary">在固定搜索词之外追加的搜索组合（「活动名 + 关键词」）。</p>
    </div>

    <div>
      <label class="block text-sm font-medium text-text-primary mb-2">研究目的（可选）</label>
      <%= f.text_area :purpose, value: @account.purpose, rows: 3,
            placeholder: "例如：找出获奖项目的创始人联系方式，用于投资尽调",
            class: "w-full px-4 py-3 border border-border-primary rounded-lg text-sm focus:ring-2 focus:ring-primary focus:border-transparent" %>
      <p class="mt-2 text-sm text-text-secondary">会注入抽取提示词，让调研围绕这些关注点组织。</p>
    </div>

    <div>
      <label class="block text-sm font-medium text-text-primary mb-2">其它背景信息（可选）</label>
      <%= f.text_area :other_information, value: @account.other_information, rows: 3,
            placeholder: "同名活动、往届届次、主办方口径等需要消歧的信息",
            class: "w-full px-4 py-3 border border-border-primary rounded-lg text-sm focus:ring-2 focus:ring-primary focus:border-transparent" %>
    </div>

    <div class="flex justify-end">
      <button type="submit" class="btn btn-primary"><%= submit_label %></button>
    </div>
  </div>
<% end %>
