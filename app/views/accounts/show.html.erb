<div class="space-y-8">
  <div>
    <div class="mb-4">
      <%= link_to accounts_path, class: "inline-flex items-center gap-2 text-text-secondary hover:text-brand transition" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        返回帐号列表
      <% end %>
    </div>

    <div class="flex flex-col sm:flex-row items-start gap-6">
      <% if @account.round_head_img.present? %>
        <img src="<%= @account.round_head_img %>" alt="<%= @account.nickname %>" class="w-20 h-20 sm:w-24 sm:h-24 rounded-full flex-shrink-0">
      <% end %>

      <div class="flex-1 min-w-0">
        <div class="flex flex-wrap items-center gap-3 mb-3">
          <div id="<%= dom_id(@account, :name) %>"
               data-controller="inline-edit"
               data-inline-edit-url-value="<%= account_path(@account, format: :json) %>"
               class="flex items-center gap-2 group">
            <h1 data-inline-edit-target="display"
                data-action="click->inline-edit#edit"
                class="text-2xl sm:text-3xl font-bold text-text-primary cursor-pointer hover:opacity-80 transition-opacity">
              <%= @account.nickname %>
            </h1>
            <span data-edit-icon class="text-text-secondary opacity-0 group-hover:opacity-100 transition-opacity">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
              </svg>
            </span>
            <div data-inline-edit-target="input" class="hidden"></div>
          </div>
          <%= render 'shared/status_badge', status: @account.status %>
        </div>
        <div class="space-y-2">
          <p class="text-text-secondary text-sm">
            Fakeid: <code class="bg-bg-secondary px-2 py-1 rounded text-xs text-brand font-mono"><%= @account.fakeid %></code>
          </p>
          <% if @account.website? %>
            <p class="text-text-secondary text-sm">
              网址: <%= link_to @account.url, @account.url, target: "_blank", rel: "noopener noreferrer", class: "text-brand hover:text-brand-dark transition" %>
            </p>
          <% end %>
          <div class="flex items-center gap-2 text-sm">
            <span class="text-text-secondary">RSS Feed:</span>
            <%= link_to "订阅链接", account_rss_url(@account.fakeid), class: "text-brand hover:text-brand-dark font-semibold transition", target: "_blank" %>
            <%= render 'shared/copy_button', text: account_rss_url(@account.fakeid) %>
          </div>
        </div>

        <div class="mt-5 flex flex-wrap items-center gap-2">
          <%= button_to crawl_account_path(@account), method: :post, class: "h-9 px-4 rounded-lg bg-brand text-white hover:bg-brand-dark text-sm font-semibold transition" do %>
            立即抓取
          <% end %>
          <% if @account.website? %>
            <%= button_to rediscover_account_path(@account), method: :post,
                  form: { data: { turbo_confirm: "重新发现会清空该网站的监控页面、版本和变更历史，然后重新抓取。确定继续？" } },
                  class: "h-9 px-4 rounded-lg border border-border-primary bg-bg-card hover:border-brand hover:text-brand text-sm font-semibold transition" do %>
              重新发现
            <% end %>
          <% end %>
          <%= button_to toggle_status_account_path(@account), method: :post, class: "h-9 px-4 rounded-lg border border-border-primary bg-bg-card hover:border-brand hover:text-brand text-sm font-semibold transition" do %>
            <%= @account.active? ? "停用" : "启用" %>
          <% end %>
          <%= button_to account_path(@account), method: :delete,
                form: { data: { turbo_confirm: "确定要删除该帐号及其文章数据吗？" } },
                class: "h-9 px-4 rounded-lg border border-red-200 text-red-600 hover:bg-red-50 text-sm font-semibold transition" do %>
            删除帐号
          <% end %>
        </div>

        <!-- Tags -->
        <div class="mt-4" data-controller="dropdown">
          <div class="flex flex-wrap items-center gap-2">
            <% @account.tags.each do |tag| %>
              <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-sm font-medium" style="background-color: <%= tag.color %>20; color: <%= tag.color %>">
                <span class="w-2.5 h-2.5 rounded-full" style="background-color: <%= tag.color %>"></span>
                <%= tag.name %>
              </span>
            <% end %>
            <button data-action="click->dropdown#toggle" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-sm font-medium bg-bg-secondary text-text-secondary hover:bg-brand hover:text-white transition">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
              管理标签
            </button>
          </div>
          <div data-dropdown-target="panel" class="hidden mt-2 p-4 bg-bg-card border border-border-primary rounded-xl shadow-lg max-w-md">
            <!-- Current tags with remove -->
            <% if @account.tags.any? %>
              <div class="mb-3">
                <p class="text-xs text-text-secondary mb-2">当前标签：</p>
                <div class="flex flex-wrap gap-1">
                  <% @account.tags.each do |tag| %>
                    <%= form_with url: bulk_untag_accounts_path, method: :post, class: "inline-flex" do |f| %>
                      <%= hidden_field_tag "account_ids[]", @account.id %>
                      <%= hidden_field_tag "tag_ids[]", tag.id %>
                      <button type="submit" class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium hover:opacity-70 transition" style="background-color: <%= tag.color %>20; color: <%= tag.color %>" title="点击移除">
                        <span class="w-2 h-2 rounded-full" style="background-color: <%= tag.color %>"></span>
                        <%= tag.name %>
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                      </button>
                    <% end %>
                  <% end %>
                </div>
              </div>
            <% end %>
            <!-- Add tag form -->
            <%= form_with url: bulk_tag_accounts_path, method: :post, data: { controller: "tag-input" } do |f| %>
              <%= hidden_field_tag "account_ids[]", @account.id %>
              <div class="flex gap-2">
                <div class="flex-1 relative">
                  <input type="text" data-tag-input-target="input" data-action="input->tag-input#onInput keydown->tag-input#onKeydown"
                    placeholder="输入标签名称..."
                    class="w-full h-9 px-3 rounded-lg border border-border-primary bg-bg-secondary text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-brand/30">
                  <div data-tag-input-target="dropdown"
                       class="hidden absolute top-full left-0 right-0 mt-1 bg-bg-card border border-border-primary rounded-xl shadow-lg max-h-48 overflow-y-auto z-50">
                  </div>
                  <div data-tag-input-target="chips" class="hidden"></div>
                  <div data-tag-input-target="hiddenFields"></div>
                </div>
                <button type="submit" class="h-9 px-4 rounded-lg bg-brand text-white hover:bg-brand-dark text-sm font-semibold transition">
                  添加
                </button>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
    <div class="bg-bg-card border border-border-primary rounded-xl p-5 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
      <div class="text-sm font-medium text-text-secondary">活跃度</div>
      <div class="mt-2">
        <% score = @account.activity_score.to_i %>
        <% status = @account.activity_level %>
        <span class="inline-flex items-center justify-center px-2 py-0.5 rounded-full text-xs font-semibold min-w-[36px]
          <%= case status
              when :active  then 'bg-green-100 text-green-700'
              when :slow    then 'bg-yellow-100 text-yellow-700'
              when :dormant then 'bg-orange-100 text-orange-700'
              when :dead    then 'bg-red-100 text-red-600'
              when :uncrawled then 'bg-gray-100 text-gray-400'
              else 'bg-gray-100 text-gray-500'
              end %>">
          <%= { active: '🟢', slow: '🟡', dormant: '🟠', dead: '🔴', never: '⚪', uncrawled: '🌫️' }[status] %>&nbsp;<%= score %>
        </span>
        <span class="ml-1 text-xs text-text-muted"><%= { active: '活跃', slow: '减速', dormant: '停更', dead: '失活', never: '无文章', uncrawled: '从未抓取' }[status] %></span>
      </div>
    </div>

    <div class="bg-bg-card border border-border-primary rounded-xl p-5 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
      <div class="text-sm font-medium text-text-secondary">文章总数</div>
      <div class="mt-2 text-3xl font-bold text-text-primary"><%= @account.total_articles %></div>
    </div>

    <div class="bg-bg-card border border-border-primary rounded-xl p-5 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
      <div class="text-sm font-medium text-text-secondary">7 天发布</div>
      <div class="mt-2 text-3xl font-bold <%= @account.articles_last_7_days > 0 ? 'text-green-600' : 'text-text-muted' %>"><%= @account.articles_last_7_days %></div>
    </div>

    <div class="bg-bg-card border border-border-primary rounded-xl p-5 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
      <div class="text-sm font-medium text-text-secondary">30 天发布</div>
      <div class="mt-2 text-3xl font-bold <%= @account.articles_last_30_days > 0 ? 'text-text-primary' : 'text-text-muted' %>"><%= @account.articles_last_30_days %></div>
    </div>

    <div class="bg-bg-card border border-border-primary rounded-xl p-5 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
      <div class="text-sm font-medium text-text-secondary">最近发布</div>
      <div class="mt-2 text-lg font-semibold text-text-primary">
        <% if @account.last_published_at %>
          <%= time_ago_in_words(@account.last_published_at) %>前
        <% elsif @account.last_crawled_at.nil? %>
          <span class="text-text-muted">从未抓取</span>
        <% else %>
          <span class="text-red-500">从未发布</span>
        <% end %>
      </div>
    </div>

    <div class="bg-bg-card border border-border-primary rounded-xl p-5 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
      <div class="text-sm font-medium text-text-secondary">最后抓取</div>
      <div class="mt-2 text-lg font-semibold text-text-primary">
        <%= @account.last_crawled_at ? time_ago_in_words(@account.last_crawled_at) + '前' : '从未抓取' %>
      </div>
    </div>

    <div class="bg-bg-card border border-border-primary rounded-xl p-5 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
      <div class="text-sm font-medium text-text-secondary">下次抓取</div>
      <div class="mt-2 text-lg font-semibold text-text-primary">
        <% if @account.next_crawl_at && @account.next_crawl_at > Time.current %>
          <%= distance_of_time_in_words(Time.current, @account.next_crawl_at) %>后
        <% else %>
          <span class="text-brand">待抓取</span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- WeRead mpId Section (WechatAccount only) -->
  <% if @account.wechat? %>
    <div class="bg-bg-card border border-border-primary rounded-xl p-6 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
      <h3 class="text-lg font-semibold text-text-primary mb-3">WeRead 配置</h3>
      <div class="mb-3">
        <span class="text-sm text-text-secondary">当前 mpId：</span>
        <% mp_id = @account.metadata&.dig("weread_mp_id") %>
        <% if mp_id.present? %>
          <code class="bg-bg-secondary px-2 py-1 rounded text-xs text-brand font-mono"><%= mp_id %></code>
          <% if mp_id.match?(/\AMP_WXS_/) %>
            <span class="text-xs text-green-600 ml-1">✓ 有效</span>
          <% else %>
            <span class="text-xs text-yellow-600 ml-1">⚠ 格式可能不正确（期望 MP_WXS_xxx）</span>
          <% end %>
        <% else %>
          <span class="text-xs text-yellow-600">未设置（将尝试通过文章URL自动解析）</span>
        <% end %>
      </div>

      <div class="border-t border-border-primary pt-3">
        <p class="text-sm text-text-secondary mb-2">通过微信公众号文章链接手动更新 mpId：</p>
        <%= form_with url: resolve_weread_mp_id_account_path(@account), method: :post, class: "flex gap-2" do |f| %>
          <%= text_field_tag :article_url, nil, placeholder: "https://mp.weixin.qq.com/s/...",
              class: "flex-1 h-9 px-3 rounded-lg border border-border-primary bg-bg-secondary text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-brand/30" %>
          <button type="submit" class="h-9 px-4 rounded-lg bg-brand text-white hover:bg-brand-dark text-sm font-semibold transition whitespace-nowrap">
            解析并更新
          </button>
        <% end %>
        <p class="text-xs text-text-muted mt-1">粘贴该公众号任意一篇文章的链接，系统将自动解析并更新 WeRead mpId</p>
      </div>
    </div>
  <% end %>

  <!-- Website Monitor Section (WebsiteAccount only) -->
  <% if @account.website? %>
    <section class="bg-bg-card border border-border-primary rounded-xl p-6 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <h3 class="text-lg font-semibold text-text-primary">抓取规则</h3>
        <div class="flex items-center gap-2">
          <span class="text-xs text-text-muted font-mono"><%= @account.crawl_mode %></span>
        </div>
      </div>
      <% if @account.listing_rule_unconfigured? %>
        <p class="mb-4 text-sm text-amber-700">Listing 抓取规则尚未生成；在规则完整前执行抓取会失败。</p>
      <% end %>
      <%= form_with url: update_crawl_rule_account_path(@account), method: :patch, local: true do %>
        <div class="grid gap-4">
          <div>
            <label class="block text-sm font-medium text-text-secondary mb-1" for="crawl_rule_json">规则 JSON</label>
            <%= text_area_tag :crawl_rule_json, JSON.pretty_generate(@account.crawl_rule.presence || { "mode" => "sitemap" }),
                id: "crawl_rule_json", rows: 14, spellcheck: false,
                class: "w-full px-3 py-2 rounded-lg border border-border-primary bg-bg-secondary text-xs text-text-primary font-mono leading-5 focus:outline-none focus:ring-2 focus:ring-brand/30" %>
          </div>
          <div class="flex flex-wrap items-center justify-between gap-2">
            <button type="submit" class="h-9 px-4 rounded-lg bg-brand text-white hover:bg-brand-dark text-sm font-semibold transition">
              保存规则
            </button>
            <% if @account.crawl_mode == "listing" %>
              <div class="flex items-center gap-2">
                <button type="submit" formaction="<%= generate_crawl_rule_account_path(@account) %>" formmethod="post" class="h-9 px-4 rounded-lg bg-indigo-600 text-white hover:bg-indigo-700 text-sm font-semibold transition">
                  生成规则
                </button>
                <p class="text-sm text-text-muted">生成规则仅适用于 Listing 抓取模式</p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </section>

    <div class="bg-bg-card border border-border-primary rounded-xl p-6 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-text-primary">监控页面</h3>
        <div class="flex items-center gap-3 text-sm">
          <%= link_to "页面 RSS", monitor_website_pages_rss_url(@account.id), target: "_blank", class: "text-brand hover:text-brand-dark transition" %>
          <%= link_to "官网变更 RSS", monitor_website_changes_rss_url(@account.id), target: "_blank", class: "text-brand hover:text-brand-dark transition" %>
          <%= link_to "全部变更", monitor_changes_path(account_id: @account.id), class: "text-brand hover:text-brand-dark transition" %>
        </div>
      </div>

      <% if @account.last_error.present? %>
        <div class="mb-3 text-sm text-red-600 bg-red-50 border border-red-100 rounded-lg px-3 py-2">
          上次检查错误：<%= @account.last_error %>
        </div>
      <% end %>

      <% if @monitor_pages.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full text-sm">
            <thead>
              <tr class="text-left text-xs text-text-secondary uppercase tracking-wider border-b border-border-primary">
                <th class="py-2 pr-4">页面</th>
                <th class="py-2 pr-4">类型</th>
                <th class="py-2 pr-4">版本数</th>
                <th class="py-2 pr-4">最近变化</th>
                <th class="py-2">状态</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border-primary">
              <% @monitor_pages.each do |page| %>
                <tr class="hover:bg-bg-secondary transition">
                  <td class="py-2 pr-4">
                    <%= link_to page.display_title, monitor_page_path(page), class: "text-brand hover:text-brand-dark transition" %>
                  </td>
                  <td class="py-2 pr-4 text-text-secondary"><%= page.type_label %></td>
                  <td class="py-2 pr-4 text-text-secondary"><%= page.versions_count %></td>
                  <td class="py-2 pr-4 text-text-secondary whitespace-nowrap">
                    <%= page.last_changed_at ? time_ago_in_words(page.last_changed_at) + '前' : '—' %>
                  </td>
                  <td class="py-2">
                    <% if page.last_error.present? %>
                      <span class="text-red-600" title="<%= page.last_error %>">异常</span>
                    <% elsif page.baseline_ready? %>
                      <span class="text-green-600">正常</span>
                    <% else %>
                      <span class="text-text-muted">待基线</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-sm text-text-secondary">
          <%= @account.crawl_mode == "listing" ? "列表模式不创建监控页面；抓取结果会显示在最近文章中。" : "尚未发现监控页面 — 点击「立即抓取」，系统会自动发现博客、研究、公告等页面并建立基线。" %>
        </p>
      <% end %>
    </div>

    <% if @monitor_changes.any? %>
      <div class="bg-bg-card border border-border-primary rounded-xl p-6 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-lg font-semibold text-text-primary">最近变更</h3>
          <%= link_to "查看全部", monitor_changes_path(account_id: @account.id), class: "text-sm text-brand hover:text-brand-dark transition" %>
        </div>
        <ul class="divide-y divide-border-primary">
          <% @monitor_changes.each do |change| %>
            <li class="py-2.5 flex items-start gap-3">
              <%= render 'shared/importance_badge', importance: change.importance %>
              <div class="flex-1 min-w-0">
                <%= link_to change.summary.to_s.truncate(120), monitor_change_path(change), class: "text-sm text-text-primary hover:text-brand transition" %>
                <p class="text-xs text-text-muted mt-0.5">
                  <%= change.monitor_page&.type_label %> · <%= time_ago_in_words(change.created_at) %>前
                </p>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% end %>

  <!-- Recent Articles -->
  <div>
    <h2 class="text-xl font-bold text-text-primary mb-4 flex items-center gap-2">
      <svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
      </svg>
      最近文章
    </h2>

    <!-- Keyword Search -->
    <%= form_with url: account_path(@account), method: :get, local: true, class: "mb-4" do %>
      <div class="flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
          <svg class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <%= text_field_tag :keyword, params[:keyword],
                placeholder: "搜索该账号的文章标题、摘要或正文…",
                class: "w-full h-11 pl-10 pr-4 rounded-xl border border-border-primary bg-bg-secondary text-text-primary placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent transition" %>
        </div>
        <button type="submit"
                class="h-11 px-5 rounded-xl bg-brand text-white hover:bg-brand-dark font-semibold text-sm transition inline-flex items-center justify-center gap-2 shadow-[0_7px_16px_rgba(59,130,246,.14)]">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          搜索
        </button>
      </div>
    <% end %>

    <% if @articles.any? %>
      <!-- Desktop Table -->
      <div class="hidden md:block bg-bg-card border border-border-primary rounded-2xl overflow-hidden shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
        <table class="min-w-full divide-y divide-border-primary">
          <thead class="bg-bg-secondary">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">标题</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">作者</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">发布时间</th>
            </tr>
          </thead>
          <tbody class="bg-bg-card divide-y divide-border-primary">
            <% @articles.each do |article| %>
              <tr class="hover:bg-bg-secondary transition">
                <td class="px-6 py-4">
                  <div class="flex items-center gap-2">
                    <%= link_to article.title, article_path(article), target: "_blank", rel: "noopener noreferrer", class: "text-brand hover:text-brand-dark font-medium transition" %>
                    <%= link_to article.url, target: "_blank", rel: "noopener noreferrer", class: "text-text-muted hover:text-brand transition", title: "查看原文" do %>
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                      </svg>
                    <% end %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-text-secondary">
                  <%= article.author %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-text-secondary">
                  <%= article.published_at&.strftime('%Y-%m-%d') %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Mobile Cards -->
      <div class="md:hidden space-y-3">
        <% @articles.each do |article| %>
          <div class="bg-bg-card border border-border-primary rounded-xl p-4 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
            <div class="flex items-start justify-between gap-2">
              <%= link_to article_path(article), target: "_blank", rel: "noopener noreferrer", class: "block flex-1" do %>
                <h3 class="font-semibold text-text-primary mb-2 line-clamp-2"><%= article.title %></h3>
              <% end %>
              <%= link_to article.url, target: "_blank", rel: "noopener noreferrer", class: "text-text-muted hover:text-brand transition flex-shrink-0 mt-1", title: "查看原文" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              <% end %>
            </div>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-text-secondary">
              <span class="inline-flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                <%= article.author %>
              </span>
              <span class="inline-flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                <%= article.published_at&.strftime('%Y-%m-%d') %>
              </span>
            </div>
          </div>
        <% end %>
      </div>

      <% if @articles.respond_to?(:total_pages) && @articles.total_pages > 1 %>
        <div class="mt-6">
          <%= paginate @articles %>
        </div>
      <% end %>
    <% else %>
      <div class="bg-bg-card border border-border-primary rounded-2xl text-center py-12 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
        <svg class="w-16 h-16 mx-auto text-text-muted mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        <p class="text-text-secondary">暂无文章</p>
        <p class="text-text-muted text-sm mt-1">开始抓取以获取文章</p>
      </div>
    <% end %>
  </div>
</div>
