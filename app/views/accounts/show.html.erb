<div class="space-y-8">
  <div>
    <div class="mb-4">
      <%= link_to accounts_path, class: "inline-flex items-center gap-2 text-text-secondary hover:text-brand transition" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        返回公众号列表
      <% end %>
    </div>

    <div class="flex flex-col sm:flex-row items-start gap-6">
      <% if @account.round_head_img.present? %>
        <img src="<%= @account.round_head_img %>" alt="<%= @account.nickname %>" class="w-20 h-20 sm:w-24 sm:h-24 rounded-full flex-shrink-0">
      <% end %>

      <div class="flex-1 min-w-0">
        <div class="flex flex-wrap items-center gap-3 mb-3">
          <h1 class="text-2xl sm:text-3xl font-bold text-text-primary"><%= @account.nickname %></h1>
          <%= render 'shared/status_badge', status: @account.status %>
        </div>
        <div class="space-y-2">
          <p class="text-text-secondary text-sm">
            Fakeid: <code class="bg-bg-secondary px-2 py-1 rounded text-xs text-brand font-mono"><%= @account.fakeid %></code>
          </p>
          <div class="flex items-center gap-2 text-sm">
            <span class="text-text-secondary">RSS Feed:</span>
            <%= link_to "订阅链接", account_rss_url(@account.fakeid), class: "text-brand hover:text-brand-dark font-semibold transition", target: "_blank" %>
            <%= render 'shared/copy_button', text: account_rss_url(@account.fakeid) %>
          </div>
        </div>

        <div class="mt-5 flex flex-wrap items-center gap-2">
          <%= button_to crawl_account_path(@account), method: :post, class: "h-9 px-4 rounded-lg bg-brand text-white hover:bg-brand-dark text-sm font-semibold transition" do %>
            立即抓取
          <% end %>
          <%= button_to toggle_status_account_path(@account), method: :post, class: "h-9 px-4 rounded-lg border border-border-primary bg-bg-card hover:border-brand hover:text-brand text-sm font-semibold transition" do %>
            <%= @account.active? ? "停用" : "启用" %>
          <% end %>
          <%= button_to account_path(@account), method: :delete,
                form: { data: { turbo_confirm: "确定要删除该公众号及其文章数据吗？" } },
                class: "h-9 px-4 rounded-lg border border-red-200 text-red-600 hover:bg-red-50 text-sm font-semibold transition" do %>
            删除公众号
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="bg-bg-card border border-border-primary rounded-xl p-6 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
      <div class="text-sm font-medium text-text-secondary">文章总数</div>
      <div class="mt-2 text-3xl font-bold text-text-primary"><%= @account.articles.count %></div>
    </div>

    <div class="bg-bg-card border border-border-primary rounded-xl p-6 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
      <div class="text-sm font-medium text-text-secondary">最后抓取</div>
      <div class="mt-2 text-lg font-semibold text-text-primary">
        <%= @account.last_crawled_at ? time_ago_in_words(@account.last_crawled_at) + '前' : '从未抓取' %>
      </div>
    </div>
  </div>

  <!-- Recent Articles -->
  <div>
    <h2 class="text-xl font-bold text-text-primary mb-4 flex items-center gap-2">
      <svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
      </svg>
      最近文章
    </h2>

    <% if @articles.any? %>
      <!-- Desktop Table -->
      <div class="hidden md:block bg-bg-card border border-border-primary rounded-2xl overflow-hidden shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
        <table class="min-w-full divide-y divide-border-primary">
          <thead class="bg-bg-secondary">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">标题</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">作者</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">发布时间</th>
            </tr>
          </thead>
          <tbody class="bg-bg-card divide-y divide-border-primary">
            <% @articles.each do |article| %>
              <tr class="hover:bg-bg-secondary transition">
                <td class="px-6 py-4">
                  <%= link_to article.title, article.url, target: "_blank", class: "text-brand hover:text-brand-dark font-medium transition" %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-text-secondary">
                  <%= article.author %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-text-secondary">
                  <%= article.published_at&.strftime('%Y-%m-%d') %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Mobile Cards -->
      <div class="md:hidden space-y-3">
        <% @articles.each do |article| %>
          <div class="bg-bg-card border border-border-primary rounded-xl p-4 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
            <%= link_to article.url, target: "_blank", class: "block" do %>
              <h3 class="font-semibold text-text-primary mb-2 line-clamp-2"><%= article.title %></h3>
            <% end %>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-text-secondary">
              <span class="inline-flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                <%= article.author %>
              </span>
              <span class="inline-flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                <%= article.published_at&.strftime('%Y-%m-%d') %>
              </span>
            </div>
          </div>
        <% end %>
      </div>

      <% if @articles.respond_to?(:total_pages) && @articles.total_pages > 1 %>
        <div class="mt-6">
          <%= paginate @articles %>
        </div>
      <% end %>
    <% else %>
      <div class="bg-bg-card border border-border-primary rounded-2xl text-center py-12 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
        <svg class="w-16 h-16 mx-auto text-text-muted mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        <p class="text-text-secondary">暂无文章</p>
        <p class="text-text-muted text-sm mt-1">开始抓取以获取文章</p>
      </div>
    <% end %>
  </div>
</div>
