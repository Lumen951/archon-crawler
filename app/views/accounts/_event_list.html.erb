<%# 活动调研 tab 的列表：不抓文章，关注"是否调研过、调研了几次、是否在每周定期调研中" %>

<!-- 筛选面板：周调研状态 pills + 搜索/状态 -->
<div class="bg-bg-card border border-border-primary rounded-lg p-4" data-turbo-prefetch="false">
  <% weekly_q = params[:q].respond_to?(:to_unsafe_h) ? params[:q].to_unsafe_h.except("with_weekly_research") : (params[:q] || {}).except("with_weekly_research") %>
  <% weekly_disabled_count = @event_tab_count - @weekly_enabled_count %>
  <% active_weekly_filter = params.dig(:q, :with_weekly_research).to_s %>
  <div class="flex flex-wrap gap-2">
    <%# 显式传 with_weekly_research=all（与普通 tab 的 with_tag_id=all 同模式）：
        URL 上有 q 参数，QueryPersistence 才不会把上次的周调研筛选恢复回来 %>
    <%= link_to accounts_path(scope: "event", q: weekly_q.merge(with_weekly_research: "all")),
        class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-medium transition #{active_weekly_filter.blank? || active_weekly_filter == 'all' ? 'bg-brand text-white' : 'bg-bg-secondary text-text-secondary hover:bg-brand hover:text-white'}" do %>
      全部活动
      <span class="text-xs opacity-70"><%= @event_tab_count %></span>
    <% end %>
    <%= link_to accounts_path(scope: "event", q: weekly_q.merge(with_weekly_research: "enabled")),
        class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-medium transition #{active_weekly_filter == 'enabled' ? 'bg-brand text-white' : 'bg-bg-secondary text-text-secondary hover:bg-brand hover:text-white'}" do %>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      周调研已开启
      <span class="text-xs opacity-70"><%= @weekly_enabled_count %></span>
    <% end %>
    <%= link_to accounts_path(scope: "event", q: weekly_q.merge(with_weekly_research: "disabled")),
        class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-medium transition #{active_weekly_filter == 'disabled' ? 'bg-brand text-white' : 'bg-bg-secondary text-text-secondary hover:bg-brand hover:text-white'}" do %>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
      </svg>
      周调研未开启
      <span class="text-xs opacity-70"><%= weekly_disabled_count %></span>
    <% end %>
  </div>

  <div class="mt-3 pt-3 border-t border-border-primary">
    <%# EventAccount 只有 show 路由，必须显式指定表单地址，否则 ransack 会推导出不存在的 event_accounts_path %>
    <%= search_form_for @q, url: accounts_path(scope: "event"), class: "flex flex-col sm:flex-row gap-3" do |f| %>
      <%= hidden_field_tag :scope, "event" %>
      <%= hidden_field_tag "q[with_weekly_research]", active_weekly_filter if active_weekly_filter.present? %>
      <div class="flex-1">
        <%= f.search_field :nickname_cont,
            placeholder: "搜索活动名称...",
            class: "w-full h-9 px-3 rounded-md border border-border-primary bg-bg-card text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-brand/15 focus:border-brand transition" %>
      </div>
      <div class="flex gap-3">
        <%= f.select :status_eq,
            options_for_select([["全部状态", ""], ["已启用", 0], ["已停用", 1]], params.dig(:q, :status_eq)),
            {},
            class: "h-9 px-3 rounded-md border border-border-primary bg-bg-card text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-brand/15 focus:border-brand transition",
            data: { controller: "auto-submit" } %>
        <%= f.submit "搜索", class: "btn btn-primary cursor-pointer" %>
        <% if params[:q].present? %>
          <%= link_to "重置", accounts_path(scope: "event", reset: true), class: "btn btn-default" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<% if @accounts.any? %>
  <!-- Desktop Table -->
  <div class="hidden md:block bg-bg-card border border-border-primary rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-border-primary">
      <thead class="bg-bg-secondary">
        <tr>
          <th class="px-4 py-3 w-10">
            <input type="checkbox" data-bulk-selector-target="selectAll" data-action="change->bulk-selector#toggleAll"
              class="rounded border-border-primary text-brand focus:ring-brand">
          </th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">活动</th>
          <th class="px-3 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider" title="调研总次数、完成次数与最近一轮调研">调研情况</th>
          <th class="px-3 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider" title="开启后每周一 9:00 自动调研并推送">周定期调研</th>
          <th class="px-4 py-3 text-right text-xs font-semibold text-text-secondary uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="bg-bg-card divide-y divide-border-primary">
        <% @accounts.each do |account| %>
          <% stats = @event_run_stats[account.id] %>
          <% last_run = @last_event_runs[account.id] %>
          <tr class="hover:bg-bg-secondary transition">
            <td class="px-4 py-4">
              <input type="checkbox" value="<%= account.id %>" data-bulk-selector-target="checkbox" data-action="change->bulk-selector#toggle"
                class="rounded border-border-primary text-brand focus:ring-brand">
            </td>
            <td class="px-4 py-4">
              <div class="flex items-center">
                <div class="h-10 w-10 rounded-full bg-amber-100 flex items-center justify-center text-lg flex-shrink-0">🎯</div>
                <div class="ml-4 min-w-0">
                  <div class="flex items-center gap-2">
                    <%= link_to account.nickname, event_account_path(account), class: "text-sm font-medium text-text-primary hover:text-primary" %>
                    <%= render 'shared/status_badge', status: account.status %>
                  </div>
                  <% if account.keywords.any? %>
                    <div class="flex flex-wrap gap-1 mt-1">
                      <% account.keywords.first(3).each do |keyword| %>
                        <span class="px-1.5 py-0.5 rounded bg-amber-50 text-amber-700 text-xs"><%= keyword %></span>
                      <% end %>
                      <% if account.keywords.size > 3 %>
                        <span class="text-xs text-text-muted">+<%= account.keywords.size - 3 %></span>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            </td>
            <td class="px-3 py-4 whitespace-nowrap text-sm">
              <% if stats %>
                <div class="font-medium text-text-primary">
                  <%= stats[:total] %> 次调研<span class="text-text-secondary"> · 完成 <%= stats[:completed] %></span>
                </div>
                <% if last_run %>
                  <div class="mt-0.5 flex items-center gap-1.5 text-xs text-text-muted">
                    <span>最近：<%= time_ago_in_words(last_run.created_at) %>前</span>
                    <%= render 'shared/status_badge', status: last_run.status %>
                  </div>
                <% end %>
              <% else %>
                <span class="text-text-muted font-medium">从未调研</span>
              <% end %>
            </td>
            <td class="px-3 py-4 whitespace-nowrap">
              <% if account.weekly_research_active? %>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-700"
                      title="每周一 9:00 自动调研，结果推送到飞书">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  已开启
                </span>
              <% elsif account.weekly_research_enabled? %>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-orange-100 text-orange-700"
                      title="帐号已停用，每周自动调研暂停；在控制台手动调研不受影响">
                  已配置 · 已暂停
                </span>
              <% else %>
                <span class="text-sm text-text-muted">未开启</span>
              <% end %>
            </td>
            <td class="px-4 py-4 whitespace-nowrap text-right text-sm font-medium">
              <div class="flex items-center justify-end gap-2">
                <% if current_user_is_admin? %>
                  <%= button_to start_research_event_account_path(account), method: :post, class: "btn btn-primary btn-sm" do %>
                    开始调研
                  <% end %>
                <% end %>
                <%= button_to toggle_status_account_path(account), method: :post, params: { scope: "event" }, class: "btn btn-default btn-sm" do %>
                  <%= account.active? ? "停用" : "启用" %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <!-- Mobile Cards -->
  <div class="md:hidden space-y-4">
    <% @accounts.each do |account| %>
      <% stats = @event_run_stats[account.id] %>
      <% last_run = @last_event_runs[account.id] %>
      <div class="bg-bg-card border border-border-primary rounded-lg p-4">
        <div class="flex items-start gap-3">
          <input type="checkbox" value="<%= account.id %>" data-bulk-selector-target="checkbox" data-action="change->bulk-selector#toggle"
            class="mt-1 rounded border-border-primary text-brand focus:ring-brand flex-shrink-0">
          <%= link_to event_account_path(account), class: "flex-1 min-w-0" do %>
            <div class="flex items-start gap-3">
              <div class="h-12 w-12 rounded-full bg-amber-100 flex items-center justify-center text-xl flex-shrink-0">🎯</div>
              <div class="flex-1 min-w-0">
                <div class="text-base font-semibold text-text-primary truncate"><%= account.nickname %></div>
                <div class="mt-1"><%= render 'shared/status_badge', status: account.status %></div>
              </div>
            </div>
          <% end %>
        </div>

        <div class="mt-3 space-y-2 text-sm pt-3 border-t border-border-primary">
          <div class="flex justify-between items-center">
            <span class="text-text-secondary">调研情况:</span>
            <% if stats %>
              <span class="text-text-primary font-semibold">
                <%= stats[:total] %> 次 · 完成 <%= stats[:completed] %>
              </span>
            <% else %>
              <span class="text-text-muted">从未调研</span>
            <% end %>
          </div>
          <% if last_run %>
            <div class="flex justify-between items-center">
              <span class="text-text-secondary">最近调研:</span>
              <span class="flex items-center gap-1.5 text-text-primary">
                <%= time_ago_in_words(last_run.created_at) %>前
                <%= render 'shared/status_badge', status: last_run.status %>
              </span>
            </div>
          <% end %>
          <div class="flex justify-between items-center">
            <span class="text-text-secondary">周定期调研:</span>
            <% if account.weekly_research_active? %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-700">已开启</span>
            <% elsif account.weekly_research_enabled? %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-orange-100 text-orange-700">已配置 · 已暂停</span>
            <% else %>
              <span class="text-text-muted">未开启</span>
            <% end %>
          </div>
        </div>

        <div class="mt-4 pt-3 border-t border-border-primary flex gap-2">
          <% if current_user_is_admin? %>
            <%= button_to start_research_event_account_path(account), method: :post, class: "btn btn-primary flex-1" do %>
              开始调研
            <% end %>
          <% end %>
          <%= button_to toggle_status_account_path(account), method: :post, params: { scope: "event" }, class: "btn btn-default flex-1" do %>
            <%= account.active? ? "停用" : "启用" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Pagination -->
  <div class="flex justify-center">
    <%= paginate @accounts %>
  </div>
<% else %>
  <div class="bg-bg-card border border-border-primary rounded-lg text-center py-12">
    <div class="w-16 h-16 mx-auto bg-amber-100 rounded-full flex items-center justify-center text-3xl mb-4">🎯</div>
    <p class="text-text-secondary mb-2">未找到活动</p>
    <% if params[:q].present? %>
      <p class="text-text-muted text-sm mb-4">没有符合筛选条件的活动</p>
      <%= link_to "清除筛选", accounts_path(scope: "event", reset: true), class: "text-brand hover:text-brand-dark font-semibold text-sm transition" %>
    <% else %>
      <p class="text-text-muted text-sm mb-4">创建活动研究账号后，在这里跟踪调研进度</p>
      <% if current_user_is_admin? %>
        <%= link_to import_event_page_accounts_path, class: "btn btn-primary" do %>
          新建活动调研
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
