<div class="space-y-8" data-controller="bulk-selector" data-bulk-selector-total-value="<%= @total_filtered_count %>">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold text-text-primary">帐号管理</h1>
      <p class="text-text-secondary mt-2"><%= @total_filtered_count %> 个帐号</p>
    </div>
    <%= link_to import_accounts_path, class: "h-10 px-5 rounded-xl bg-brand text-white hover:bg-brand-dark font-semibold text-sm transition inline-flex items-center justify-center gap-2 shadow-[0_7px_16px_rgba(59,130,246,.14)]" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
      </svg>
      导入帐号
    <% end %>
  </div>

  <!-- Tag Filter Bar -->
  <% if @tags.any? %>
    <div class="bg-bg-card border border-border-primary rounded-2xl p-4 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
      <div class="flex flex-wrap gap-2">
        <% q_raw = params[:q] || {}; base_q = q_raw.respond_to?(:to_unsafe_h) ? q_raw.to_unsafe_h.except("with_tag_id") : q_raw.except("with_tag_id") %>
        <%= link_to accounts_path(q: base_q.merge(with_tag_id: "all")),
            class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-medium transition #{@active_tag_id.blank? || @active_tag_id == 'all' ? 'bg-brand text-white' : 'bg-bg-secondary text-text-secondary hover:bg-brand hover:text-white'}" do %>
          全部
        <% end %>

        <% @tags.each do |tag| %>
          <% is_active = @active_tag.is_a?(Tag) && @active_tag.id == tag.id %>
          <% tag_q = base_q.merge(with_tag_id: tag.id) %>
          <div class="inline-flex items-center gap-0.5 rounded-full overflow-hidden
            <%= is_active ? 'ring-2 ring-offset-1' : '' %>"
            style="<%= is_active ? "ring-color: #{tag.color}" : "" %>">
            <%= link_to accounts_path(q: tag_q),
                class: "inline-flex items-center gap-1.5 pl-3 pr-2 py-1.5 text-sm font-medium transition rounded-full",
                style: "background-color: #{is_active ? "#{tag.color}30" : "#{tag.color}15"}; color: #{tag.color}" do %>
              <span class="w-2.5 h-2.5 rounded-full flex-shrink-0" style="background-color: <%= tag.color %>"></span>
              <%= tag.name %>
              <span class="text-xs opacity-70"><%= tag.tag_accounts_count %></span>
            <% end %>
            <% if current_user %>
              <button data-controller="tag-follow"
                      data-tag-follow-tag-id-value="<%= tag.id %>"
                      data-tag-follow-followed-value="<%= current_user.followed_tags.exists?(tag.id) %>"
                      data-action="click->tag-follow#toggle"
                      class="pr-2.5 py-1.5 hover:opacity-80 transition"
                      title="<%= current_user.followed_tags.exists?(tag.id) ? '取消关注' : '关注' %>">
                <span data-follow-icon class="text-text-muted hover:text-yellow-500">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                  </svg>
                </span>
              </button>
            <% end %>
          </div>
        <% end %>

        <% none_q = base_q.merge(with_tag_id: "none") %>
        <%= link_to accounts_path(q: none_q),
            class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-medium transition #{@active_tag_id == 'none' ? 'bg-brand text-white' : 'bg-bg-secondary text-text-secondary hover:bg-gray-200 hover:text-gray-700'}" do %>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
          </svg>
          未标签
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Activity Filter Bar -->
  <% activity_levels = [
    ["全部", nil],
    ["本周活跃", "very_active"],
    ["本月活跃", "active"],
    ["发布减速", "slow"],
    ["长期停更 (90d+)", "dormant"],
    ["从未发布", "dead"],
  ] %>
  <div class="bg-bg-card border border-border-primary rounded-2xl p-4 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
    <div class="flex flex-wrap gap-2">
      <% activity_q = (params[:q] || {}).respond_to?(:to_unsafe_h) ? params[:q].to_unsafe_h.except("by_activity_level") : (params[:q] || {}).except("by_activity_level") %>
      <% @active_activity_level ||= params.dig(:q, :by_activity_level).to_s.presence %>
      <% activity_levels.each do |label, level| %>
        <%= link_to label, accounts_path(q: activity_q.merge(by_activity_level: level)),
            class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-medium transition #{@active_activity_level == level.to_s ? 'bg-brand text-white' : 'bg-bg-secondary text-text-secondary hover:bg-brand hover:text-white'}" %>
      <% end %>
    </div>
  </div>

  <!-- Search & Filters -->
  <div class="bg-bg-card border border-border-primary rounded-2xl p-4 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
    <%= search_form_for @q, class: "flex flex-col sm:flex-row gap-3" do |f| %>
      <%= hidden_field_tag "q[with_tag_id]", @active_tag_id if @active_tag_id.present? %>
      <%= hidden_field_tag "q[by_activity_level]", params.dig(:q, :by_activity_level) if params.dig(:q, :by_activity_level).present? %>
      <div class="flex-1">
        <%= f.search_field :nickname_or_fakeid_cont,
            placeholder: "搜索帐号名称或 Fakeid...",
            class: "w-full h-10 px-4 rounded-lg border border-border-primary bg-bg-secondary text-text-primary placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand text-sm transition" %>
      </div>
      <div class="flex gap-3">
        <%= f.select :status_eq,
            options_for_select([["全部状态", ""], ["活跃", 0], ["不维护", 1]], params.dig(:q, :status_eq)),
            {},
            class: "h-10 px-4 rounded-lg border border-border-primary bg-bg-secondary text-text-primary text-sm focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand transition" %>
        <%= f.select :type_eq,
            options_for_select(
              [["全部平台", ""]] + Account.descendants.sort_by(&:name).map { |klass| [klass.new.platform_name, klass.name] },
              params.dig(:q, :type_eq)
            ),
            {},
            class: "h-10 px-4 rounded-lg border border-border-primary bg-bg-secondary text-text-primary text-sm focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand transition" %>
        <%= f.submit "搜索", class: "h-10 px-5 rounded-lg bg-brand text-white hover:bg-brand-dark font-semibold text-sm transition cursor-pointer" %>
        <% if params[:q].present? %>
          <%= link_to "重置", accounts_path(reset: true), class: "h-10 px-5 rounded-lg border border-border-primary bg-bg-card hover:border-brand hover:text-brand font-semibold text-sm transition inline-flex items-center justify-center" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @accounts.any? %>
    <!-- Desktop Table -->
    <div class="hidden md:block bg-bg-card border border-border-primary rounded-2xl overflow-hidden shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
      <table class="min-w-full divide-y divide-border-primary">
        <thead class="bg-bg-secondary">
          <tr>
            <th class="px-4 py-3 w-10">
              <input type="checkbox" data-bulk-selector-target="selectAll" data-action="change->bulk-selector#toggleAll"
                class="rounded border-border-primary text-brand focus:ring-brand">
            </th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">帐号</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">标签</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">状态</th>
            <th class="px-6 py-3 text-center text-xs font-semibold text-text-secondary uppercase tracking-wider cursor-help" title="综合活跃度评分 (0-100)，基于近期发布频率和文章总量计算。绿色≥50 活跃，黄色≥20 较低，橙色>0 停更中，灰色0 无文章">
              <span class="inline-flex items-center gap-1">活跃度<svg class="w-3 h-3 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></span>
            </th>
            <th class="px-6 py-3 text-center text-xs font-semibold text-text-secondary uppercase tracking-wider cursor-help" title="过去 7 天内发布的文章数量">
              <span class="inline-flex items-center gap-1">7天<svg class="w-3 h-3 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></span>
            </th>
            <th class="px-6 py-3 text-center text-xs font-semibold text-text-secondary uppercase tracking-wider cursor-help" title="过去 30 天内发布的文章数量">
              <span class="inline-flex items-center gap-1">30天<svg class="w-3 h-3 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></span>
            </th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">最近发布</th>
            <th class="px-6 py-3 text-center text-xs font-semibold text-text-secondary uppercase tracking-wider">总文章</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">最后抓取</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-text-secondary uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="bg-bg-card divide-y divide-border-primary">
          <% @accounts.each do |account| %>
            <tr class="hover:bg-bg-secondary transition">
              <td class="px-4 py-4">
                <input type="checkbox" value="<%= account.id %>" data-bulk-selector-target="checkbox" data-action="change->bulk-selector#toggle"
                  class="rounded border-border-primary text-brand focus:ring-brand">
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center">
                  <% if account.round_head_img.present? %>
                    <img src="<%= account.round_head_img %>" alt="<%= account.nickname %>" class="h-10 w-10 rounded-full">
                  <% else %>
                    <div class="h-10 w-10 rounded-full bg-gray-200 flex items-center justify-center text-gray-500 text-lg">
                      <%= account.rednote? ? '📕' : '💬' %>
                    </div>
                  <% end %>
                  <div class="ml-4">
                    <div class="flex items-center gap-2">
                      <%= link_to account.nickname, account_path(account), class: "text-sm font-medium text-gray-900 hover:text-primary" %>
                      <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium <%= account.platform_badge_class %>">
                        <%= account.platform_name %>
                      </span>
                    </div>
                    <% if account.wechat? %>
                      <div class="flex items-center space-x-1 mt-0.5">
                        <%= link_to "RSS", account_rss_url(account.fakeid),
                            class: "text-sm text-primary hover:underline",
                            target: "_blank",
                            title: account_rss_url(account.fakeid) %>
                        <%= render 'shared/copy_button', text: account_rss_url(account.fakeid) %>
                      </div>
                    <% end %>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4">
                <div class="flex flex-wrap gap-1">
                  <% account.tags.each do |tag| %>
                    <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-xs font-medium" style="background-color: <%= tag.color %>20; color: <%= tag.color %>">
                      <span class="w-1.5 h-1.5 rounded-full" style="background-color: <%= tag.color %>"></span>
                      <%= tag.name %>
                    </span>
                  <% end %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <%= render 'shared/status_badge', status: account.status %>
              </td>
              <td class="px-2 py-4 whitespace-nowrap text-center" title="综合活跃度评分 (0-100)。基于近期发布频率和文章总量计算。🟢≥50 活跃，🟡≥20 较低，🟠>0 停更中，⚪0 无文章">
                <% score = account.activity_score.to_i %>
                <% status = account.publish_status %>
                <span class="inline-flex items-center justify-center px-2 py-0.5 rounded-full text-xs font-semibold min-w-[36px]
                  <%= case status
                      when :active  then 'bg-green-100 text-green-700'
                      when :slow    then 'bg-yellow-100 text-yellow-700'
                      when :dormant then 'bg-orange-100 text-orange-700'
                      when :dead    then 'bg-red-100 text-red-600'
                      else 'bg-gray-100 text-gray-500'
                      end %>">
                  <%= { active: '🟢', slow: '🟡', dormant: '🟠', dead: '🔴', never: '⚪' }[status] %>&nbsp;<%= score %>
                </span>
              </td>
              <td class="px-2 py-4 whitespace-nowrap text-center text-sm" title="过去 7 天内发布的文章数量">
                <span class="<%= account.articles_last_7_days > 0 ? 'text-green-600 font-semibold' : 'text-text-muted' %>">
                  <%= account.articles_last_7_days %>
                </span>
              </td>
              <td class="px-2 py-4 whitespace-nowrap text-center text-sm" title="过去 30 天内发布的文章数量">
                <span class="<%= account.articles_last_30_days > 0 ? 'text-text-primary' : 'text-text-muted' %>">
                  <%= account.articles_last_30_days %>
                </span>
              </td>
              <td class="px-3 py-4 whitespace-nowrap text-sm">
                <% if account.last_published_at %>
                  <span class="<%= account.last_published_at > 7.days.ago ? 'text-green-600' :
                                   account.last_published_at > 30.days.ago ? 'text-text-primary' :
                                   'text-orange-600' %>">
                    <%= time_ago_in_words(account.last_published_at) %>前
                  </span>
                <% else %>
                  <span class="text-red-500 font-medium">从未发布</span>
                <% end %>
              </td>
              <td class="px-2 py-4 whitespace-nowrap text-center text-sm text-text-primary font-medium">
                <%= account.total_articles %>
              </td>
              <td class="px-3 py-4 whitespace-nowrap text-sm text-text-muted">
                <% if account.last_crawled_at %>
                  <%= time_ago_in_words(account.last_crawled_at) %>前
                <% else %>
                  从未抓取
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <div class="flex items-center justify-end gap-2">
                  <%= button_to crawl_account_path(account), method: :post, class: "h-8 px-3 rounded-lg bg-brand text-white hover:bg-brand-dark text-xs font-semibold transition" do %>
                    立即抓取
                  <% end %>
                  <%= button_to toggle_status_account_path(account), method: :post, class: "h-8 px-3 rounded-lg border border-border-primary bg-bg-card hover:border-brand hover:text-brand text-xs font-semibold transition" do %>
                    <%= account.active? ? "停用" : "启用" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Mobile Cards -->
    <div class="md:hidden space-y-4">
      <% @accounts.each do |account| %>
        <div class="bg-bg-card border border-border-primary rounded-xl p-4 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
          <div class="flex items-start gap-3 mb-3">
            <input type="checkbox" value="<%= account.id %>" data-bulk-selector-target="checkbox" data-action="change->bulk-selector#toggle"
              class="mt-1 rounded border-border-primary text-brand focus:ring-brand flex-shrink-0">
            <div class="flex-1 min-w-0">
              <%= link_to account_path(account), class: "block" do %>
                <div class="flex items-start gap-3">
                  <% if account.round_head_img.present? %>
                    <img src="<%= account.round_head_img %>" alt="<%= account.nickname %>" class="h-12 w-12 rounded-full flex-shrink-0">
                  <% else %>
                    <div class="h-12 w-12 rounded-full bg-gray-200 flex items-center justify-center text-gray-500 text-xl flex-shrink-0">
                      <%= account.rednote? ? '📕' : '💬' %>
                    </div>
                  <% end %>
                  <div class="flex-1 min-w-0">
                    <div class="text-base font-semibold text-text-primary mb-1 truncate">
                      <%= account.nickname %>
                    </div>
                    <div class="mt-1 flex items-center gap-2">
                      <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium <%= account.platform_badge_class %>">
                        <%= account.platform_name %>
                      </span>
                      <%= render 'shared/status_badge', status: account.status %>
                    </div>
                  </div>
                </div>
              <% end %>

              <% if account.tags.any? %>
                <div class="flex flex-wrap gap-1 mt-2">
                  <% account.tags.each do |tag| %>
                    <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-xs font-medium" style="background-color: <%= tag.color %>20; color: <%= tag.color %>">
                      <span class="w-1.5 h-1.5 rounded-full" style="background-color: <%= tag.color %>"></span>
                      <%= tag.name %>
                    </span>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>

          <div class="space-y-2 text-sm pt-3 border-t border-border-primary">
            <% status = account.publish_status %>
            <div class="flex justify-between">
              <span class="text-text-secondary">活跃度:</span>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold
                <%= case status
                    when :active  then 'bg-green-100 text-green-700'
                    when :slow    then 'bg-yellow-100 text-yellow-700'
                    when :dormant then 'bg-orange-100 text-orange-700'
                    when :dead    then 'bg-red-100 text-red-600'
                    else 'bg-gray-100 text-gray-500'
                    end %>">
                <%= { active: '🟢 活跃', slow: '🟡 减速', dormant: '🟠 停更', dead: '🔴 失活', never: '⚪ 无文章' }[status] %>
              </span>
            </div>
            <div class="grid grid-cols-3 gap-2 text-center">
              <div>
                <div class="text-lg font-bold <%= account.articles_last_7_days > 0 ? 'text-green-600' : 'text-text-muted' %>"><%= account.articles_last_7_days %></div>
                <div class="text-[10px] text-text-muted">7天</div>
              </div>
              <div>
                <div class="text-lg font-bold <%= account.articles_last_30_days > 0 ? 'text-text-primary' : 'text-text-muted' %>"><%= account.articles_last_30_days %></div>
                <div class="text-[10px] text-text-muted">30天</div>
              </div>
              <div>
                <div class="text-lg font-bold text-text-primary"><%= account.total_articles %></div>
                <div class="text-[10px] text-text-muted">总文章</div>
              </div>
            </div>
            <div class="flex justify-between">
              <span class="text-text-secondary">最近发布:</span>
              <span class="text-text-primary font-semibold">
                <% if account.last_published_at %>
                  <%= time_ago_in_words(account.last_published_at) %>前
                <% else %>
                  <span class="text-red-500">从未发布</span>
                <% end %>
              </span>
            </div>
            <div class="flex justify-between">
              <span class="text-text-secondary">最后抓取:</span>
              <span class="text-text-primary">
                <% if account.last_crawled_at %>
                  <%= time_ago_in_words(account.last_crawled_at) %>前
                <% else %>
                  从未抓取
                <% end %>
              </span>
            </div>
            <% if account.wechat? %>
            <div class="flex items-center justify-between">
              <span class="text-text-secondary">RSS:</span>
              <div class="flex items-center gap-1">
                <%= link_to "订阅", account_rss_url(account.fakeid),
                    class: "text-xs text-brand hover:underline font-semibold",
                    target: "_blank" %>
                <%= render 'shared/copy_button', text: account_rss_url(account.fakeid) %>
              </div>
            </div>
            <% end %>
          </div>

          <div class="mt-4 pt-3 border-t border-border-primary flex gap-2">
            <%= button_to crawl_account_path(account), method: :post, class: "flex-1 h-9 px-4 rounded-lg bg-brand text-white hover:bg-brand-dark font-semibold text-sm transition inline-flex items-center justify-center gap-1.5" do %>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
              </svg>
              立即抓取
            <% end %>
            <%= button_to toggle_status_account_path(account), method: :post, class: "flex-1 h-9 px-4 rounded-lg border border-border-primary bg-bg-card hover:border-brand hover:text-brand text-text-primary font-semibold text-sm transition inline-flex items-center justify-center" do %>
              <%= account.active? ? "停用" : "启用" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Pagination -->
    <div class="flex justify-center">
      <%= paginate @accounts %>
    </div>
  <% else %>
    <div class="bg-bg-card border border-border-primary rounded-2xl text-center py-12 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
      <svg class="w-16 h-16 mx-auto text-text-muted mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
      </svg>
      <p class="text-text-secondary mb-2">未找到帐号</p>
      <% if params[:q].present? || params[:tag_id].present? %>
        <p class="text-text-muted text-sm mb-4">没有符合筛选条件的帐号</p>
        <%= link_to "清除筛选", accounts_path(reset: true), class: "text-brand hover:text-brand-dark font-semibold text-sm transition" %>
      <% else %>
        <p class="text-text-muted text-sm">使用导入功能添加微信公众号或小红书帐号</p>
      <% end %>
    </div>
  <% end %>

  <!-- Bulk Action Bar (sticky bottom) -->
  <div data-bulk-selector-target="actionBar"
       class="hidden fixed bottom-16 md:bottom-0 left-0 right-0 z-40 bg-bg-card border-t border-border-primary shadow-[0_-4px_20px_rgba(15,23,42,.1)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <!-- Select All Matching Banner -->
      <div data-select-all-banner class="hidden mb-3 p-2 bg-brand-soft rounded-lg flex items-center justify-between">
        <span class="text-sm text-brand font-medium">
          已选择全部 <span data-bulk-selector-target="matchingCount"><%= @total_filtered_count %></span> 个符合条件的帐号
        </span>
        <button data-action="click->bulk-selector#deselectAllMatching" class="text-sm text-brand hover:text-brand-dark font-semibold">
          取消全选
        </button>
      </div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
        <div class="flex items-center gap-2">
          <span class="text-sm text-text-secondary">已选</span>
          <span class="text-sm font-bold text-text-primary" data-bulk-selector-target="count">0</span>
          <span class="text-sm text-text-secondary">个帐号</span>

          <button data-bulk-selector-target="selectMatching"
                  data-action="click->bulk-selector#selectAllMatching"
                  class="hidden text-sm text-brand hover:text-brand-dark font-semibold ml-2">
            选择全部 <%= @total_filtered_count %> 个
          </button>
        </div>

        <div class="flex-1 flex flex-col sm:flex-row items-start sm:items-center gap-3">
          <!-- Add Tags Form -->
          <form data-action="submit->bulk-selector#prepareSubmit"
                action="<%= bulk_tag_accounts_path %>" method="post"
                class="flex items-center gap-2 flex-1">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <div class="flex-1 relative" data-controller="tag-input">
              <div class="flex flex-wrap items-center gap-1 p-1.5 rounded-lg border border-border-primary bg-bg-secondary min-h-[38px]">
                <div data-tag-input-target="chips" class="flex flex-wrap gap-1"></div>
                <input type="text" data-tag-input-target="input" data-action="input->tag-input#onInput keydown->tag-input#onKeydown"
                  placeholder="输入标签名称..."
                  class="flex-1 min-w-[120px] bg-transparent text-sm text-text-primary placeholder:text-text-muted focus:outline-none">
              </div>
              <div data-tag-input-target="dropdown"
                   class="hidden absolute bottom-full left-0 right-0 mb-1 bg-bg-card border border-border-primary rounded-xl shadow-lg max-h-48 overflow-y-auto z-50">
              </div>
              <div data-tag-input-target="hiddenFields"></div>
            </div>
            <button type="submit" class="h-9 px-4 rounded-lg bg-brand text-white hover:bg-brand-dark text-sm font-semibold transition whitespace-nowrap">
              添加标签
            </button>
          </form>

          <!-- Remove Tags Button -->
          <div data-controller="modal">
            <button data-action="click->modal#open"
                    class="h-9 px-4 rounded-lg border border-red-200 bg-red-50 text-red-600 hover:bg-red-100 text-sm font-semibold transition whitespace-nowrap inline-flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
              </svg>
              移除标签
            </button>

            <!-- Modal Dialog -->
            <div data-modal-target="dialog"
                 class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 transition-opacity duration-200 opacity-0">
              <!-- Backdrop -->
              <div data-modal-target="backdrop" data-modal-backdrop
                   class="absolute inset-0 bg-black/50 transition-opacity duration-200 opacity-0"></div>

              <!-- Content -->
              <div class="relative bg-bg-card rounded-2xl shadow-xl max-w-md w-full max-h-[80vh] flex flex-col overflow-hidden border border-border-primary">
                <!-- Header -->
                <div class="flex items-center justify-between px-5 py-4 border-b border-border-primary">
                  <h3 class="text-lg font-semibold text-text-primary">移除标签</h3>
                  <button data-action="click->modal#close" class="text-text-muted hover:text-text-primary transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                  </button>
                </div>

                <!-- Body -->
                <form data-action="submit->bulk-selector#prepareSubmit"
                      action="<%= bulk_untag_accounts_path %>" method="post"
                      class="flex-1 overflow-y-auto p-5">
                  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

                  <p class="text-sm text-text-secondary mb-4">选择要从已选帐号中移除的标签：</p>

                  <!-- Select All -->
                  <div class="flex items-center justify-between mb-3 pb-3 border-b border-border-primary">
                    <label class="flex items-center gap-2 cursor-pointer">
                      <input type="checkbox" data-action="change->modal#toggleAll"
                             class="rounded border-border-primary text-red-500 focus:ring-red-500">
                      <span class="text-sm font-medium text-text-primary">全选</span>
                    </label>
                  </div>

                  <!-- Tag List -->
                  <div class="space-y-2" data-modal-target="tagList">
                    <% @tags.each do |tag| %>
                      <label class="flex items-center gap-3 p-2.5 rounded-lg hover:bg-bg-secondary cursor-pointer transition group">
                        <input type="checkbox" name="tag_ids[]" value="<%= tag.id %>"
                               data-modal-target="tagCheckbox"
                               class="rounded border-border-primary text-red-500 focus:ring-red-500">
                        <span class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: <%= tag.color %>"></span>
                        <span class="flex-1 text-sm text-text-primary font-medium"><%= tag.name %></span>
                        <span class="text-xs text-text-muted"><%= tag.tag_accounts_count %> 个帐号</span>
                      </label>
                    <% end %>
                  </div>

                  <!-- Footer -->
                  <div class="flex items-center justify-end gap-3 mt-5 pt-4 border-t border-border-primary">
                    <button type="button" data-action="click->modal#close"
                            class="h-9 px-4 rounded-lg border border-border-primary bg-bg-card hover:bg-bg-secondary text-sm font-semibold transition">
                      取消
                    </button>
                    <button type="submit"
                            class="h-9 px-4 rounded-lg bg-red-500 text-white hover:bg-red-600 text-sm font-semibold transition inline-flex items-center gap-1.5">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                      </svg>
                      移除选中标签
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>

          <!-- More Actions Dropdown -->
          <div data-controller="modal">
            <div class="relative" data-controller="dropdown">
              <button data-action="click->dropdown#toggle"
                      class="h-9 px-4 rounded-lg border border-border-primary bg-bg-card hover:border-brand hover:text-brand text-sm font-semibold transition whitespace-nowrap inline-flex items-center gap-1.5">
                更多操作
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <div data-dropdown-target="panel"
                   class="hidden absolute bottom-full md:bottom-auto md:top-full left-0 mb-1 md:mb-0 md:mt-1 w-48 bg-bg-card border border-border-primary rounded-xl shadow-lg py-1 z-50">
                <form data-action="submit->bulk-selector#submitAndClose" action="<%= bulk_crawl_accounts_path %>" method="post">
                  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                  <button type="submit" class="w-full px-4 py-2 text-left text-sm text-text-primary hover:bg-bg-secondary transition inline-flex items-center gap-2">
                    <svg class="w-4 h-4 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                    批量抓取
                  </button>
                </form>
                <form data-action="submit->bulk-selector#submitAndClose" action="<%= bulk_enable_accounts_path %>" method="post">
                  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                  <button type="submit" class="w-full px-4 py-2 text-left text-sm text-text-primary hover:bg-bg-secondary transition inline-flex items-center gap-2">
                    <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    批量启用
                  </button>
                </form>
                <form data-action="submit->bulk-selector#submitAndClose" action="<%= bulk_disable_accounts_path %>" method="post">
                  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                  <button type="submit" class="w-full px-4 py-2 text-left text-sm text-text-primary hover:bg-bg-secondary transition inline-flex items-center gap-2">
                    <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    批量停用
                  </button>
                </form>
                <div class="border-t border-border-primary my-1"></div>
                <button data-action="click->dropdown#toggle click->modal#open"
                        class="w-full px-4 py-2 text-left text-sm text-red-500 hover:bg-red-50 transition inline-flex items-center gap-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                  批量删除
                </button>
              </div>
            </div>
            <!-- Delete Confirmation Modal -->
            <div data-modal-target="dialog"
                 class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 transition-opacity duration-200 opacity-0">
              <div data-modal-target="backdrop" data-modal-backdrop
                   class="absolute inset-0 bg-black/50 transition-opacity duration-200 opacity-0"></div>
              <div class="relative bg-bg-card rounded-2xl shadow-xl max-w-md w-full overflow-hidden border border-border-primary">
                <div class="px-5 py-4 border-b border-border-primary">
                  <h3 class="text-lg font-semibold text-text-primary">确认删除</h3>
                </div>
                <div class="p-5">
                  <p class="text-sm text-text-secondary mb-2">确定要删除选中的帐号吗？</p>
                  <p class="text-sm text-red-500 font-medium">此操作不可撤销，将同时删除帐号的所有文章数据。</p>
                </div>
                <div class="flex items-center justify-end gap-3 px-5 py-4 border-t border-border-primary">
                  <button type="button" data-action="click->modal#close"
                          class="h-9 px-4 rounded-lg border border-border-primary bg-bg-card hover:bg-bg-secondary text-sm font-semibold transition">
                    取消
                  </button>
                  <form data-action="submit->bulk-selector#prepareSubmit"
                        action="<%= bulk_destroy_accounts_path %>" method="post" class="inline-flex">
                    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                    <button type="submit" class="h-9 px-4 rounded-lg bg-red-500 text-white hover:bg-red-600 text-sm font-semibold transition">
                      确认删除
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>

          <button data-action="click->bulk-selector#clearAll"
                  class="h-9 px-4 rounded-lg border border-border-primary bg-bg-card hover:border-brand hover:text-brand text-sm font-semibold transition whitespace-nowrap">
            清除选择
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
