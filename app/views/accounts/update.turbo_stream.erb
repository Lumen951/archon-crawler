<%= turbo_stream.replace dom_id(@account, :name) do %>
  <div id="<%= dom_id(@account, :name) %>"
       data-controller="inline-edit"
       data-inline-edit-url-value="<%= account_path(@account, format: :json) %>"
       class="flex items-center gap-2 group">
    <h1 data-inline-edit-target="display"
        data-action="click->inline-edit#edit"
        class="text-2xl sm:text-3xl font-bold text-text-primary cursor-pointer hover:opacity-80 transition-opacity">
      <%= @account.nickname %>
    </h1>
    <span data-edit-icon class="text-text-secondary opacity-0 group-hover:opacity-100 transition-opacity">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
      </svg>
    </span>
    <div data-inline-edit-target="input" class="hidden"></div>
  </div>
<% end %>

<%= turbo_stream.append "toasts" do %>
  <div class="flex items-center gap-3 px-4 py-3 rounded-lg shadow-lg border text-sm transform transition-all duration-300 ease-out translate-y-4 opacity-0 pointer-events-auto bg-green-50 border-green-200 text-green-800"
       data-toast-auto-dismiss="">
    <span class="flex-shrink-0">
      <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
    </span>
    <span class="flex-1">帐号名称已更新</span>
    <button type="button" class="flex-shrink-0 ml-2 opacity-60 hover:opacity-100 transition" onclick="this.parentElement.remove()">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>
<% end %>
