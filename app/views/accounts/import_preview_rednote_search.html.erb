<div class="space-y-6">
  <div class="flex items-center justify-between gap-4 flex-wrap">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">搜索结果预览</h1>
      <p class="text-gray-600 mt-1">关键词：<span class="font-semibold text-gray-900"><%= @keyword %></span></p>
    </div>
    <%= link_to "← 返回导入页", import_rednote_page_accounts_path, class: "btn btn-secondary" %>
  </div>

  <div class="card">
    <%= form_with url: import_rednote_by_id_accounts_path, method: :post, local: true, id: "search-preview-form" do %>
      <div class="flex items-center justify-between gap-3 mb-4">
        <div class="text-sm text-gray-600">共 <span class="font-semibold text-gray-900"><%= @search_results.size %></span> 条结果，请勾选要导入的帐号</div>
        <label class="inline-flex items-center gap-2 text-sm text-gray-700 select-none">
          <input type="checkbox" id="select-all-accounts" class="rounded border-gray-300 text-rose-600 focus:ring-rose-500">
          全选
        </label>
      </div>

      <div class="overflow-x-auto border border-gray-200 rounded-xl">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">选择</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">帐号</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">User ID</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% @search_results.each_with_index do |user, idx| %>
              <% user_id = user[:user_id] || user["user_id"] %>
              <% nickname = user[:nickname] || user["nickname"] %>
              <% avatar = user[:avatar] || user["avatar"] %>
              <tr class="hover:bg-gray-50 transition">
                <td class="px-4 py-3 align-top">
                  <input type="checkbox"
                         name="accounts_data[<%= user_id %>][selected]"
                         value="1"
                         id="selected-user-<%= idx %>"
                         class="account-checkbox rounded border-gray-300 text-rose-600 focus:ring-rose-500"
                         checked>
                </td>
                <td class="px-4 py-3">
                  <label for="selected-user-<%= idx %>" class="cursor-pointer flex items-center gap-3">
                    <% if avatar.present? %>
                      <img src="<%= avatar %>" alt="<%= nickname %>" class="h-10 w-10 rounded-full flex-shrink-0">
                    <% else %>
                      <div class="h-10 w-10 rounded-full bg-gray-100 flex-shrink-0 flex items-center justify-center text-gray-400">
                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                      </div>
                    <% end %>
                    <span class="font-medium text-gray-900"><%= nickname %></span>
                  </label>
                </td>
                <td class="px-4 py-3 text-sm text-gray-600 font-mono"><%= user_id %></td>
              </tr>

              <%= hidden_field_tag "accounts_data[#{user_id}][nickname]", nickname %>
              <%= hidden_field_tag "accounts_data[#{user_id}][image]", avatar %>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="mt-5 flex justify-end gap-2">
        <%= link_to "重新搜索", import_rednote_page_accounts_path, class: "btn btn-secondary" %>
        <button type="submit" class="btn btn-primary">导入选中帐号</button>
      </div>
    <% end %>
  </div>
</div>

<script>
const selectAllAccounts = document.getElementById('select-all-accounts');
const accountCheckboxes = document.querySelectorAll('.account-checkbox');

if (selectAllAccounts) {
  selectAllAccounts.addEventListener('change', (e) => {
    accountCheckboxes.forEach((checkbox) => {
      checkbox.checked = e.target.checked;
    });
  });

  accountCheckboxes.forEach((checkbox) => {
    checkbox.addEventListener('change', () => {
      const allChecked = Array.from(accountCheckboxes).every((item) => item.checked);
      selectAllAccounts.checked = allChecked;
    });
  });

  const allCheckedOnLoad = Array.from(accountCheckboxes).every((item) => item.checked);
  selectAllAccounts.checked = allCheckedOnLoad;
}
</script>
