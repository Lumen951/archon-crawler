<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-text-primary">导入小红书帐号</h1>
      <p class="text-text-secondary mt-1">支持用户 ID、名称搜索和 CSV 文件导入</p>
    </div>
    <%= link_to "← 返回导入页", import_accounts_path, class: "btn btn-secondary" %>
  </div>

  <div class="card">
    <div class="border-b border-border-primary mb-6">
      <nav class="-mb-px flex space-x-8">
        <button type="button" onclick="showTab('search')" id="tab-search" class="tab-button border-b-2 border-rose-500 text-rose-600 py-4 px-1 text-sm font-medium">用户查找</button>
        <button type="button" onclick="showTab('upload')" id="tab-upload" class="tab-button border-b-2 border-transparent text-text-secondary hover:text-text-primary py-4 px-1 text-sm font-medium">上传文件</button>
      </nav>
    </div>

    <%# Search tab %>
    <div id="search-tab" class="tab-content">
      <%= form_with url: import_rednote_search_accounts_path, method: :get, local: true, id: "search-form" do %>
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-text-primary mb-2">用户 ID 或名称</label>
            <input type="text" id="search-input" name="profile_id" placeholder="输入 Profile ID（24位）或用户名称关键词"
                   class="w-full px-4 py-3 border border-border-primary rounded-lg text-sm focus:ring-2 focus:ring-rose-500 focus:border-transparent" required>
            <p class="mt-2 text-sm text-text-secondary">输入用户 ID 精确查找，或输入名称关键词搜索多个匹配帐号。</p>
          </div>
          <div class="flex justify-end">
            <button type="submit" class="btn btn-primary">查找用户</button>
          </div>
        </div>
      <% end %>
    </div>

    <%# File upload tab %>
    <div id="upload-tab" class="tab-content hidden">
      <%= form_with url: import_rednote_file_accounts_path, method: :post, multipart: true do |f| %>
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-text-primary mb-2">上传 CSV 文件</label>
            <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-border-primary border-dashed rounded-lg hover:border-border-strong transition-colors" id="drop-zone">
              <div class="space-y-1 text-center">
                <svg class="mx-auto h-12 w-12 text-text-muted" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                  <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <div class="flex text-sm text-text-secondary">
                  <label for="file-upload" class="relative cursor-pointer bg-bg-card rounded-md font-medium text-rose-600 hover:text-rose-700">
                    <span>上传文件</span>
                    <%= f.file_field :rednote_csv_file, id: "file-upload", accept: ".csv", class: "sr-only", onchange: "updateFileName(this)" %>
                  </label>
                  <p class="pl-1">或拖放文件至此</p>
                </div>
                <p class="text-xs text-text-secondary">支持 .csv 文件</p>
                <p id="file-name" class="text-sm text-text-primary font-medium mt-2"></p>
              </div>
            </div>
          </div>
          <div class="flex justify-end">
            <button type="submit" class="btn btn-primary">从文件导入</button>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card bg-rose-50 border-rose-200">
    <h3 class="font-semibold text-rose-900 mb-3">💡 导入提示</h3>
    <ul class="space-y-1 text-sm text-rose-800">
      <li>• <strong>用户 ID 查找</strong>：输入 24 位 Profile ID，精确查找单个帐号</li>
      <li>• <strong>名称搜索</strong>：输入关键词，搜索多个匹配帐号（需要 TikHub API Key）</li>
      <li>• <strong>CSV 文件导入</strong>：批量导入，必填字段 <code class="bg-rose-100 px-1 rounded">user_id</code>、<code class="bg-rose-100 px-1 rounded">nickname</code></li>
      <li>• 可选字段：<code class="bg-rose-100 px-1 rounded">avatar</code>（头像 URL）</li>
      <li>• 重复的 user_id 自动跳过</li>
    </ul>
  </div>

  <div class="card">
    <h3 class="font-semibold text-text-primary mb-3">📄 CSV 模板</h3>
    <pre class="bg-bg-secondary border border-border-primary rounded p-3 text-xs overflow-x-auto mb-3"><code>user_id,nickname,avatar
abc123example,博主A,https://example.com/avatar1.jpg</code></pre>
    <a href="data:text/csv;charset=utf-8,<%= CGI.escape("user_id,nickname,avatar\nabc123example,博主A,https://example.com/avatar1.jpg\ndef456example,博主B,https://example.com/avatar2.jpg") %>" download="rednote_accounts_template.csv" class="btn btn-secondary inline-flex items-center">
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
      下载 CSV 模板
    </a>
  </div>
</div>

<script>
  function showTab(tab) {
    document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
    document.querySelectorAll('.tab-button').forEach(el => {
      el.classList.remove('border-rose-500', 'text-rose-600');
      el.classList.add('border-transparent', 'text-text-secondary');
    });
    document.getElementById(tab + '-tab').classList.remove('hidden');
    const btn = document.getElementById('tab-' + tab);
    btn.classList.add('border-rose-500', 'text-rose-600');
    btn.classList.remove('border-transparent', 'text-text-secondary');
  }

  function updateFileName(input) {
    const el = document.getElementById('file-name');
    if (el) el.textContent = input.files[0]?.name ? '📎 ' + input.files[0].name : '';
  }

  function setupDropZone() {
    const zone = document.getElementById('drop-zone');
    if (!zone) return;
    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(e => zone.addEventListener(e, ev => { ev.preventDefault(); ev.stopPropagation(); }));
    ['dragenter', 'dragover'].forEach(e => zone.addEventListener(e, () => zone.classList.add('border-rose-500', 'bg-rose-50')));
    ['dragleave', 'drop'].forEach(e => zone.addEventListener(e, () => zone.classList.remove('border-rose-500', 'bg-rose-50')));
    zone.addEventListener('drop', ev => {
      const input = document.getElementById('file-upload');
      input.files = ev.dataTransfer.files;
      updateFileName(input);
    });
  }
  setupDropZone();

  const searchInput = document.getElementById('search-input');
  const searchForm = document.getElementById('search-form');
  if (searchInput && searchForm) {
    searchInput.addEventListener('keydown', e => {
      if (e.key === 'Enter') { e.preventDefault(); searchForm.requestSubmit(); }
    });
  }
</script>
