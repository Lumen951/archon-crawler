<%# 活动调研 tab 的批量操作条：调研账号没有抓取/标签操作，核心批量动作是周调研开关 %>
<div data-bulk-selector-target="actionBar"
     class="hidden fixed bottom-16 md:bottom-0 left-0 right-0 z-40 bg-bg-card border-t border-border-primary shadow-[0_-4px_20px_rgba(15,23,42,.1)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
    <!-- Select All Matching Banner -->
    <div data-select-all-banner class="hidden mb-3 p-2 bg-brand-soft rounded-lg flex items-center justify-between">
      <span class="text-sm text-brand font-medium">
        已选择全部 <span data-bulk-selector-target="matchingCount"><%= @total_filtered_count %></span> 个符合条件的活动
      </span>
      <button data-action="click->bulk-selector#deselectAllMatching" class="text-sm text-brand hover:text-brand-dark font-semibold">
        取消全选
      </button>
    </div>

    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
      <div class="flex items-center gap-2">
        <span class="text-sm text-text-secondary">已选</span>
        <span class="text-sm font-bold text-text-primary" data-bulk-selector-target="count">0</span>
        <span class="text-sm text-text-secondary">个活动</span>

        <button data-bulk-selector-target="selectMatching"
                data-action="click->bulk-selector#selectAllMatching"
                class="hidden text-sm text-brand hover:text-brand-dark font-semibold ml-2">
          选择全部 <%= @total_filtered_count %> 个
        </button>
      </div>

      <div class="flex-1 flex flex-col sm:flex-row items-start sm:items-center gap-3">
        <% if current_user_is_admin? %>
          <form data-action="submit->bulk-selector#prepareSubmit"
                action="<%= event_research_tasks_path %>" method="post"
                class="flex items-center">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <%= hidden_field_tag :scope, "event" %>
            <button type="submit" class="h-9 px-4 rounded-lg bg-brand text-white hover:bg-brand-dark text-sm font-semibold transition whitespace-nowrap inline-flex items-center gap-1.5">
              开始调研
            </button>
          </form>
          <!-- 周调研开关：活动账号的核心批量操作 -->
          <form data-action="submit->bulk-selector#prepareSubmit"
                action="<%= bulk_enable_weekly_research_accounts_path %>" method="post"
                class="flex items-center">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <%= hidden_field_tag :scope, "event" %>
            <button type="submit" class="h-9 px-4 rounded-lg bg-green-600 text-white hover:bg-green-700 text-sm font-semibold transition whitespace-nowrap inline-flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              开启周调研
            </button>
          </form>
          <form data-action="submit->bulk-selector#prepareSubmit"
                action="<%= bulk_disable_weekly_research_accounts_path %>" method="post"
                class="flex items-center">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <%= hidden_field_tag :scope, "event" %>
            <button type="submit" class="h-9 px-4 rounded-lg border border-border-primary bg-bg-card hover:bg-bg-secondary text-text-primary text-sm font-semibold transition whitespace-nowrap inline-flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
              </svg>
              关闭周调研
            </button>
          </form>
        <% end %>

        <!-- More Actions Dropdown -->
        <div data-controller="modal">
          <div class="relative" data-controller="dropdown">
            <button data-action="click->dropdown#toggle"
                    class="btn btn-default whitespace-nowrap">
              更多操作
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div data-dropdown-target="panel"
                 class="hidden absolute bottom-full left-0 mb-1 w-48 bg-bg-card border border-border-primary rounded-lg shadow-lg py-1 z-50">
              <form data-action="submit->bulk-selector#submitAndClose" action="<%= bulk_enable_accounts_path %>" method="post">
                <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                <%= hidden_field_tag :scope, "event" %>
                <button type="submit" class="w-full px-4 py-2 text-left text-sm text-text-primary hover:bg-bg-secondary transition inline-flex items-center gap-2">
                  <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  批量启用
                </button>
              </form>
              <form data-action="submit->bulk-selector#submitAndClose" action="<%= bulk_disable_accounts_path %>" method="post">
                <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                <%= hidden_field_tag :scope, "event" %>
                <button type="submit" class="w-full px-4 py-2 text-left text-sm text-text-primary hover:bg-bg-secondary transition inline-flex items-center gap-2">
                  <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  批量停用
                </button>
              </form>
              <div class="border-t border-border-primary my-1"></div>
              <button data-action="click->dropdown#toggle click->modal#open"
                      class="w-full px-4 py-2 text-left text-sm text-red-500 hover:bg-red-50 transition inline-flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                批量删除
              </button>
            </div>
          </div>
          <!-- Delete Confirmation Modal -->
          <div data-modal-target="dialog"
               class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 transition-opacity duration-200 opacity-0">
            <div data-modal-target="backdrop" data-modal-backdrop
                 class="absolute inset-0 bg-black/50 transition-opacity duration-200 opacity-0"></div>
            <div class="relative bg-bg-card rounded-lg shadow-xl max-w-md w-full overflow-hidden border border-border-primary">
              <div class="px-5 py-4 border-b border-border-primary">
                <h3 class="text-lg font-semibold text-text-primary">确认删除</h3>
              </div>
              <div class="p-5">
                <p class="text-sm text-text-secondary mb-2">确定要删除选中的活动吗？</p>
                <p class="text-sm text-red-500 font-medium">此操作不可撤销，将同时删除该活动的所有调研记录与通知。</p>
              </div>
              <div class="flex items-center justify-end gap-3 px-5 py-4 border-t border-border-primary">
                <button type="button" data-action="click->modal#close"
                        class="h-9 px-4 rounded-lg border border-border-primary bg-bg-card hover:bg-bg-secondary text-sm font-semibold transition">
                  取消
                </button>
                <form data-action="submit->bulk-selector#prepareSubmit"
                      action="<%= bulk_destroy_accounts_path %>" method="post" class="inline-flex">
                  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                  <%= hidden_field_tag :scope, "event" %>
                  <button type="submit" class="btn btn-danger">
                    确认删除
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>

        <button data-action="click->bulk-selector#clearAll"
                class="btn btn-default whitespace-nowrap">
          清除选择
        </button>
      </div>
    </div>
  </div>
</div>
