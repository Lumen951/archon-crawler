<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">导入 Twitter 帐号</h1>
      <p class="text-gray-600 mt-1">支持搜索导入和 CSV 文件导入</p>
    </div>
    <%= link_to "← 返回导入页", import_accounts_path, class: "btn btn-secondary" %>
  </div>

  <div class="card">
    <div class="border-b border-gray-200 mb-6">
      <nav class="-mb-px flex space-x-8">
        <button type="button" onclick="showTab('search')" id="tab-search" class="tab-button border-b-2 border-primary text-primary py-4 px-1 text-sm font-medium">搜索导入</button>
        <button type="button" onclick="showTab('upload')" id="tab-upload" class="tab-button border-b-2 border-transparent text-gray-500 hover:text-gray-700 py-4 px-1 text-sm font-medium">上传文件</button>
      </nav>
    </div>

    <div id="search-tab" class="tab-content">
      <%= form_with url: import_twitter_search_accounts_path, method: :get, local: true do %>
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Twitter 用户名</label>
            <input type="text" name="twitter_screen_names" placeholder="输入用户名，多个用逗号或空格分隔（支持 @ 前缀）"
                   class="w-full px-4 py-3 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-primary focus:border-transparent">
            <p class="mt-2 text-sm text-gray-500">系统将查找用户信息，先展示可勾选的预览列表，再导入选中的帐号。</p>
          </div>
          <div class="flex justify-end">
            <button type="submit" class="btn btn-primary">搜索并导入</button>
          </div>
        </div>
      <% end %>
    </div>

    <%= form_with url: import_twitter_file_accounts_path, method: :post, local: true, multipart: true do |f| %>
      <div id="upload-tab" class="tab-content hidden">
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">上传 CSV 文件</label>
            <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-lg hover:border-gray-400 transition-colors" id="drop-zone">
              <div class="space-y-1 text-center">
                <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                  <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <div class="flex text-sm text-gray-600">
                  <label for="file-upload" class="relative cursor-pointer bg-white rounded-md font-medium text-sky-600 hover:text-sky-700">
                    <span>上传文件</span>
                    <input id="file-upload" name="csv_file" type="file" accept=".csv" class="sr-only" onchange="updateFileName(this)">
                  </label>
                  <p class="pl-1">或拖放文件至此</p>
                </div>
                <p class="text-xs text-gray-500">支持 .csv 文件</p>
                <p id="file-name" class="text-sm text-gray-700 font-medium mt-2"></p>
              </div>
            </div>
          </div>
          <div class="flex justify-end">
            <button type="submit" class="btn btn-primary">从文件导入</button>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="card bg-sky-50 border-sky-200">
    <h3 class="font-semibold text-sky-900 mb-3">💡 导入提示</h3>
    <ul class="space-y-1 text-sm text-sky-800">
      <li>• 必填字段：<code class="bg-sky-100 px-1 rounded">screen_name</code>（Twitter 用户名）</li>
      <li>• 可选字段：<code class="bg-sky-100 px-1 rounded">user_id</code>（缺失时自动查找）、<code class="bg-sky-100 px-1 rounded">name</code>、<code class="bg-sky-100 px-1 rounded">image</code></li>
      <li>• CSV 内重复的 screen_name 自动去重</li>
    </ul>
  </div>

  <div class="card">
    <h3 class="font-semibold text-gray-900 mb-3">📄 CSV 模板</h3>
    <pre class="bg-gray-50 border border-gray-200 rounded p-3 text-xs overflow-x-auto mb-3"><code>screen_name,user_id,name,image
elonmusk,44196397,Elon Musk,https://pbs.twimg.com/profile_images/xxx.jpg
jack,,Jack Dorsey,</code></pre>
    <a href="data:text/csv;charset=utf-8,<%= CGI.escape("screen_name,user_id,name,image\nelonmusk,44196397,Elon Musk,https://pbs.twimg.com/profile_images/xxx.jpg\njack,,Jack Dorsey,") %>" download="twitter_accounts_template.csv" class="btn btn-secondary inline-flex items-center">
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
      下载 CSV 模板
    </a>
  </div>
</div>

<script>
  function showTab(tab) {
    document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
    document.querySelectorAll('.tab-button').forEach(el => {
      el.classList.remove('border-primary', 'text-primary');
      el.classList.add('border-transparent', 'text-gray-500');
    });
    document.getElementById(tab + '-tab').classList.remove('hidden');
    const btn = document.getElementById('tab-' + tab);
    btn.classList.add('border-primary', 'text-primary');
    btn.classList.remove('border-transparent', 'text-gray-500');
  }

  function updateFileName(input) {
    const el = document.getElementById('file-name');
    if (el) el.textContent = input.files[0]?.name ? '📎 ' + input.files[0].name : '';
  }

  function setupDropZone() {
    const zone = document.getElementById('drop-zone');
    if (!zone) return;
    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(e => zone.addEventListener(e, ev => { ev.preventDefault(); ev.stopPropagation(); }));
    ['dragenter', 'dragover'].forEach(e => zone.addEventListener(e, () => zone.classList.add('border-sky-500', 'bg-sky-50')));
    ['dragleave', 'drop'].forEach(e => zone.addEventListener(e, () => zone.classList.remove('border-sky-500', 'bg-sky-50')));
    zone.addEventListener('drop', ev => {
      const input = document.getElementById('file-upload');
      input.files = ev.dataTransfer.files;
      updateFileName(input);
    });
  }
  setupDropZone();
</script>
