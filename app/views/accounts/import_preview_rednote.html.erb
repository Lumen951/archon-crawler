<div class="space-y-6">
  <div class="flex items-center justify-between gap-4 flex-wrap">
    <div>
      <h1 class="text-2xl font-bold text-text-primary">用户查找结果</h1>
      <p class="text-text-secondary mt-1">Profile ID：<span class="font-semibold text-text-primary"><%= @user_info[:user_id] %></span></p>
    </div>
    <%= link_to "← 返回导入页", import_rednote_page_accounts_path, class: "btn btn-secondary" %>
  </div>

  <div class="card">
    <%= form_with url: import_rednote_by_id_accounts_path, method: :post, local: true do %>
      <div class="flex items-center gap-4 p-4 border border-border-primary rounded-lg bg-bg-card">
        <input type="checkbox"
               name="accounts_data[<%= @user_info[:user_id] %>][selected]"
               value="1"
               id="select-user"
               class="rounded border-border-primary text-rose-600 focus:ring-rose-500"
               checked>
        <label for="select-user" class="flex items-center gap-4 cursor-pointer flex-1">
          <% if @user_info[:image].present? %>
            <img src="<%= @user_info[:image] %>" alt="<%= @user_info[:nickname] %>" class="h-14 w-14 rounded-full flex-shrink-0">
          <% else %>
            <div class="h-14 w-14 rounded-full bg-bg-secondary flex-shrink-0 flex items-center justify-center text-text-muted">
              <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
            </div>
          <% end %>
          <div>
            <span class="font-medium text-text-primary text-lg"><%= @user_info[:nickname] %></span>
            <p class="text-sm text-text-secondary font-mono mt-1"><%= @user_info[:user_id] %></p>
          </div>
        </label>
      </div>

      <%= hidden_field_tag "accounts_data[#{@user_info[:user_id]}][nickname]", @user_info[:nickname] %>
      <%= hidden_field_tag "accounts_data[#{@user_info[:user_id]}][image]", @user_info[:image] %>

      <div class="mt-5 flex justify-end gap-2">
        <%= link_to "重新查找", import_rednote_page_accounts_path, class: "btn btn-secondary" %>
        <button type="submit" class="btn btn-primary">导入选中帐号</button>
      </div>
    <% end %>
  </div>
</div>
