<div class="space-y-6">
  <div class="flex items-center justify-between gap-4 flex-wrap">
    <div>
      <h1 class="text-2xl font-bold text-text-primary">搜索结果预览</h1>
      <p class="text-text-secondary mt-1">关键词：<span class="font-semibold text-text-primary"><%= @keyword %></span></p>
    </div>
    <%= link_to "← 返回导入页", import_wechat_page_accounts_path, class: "btn btn-secondary" %>
  </div>

  <div class="card">
    <%= form_with url: import_wechat_accounts_path, method: :post, local: true, id: "search-preview-form" do %>
      <div class="flex items-center justify-between gap-3 mb-4">
        <div class="text-sm text-text-secondary">共 <span class="font-semibold text-text-primary"><%= @search_accounts.size %></span> 条结果，请勾选要导入的帐号</div>
        <label class="inline-flex items-center gap-2 text-sm text-text-primary select-none">
          <input type="checkbox" id="select-all-accounts" class="rounded border-border-primary text-primary focus:ring-primary">
          全选
        </label>
      </div>

      <div class="overflow-x-auto border border-border-primary rounded-lg">
        <table class="min-w-full divide-y divide-border-primary">
          <thead class="bg-bg-secondary">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">选择</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">帐号</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">Fakeid</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-text-secondary uppercase tracking-wider">文章数</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border-primary bg-bg-card">
            <% @search_accounts.each_with_index do |account, idx| %>
              <% fakeid = account[:fakeid] || account["fakeid"] %>
              <% nickname = account[:nickname] || account["nickname"] %>
              <% round_head_img = account[:round_head_img] || account["round_head_img"] %>
              <% total_articles = account[:total_articles] || account["total_articles"] || 0 %>
              <tr class="hover:bg-bg-secondary transition">
                <td class="px-4 py-3 align-top">
                  <input type="checkbox"
                         name="selected_fakeids[]"
                         value="<%= fakeid %>"
                         id="selected-fakeid-<%= idx %>"
                         class="account-checkbox rounded border-border-primary text-primary focus:ring-primary"
                         checked>
                </td>
                <td class="px-4 py-3">
                  <label for="selected-fakeid-<%= idx %>" class="cursor-pointer flex items-center gap-3">
                    <% if round_head_img.present? %>
                      <img src="<%= round_head_img %>" alt="<%= nickname %>" class="h-10 w-10 rounded-full flex-shrink-0">
                    <% else %>
                      <div class="h-10 w-10 rounded-full bg-bg-secondary flex-shrink-0"></div>
                    <% end %>
                    <span class="font-medium text-text-primary"><%= nickname %></span>
                  </label>
                </td>
                <td class="px-4 py-3 text-sm text-text-secondary font-mono"><%= fakeid %></td>
                <td class="px-4 py-3 text-sm text-text-primary"><%= total_articles %></td>
              </tr>

              <%= hidden_field_tag "accounts_data[#{fakeid}][nickname]", nickname %>
              <%= hidden_field_tag "accounts_data[#{fakeid}][round_head_img]", round_head_img %>
              <%= hidden_field_tag "accounts_data[#{fakeid}][total_articles]", total_articles %>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="mt-5 flex justify-end gap-2">
        <%= link_to "重新搜索", import_wechat_page_accounts_path, class: "btn btn-secondary" %>
        <button type="submit" class="btn btn-primary">导入选中帐号</button>
      </div>
    <% end %>
  </div>
</div>

<script>
const selectAllAccounts = document.getElementById('select-all-accounts');
const accountCheckboxes = document.querySelectorAll('.account-checkbox');

if (selectAllAccounts) {
  selectAllAccounts.addEventListener('change', (e) => {
    accountCheckboxes.forEach((checkbox) => {
      checkbox.checked = e.target.checked;
    });
  });

  accountCheckboxes.forEach((checkbox) => {
    checkbox.addEventListener('change', () => {
      const allChecked = Array.from(accountCheckboxes).every((item) => item.checked);
      selectAllAccounts.checked = allChecked;
    });
  });

  const allCheckedOnLoad = Array.from(accountCheckboxes).every((item) => item.checked);
  selectAllAccounts.checked = allCheckedOnLoad;
}
</script>
