<div class="flex gap-8 max-w-5xl mx-auto">
  <!-- Sidebar Navigation -->
  <nav class="w-48 flex-shrink-0">
    <div class="sticky top-6">
      <ul class="space-y-1">
        <li>
          <a href="#profile" class="block px-3 py-2 text-sm font-medium text-brand bg-brand-soft rounded-lg">个人资料</a>
        </li>
        <li>
          <a href="#password" class="block px-3 py-2 text-sm font-medium text-text-primary hover:bg-bg-secondary rounded-lg">修改密码</a>
        </li>
        <li>
          <a href="#followed-tags" class="block px-3 py-2 text-sm font-medium text-text-primary hover:bg-bg-secondary rounded-lg">关注标签</a>
        </li>
        <li>
          <a href="#api-keys" class="block px-3 py-2 text-sm font-medium text-text-primary hover:bg-bg-secondary rounded-lg">API Key 管理</a>
        </li>
      </ul>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="flex-1 space-y-8">
    <!-- 个人资料 Section -->
    <section id="profile">
      <div class="bg-bg-card rounded-lg shadow-sm p-6">
        <h2 class="text-2xl font-bold mb-6">个人资料</h2>

        <%= form_with(model: @user, url: profile_path, method: :patch, local: true, class: "space-y-6") do |f| %>
          <div>
            <%= f.label :email_address, "邮箱", class: "block text-sm font-medium text-text-primary mb-1" %>
            <%= f.email_field :email_address, class: "form-input", readonly: true, disabled: true %>
            <p class="text-sm text-text-secondary mt-1">邮箱地址不可修改</p>
          </div>

          <div>
            <%= f.label :name, "姓名", class: "block text-sm font-medium text-text-primary mb-1" %>
            <%= f.text_field :name, class: "form-input" %>
          </div>

          <div class="flex justify-end">
            <%= f.submit "保存", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </section>

    <!-- 修改密码 Section -->
    <section id="password">
      <div class="bg-bg-card rounded-lg shadow-sm p-6">
        <h2 class="text-2xl font-bold mb-6">修改密码</h2>

        <%= form_with(url: update_password_profile_path, method: :patch, local: true, class: "space-y-6") do |f| %>
          <div>
            <%= label_tag :current_password, "当前密码", class: "block text-sm font-medium text-text-primary mb-1" %>
            <%= password_field_tag :current_password, nil, class: "form-input", required: true %>
          </div>

          <div>
            <%= label_tag :new_password, "新密码", class: "block text-sm font-medium text-text-primary mb-1" %>
            <%= password_field_tag :new_password, nil, class: "form-input", required: true %>
            <p class="text-sm text-text-secondary mt-1">至少8个字符</p>
          </div>

          <div>
            <%= label_tag :password_confirmation, "确认新密码", class: "block text-sm font-medium text-text-primary mb-1" %>
            <%= password_field_tag :password_confirmation, nil, class: "form-input", required: true %>
          </div>

          <div class="flex justify-end">
            <%= submit_tag "更新密码", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </section>

    <!-- 关注标签 Section -->
    <section id="followed-tags">
      <div class="bg-bg-card rounded-lg shadow-sm p-6">
        <h2 class="text-2xl font-bold mb-2">关注标签</h2>
        <p class="text-sm text-text-secondary mb-6">选择你关注的标签，仪表盘和 RSS 将只显示这些标签下的帐号文章。不选择任何标签则显示全部。</p>

        <% tags = Tag.ordered %>
        <% if tags.any? %>
          <%= form_with url: update_followed_tags_profile_path, method: :patch, local: true do |f| %>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 mb-6">
              <% tags.each do |tag| %>
                <% followed = @user.followed_tags.include?(tag) %>
                <label class="flex items-center gap-2 p-3 rounded-lg border cursor-pointer transition <%= followed ? 'border-brand bg-brand-soft' : 'border-border-primary hover:border-border-primary' %>">
                  <%= check_box_tag "tag_ids[]", tag.id, followed, class: "rounded border-border-primary text-brand focus:ring-brand" %>
                  <span class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: <%= tag.color %>"></span>
                  <span class="text-sm font-medium text-text-primary"><%= tag.name %></span>
                  <span class="text-xs text-text-muted ml-auto"><%= tag.tag_accounts_count %></span>
                </label>
              <% end %>
            </div>
            <div class="flex justify-end">
              <%= f.submit "保存", class: "btn btn-primary" %>
            </div>
          <% end %>
        <% else %>
          <p class="text-sm text-text-secondary text-center py-4">暂无标签。管理员可在帐号管理页面批量创建标签。</p>
        <% end %>
      </div>
    </section>

    <!-- API Key 管理 Section -->
    <section id="api-keys">
      <div class="bg-bg-card rounded-lg shadow-sm p-6">
        <h2 class="text-2xl font-bold mb-6">API Key 管理</h2>

        <% if flash[:api_key_token].present? %>
          <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg">
            <div class="flex items-start justify-between gap-3">
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-green-800 mb-2">✅ API Key 已生成，请立即复制保存：</p>
                <code class="block p-3 bg-bg-card border border-green-300 rounded text-sm font-mono break-all text-green-900"><%= flash[:api_key_token] %></code>
                <p class="text-xs text-green-600 mt-1">此 token 不会再次完整显示，但可通过列表中的复制按钮随时复制。</p>
              </div>
              <button type="button"
                      onclick="copyToken(this, '<%= flash[:api_key_token] %>')"
                      class="btn btn-default btn-sm">
                复制
              </button>
            </div>
          </div>
        <% end %>

        <%# Generate new key form %>
        <%= form_with url: create_api_key_profile_path, method: :post, local: true, class: "mb-6" do |f| %>
          <div class="flex items-end gap-3">
            <div class="flex-1">
              <label class="block text-sm font-medium text-text-primary mb-1">Key 名称</label>
              <%= text_field_tag :api_key_name, nil, placeholder: "例如：我的应用", class: "form-input" %>
            </div>
            <button type="submit" class="btn btn-primary whitespace-nowrap">
              生成 API Key
            </button>
          </div>
        <% end %>

        <%# Key list %>
        <% if @api_keys.any? %>
          <div class="space-y-3">
            <% @api_keys.each do |key| %>
              <div class="flex items-center justify-between gap-3 p-3 border border-border-primary rounded-lg <%= key.active? ? 'bg-bg-card' : 'bg-bg-secondary opacity-60' %>">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2">
                    <span class="font-medium text-text-primary"><%= key.name %></span>
                    <% if key.active? %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">Active</span>
                    <% else %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-bg-secondary text-text-secondary">Revoked</span>
                    <% end %>
                  </div>
                  <div class="text-sm text-text-secondary mt-1">
                    <span class="font-mono"><%= key.token.to_s[0..7] %>****</span>
                    <span class="ml-2">创建于 <%= key.created_at.strftime("%Y-%m-%d %H:%M") %></span>
                  </div>
                </div>
                <div class="flex items-center gap-2 flex-shrink-0">
                  <% if key.active? %>
                    <button type="button"
                            onclick="copyToken(this, '<%= key.token %>')"
                            class="px-3 py-1.5 text-sm border border-border-primary rounded-md text-text-primary hover:bg-bg-secondary transition-colors"
                            title="复制完整 token">
                      复制
                    </button>
                    <%= button_to "撤销", revoke_api_key_profile_path(api_key_id: key.id),
                        method: :delete,
                        class: "px-3 py-1.5 text-sm border border-red-300 rounded-md text-red-700 hover:bg-red-50 transition-colors",
                        data: { turbo_confirm: "确定撤销 Key \"#{key.name}\"？撤销后使用该 Key 的 API 调用将立即失效。" } %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-text-secondary text-center py-4">暂无 API Key</p>
        <% end %>
      </div>
    </section>
  </div>
</div>

<script>
// Highlight active sidebar link on scroll
document.addEventListener('turbo:load', function() {
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('nav a[href^="#"]');

  function updateActiveLink() {
    let current = '';
    sections.forEach(section => {
      const sectionTop = section.offsetTop;
      if (window.scrollY >= sectionTop - 100) {
        current = section.getAttribute('id');
      }
    });

    navLinks.forEach(link => {
      link.classList.remove('text-brand', 'bg-brand-soft');
      link.classList.add('text-text-primary');
      if (link.getAttribute('href') === '#' + current) {
        link.classList.add('text-brand', 'bg-brand-soft');
        link.classList.remove('text-text-primary');
      }
    });
  }

  window.addEventListener('scroll', updateActiveLink);
  updateActiveLink();
});

function copyToken(btn, token) {
  navigator.clipboard.writeText(token).then(() => {
    const original = btn.textContent;
    btn.textContent = '已复制 ✓';
    btn.classList.add('bg-green-50', 'border-green-300', 'text-green-700');
    setTimeout(() => {
      btn.textContent = original;
      btn.classList.remove('bg-green-50', 'border-green-300', 'text-green-700');
    }, 2000);
  }).catch(() => {
    // Fallback for older browsers
    const textarea = document.createElement('textarea');
    textarea.value = token;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    document.execCommand('copy');
    document.body.removeChild(textarea);
    const original = btn.textContent;
    btn.textContent = '已复制 ✓';
    setTimeout(() => { btn.textContent = original; }, 2000);
  });
}
</script>
