<div class="flex gap-8 max-w-5xl mx-auto">
  <!-- Sidebar Navigation -->
  <nav class="w-48 flex-shrink-0">
    <div class="sticky top-6">
      <ul class="space-y-1">
        <li>
          <a href="#profile" class="block px-3 py-2 text-sm font-medium text-blue-600 bg-blue-50 rounded-lg">个人资料</a>
        </li>
        <li>
          <a href="#password" class="block px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 rounded-lg">修改密码</a>
        </li>
        <li>
          <a href="#api-keys" class="block px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 rounded-lg">API Key 管理</a>
        </li>
      </ul>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="flex-1 space-y-8">
    <!-- 个人资料 Section -->
    <section id="profile">
      <div class="bg-white rounded-lg shadow-sm p-6">
        <h2 class="text-2xl font-bold mb-6">个人资料</h2>

        <%= form_with(model: @user, url: profile_path, method: :patch, local: true, class: "space-y-6") do |f| %>
          <div>
            <%= f.label :email_address, "邮箱", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.email_field :email_address, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500", readonly: true, disabled: true %>
            <p class="text-sm text-gray-500 mt-1">邮箱地址不可修改</p>
          </div>

          <div>
            <%= f.label :name, "姓名", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500" %>
          </div>

          <div class="flex justify-end">
            <%= f.submit "保存", class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700" %>
          </div>
        <% end %>
      </div>
    </section>

    <!-- 修改密码 Section -->
    <section id="password">
      <div class="bg-white rounded-lg shadow-sm p-6">
        <h2 class="text-2xl font-bold mb-6">修改密码</h2>

        <%= form_with(url: update_password_profile_path, method: :patch, local: true, class: "space-y-6") do |f| %>
          <div>
            <%= label_tag :current_password, "当前密码", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= password_field_tag :current_password, nil, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500", required: true %>
          </div>

          <div>
            <%= label_tag :new_password, "新密码", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= password_field_tag :new_password, nil, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500", required: true %>
            <p class="text-sm text-gray-500 mt-1">至少8个字符</p>
          </div>

          <div>
            <%= label_tag :password_confirmation, "确认新密码", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= password_field_tag :password_confirmation, nil, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500", required: true %>
          </div>

          <div class="flex justify-end">
            <%= submit_tag "更新密码", class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700" %>
          </div>
        <% end %>
      </div>
    </section>

    <!-- API Key 管理 Section -->
    <section id="api-keys">
      <div class="bg-white rounded-lg shadow-sm p-6">
        <h2 class="text-2xl font-bold mb-6">API Key 管理</h2>

        <% if flash[:api_key_token].present? %>
          <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg">
            <div class="flex items-start justify-between gap-3">
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-green-800 mb-2">✅ API Key 已生成，请立即复制保存：</p>
                <code class="block p-3 bg-white border border-green-300 rounded text-sm font-mono break-all text-green-900"><%= flash[:api_key_token] %></code>
                <p class="text-xs text-green-600 mt-1">此 token 不会再次完整显示，但可通过列表中的复制按钮随时复制。</p>
              </div>
              <button type="button"
                      onclick="copyToken(this, '<%= flash[:api_key_token] %>')"
                      class="flex-shrink-0 px-3 py-2 text-sm bg-green-600 text-white rounded-md hover:bg-green-700 transition-colors">
                复制
              </button>
            </div>
          </div>
        <% end %>

        <%# Generate new key form %>
        <%= form_with url: create_api_key_profile_path, method: :post, local: true, class: "mb-6" do |f| %>
          <div class="flex items-end gap-3">
            <div class="flex-1">
              <label class="block text-sm font-medium text-gray-700 mb-1">Key 名称</label>
              <%= text_field_tag :api_key_name, nil, placeholder: "例如：我的应用", class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500" %>
            </div>
            <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 whitespace-nowrap">
              生成 API Key
            </button>
          </div>
        <% end %>

        <%# Key list %>
        <% if @api_keys.any? %>
          <div class="space-y-3">
            <% @api_keys.each do |key| %>
              <div class="flex items-center justify-between gap-3 p-3 border border-gray-200 rounded-lg <%= key.active? ? 'bg-white' : 'bg-gray-50 opacity-60' %>">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2">
                    <span class="font-medium text-gray-900"><%= key.name %></span>
                    <% if key.active? %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">Active</span>
                    <% else %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600">Revoked</span>
                    <% end %>
                  </div>
                  <div class="text-sm text-gray-500 mt-1">
                    <span class="font-mono"><%= key.token.to_s[0..7] %>****</span>
                    <span class="ml-2">创建于 <%= key.created_at.strftime("%Y-%m-%d %H:%M") %></span>
                  </div>
                </div>
                <div class="flex items-center gap-2 flex-shrink-0">
                  <% if key.active? %>
                    <button type="button"
                            onclick="copyToken(this, '<%= key.token %>')"
                            class="px-3 py-1.5 text-sm border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition-colors"
                            title="复制完整 token">
                      复制
                    </button>
                    <%= button_to "撤销", revoke_api_key_profile_path(api_key_id: key.id),
                        method: :delete,
                        class: "px-3 py-1.5 text-sm border border-red-300 rounded-md text-red-700 hover:bg-red-50 transition-colors",
                        data: { turbo_confirm: "确定撤销 Key \"#{key.name}\"？撤销后使用该 Key 的 API 调用将立即失效。" } %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-gray-500 text-center py-4">暂无 API Key</p>
        <% end %>
      </div>
    </section>
  </div>
</div>

<script>
// Highlight active sidebar link on scroll
document.addEventListener('turbo:load', function() {
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('nav a[href^="#"]');

  function updateActiveLink() {
    let current = '';
    sections.forEach(section => {
      const sectionTop = section.offsetTop;
      if (window.scrollY >= sectionTop - 100) {
        current = section.getAttribute('id');
      }
    });

    navLinks.forEach(link => {
      link.classList.remove('text-blue-600', 'bg-blue-50');
      link.classList.add('text-gray-700');
      if (link.getAttribute('href') === '#' + current) {
        link.classList.add('text-blue-600', 'bg-blue-50');
        link.classList.remove('text-gray-700');
      }
    });
  }

  window.addEventListener('scroll', updateActiveLink);
  updateActiveLink();
});

function copyToken(btn, token) {
  navigator.clipboard.writeText(token).then(() => {
    const original = btn.textContent;
    btn.textContent = '已复制 ✓';
    btn.classList.add('bg-green-50', 'border-green-300', 'text-green-700');
    setTimeout(() => {
      btn.textContent = original;
      btn.classList.remove('bg-green-50', 'border-green-300', 'text-green-700');
    }, 2000);
  }).catch(() => {
    // Fallback for older browsers
    const textarea = document.createElement('textarea');
    textarea.value = token;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    document.execCommand('copy');
    document.body.removeChild(textarea);
    const original = btn.textContent;
    btn.textContent = '已复制 ✓';
    setTimeout(() => { btn.textContent = original; }, 2000);
  });
}
</script>
