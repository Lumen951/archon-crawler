<div class="bg-bg-card border border-border-primary rounded-2xl p-5 shadow-[0_1px_0_rgba(255,255,255,.9),0_18px_55px_rgba(15,23,42,.055)]">
  <h3 class="text-sm font-semibold text-text-primary mb-4">各活跃度组抓取进度</h3>
  <% labels = {
      active: "🟢 活跃 (7天内)",
      slow: "🟡 减速 (8-30天)",
      dormant: "🟠 停更 (31-90天)",
      dead: "🔴 失活 (90天+)",
      never: "⚪ 从未发布",
      uncrawled: "🌫️ 从未抓取",
    } %>
  <div class="space-y-4">
    <% @crawl_progress.each do |row| %>
      <div>
        <div class="flex items-center justify-between gap-3 mb-1.5">
          <div class="flex items-baseline gap-2 min-w-0">
            <span class="text-sm text-text-secondary flex-shrink-0"><%= labels[row[:key]] %></span>
            <span class="text-xs text-text-muted flex-shrink-0">已抓取 <%= row[:crawled] %> / <%= row[:total] %></span>
          </div>
          <span class="text-sm font-semibold flex-shrink-0 <%= row[:due] > 0 ? 'text-brand' : 'text-text-muted' %>"><%= row[:due] %> 待抓取</span>
        </div>
        <div class="bg-bg-secondary rounded-full h-6 overflow-hidden">
          <% if row[:pct] > 0 %>
            <div class="h-full bg-brand rounded-full transition-all duration-500 flex items-center justify-end pr-2" style="width: <%= row[:pct] %>%">
              <span class="text-xs font-semibold text-white"><%= row[:pct] %>%</span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
