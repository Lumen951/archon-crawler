<header class="sticky top-0 z-30 backdrop-blur-md bg-bg-header border-b border-border-primary">
  <div class="w-full px-4 sm:px-6 h-12 flex items-center justify-between gap-3">
    <div class="flex items-center gap-1.5 min-w-0">
      <% if current_user %>
        <button type="button" data-action="click->sidebar#open" aria-label="打开导航"
                class="lg:hidden h-9 w-9 inline-flex items-center justify-center rounded-md text-text-secondary hover:bg-bg-secondary transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      <% end %>
      <%= link_to root_path, class: "flex items-center gap-2.5 hover:opacity-80 transition" do %>
        <div class="w-7 h-7 rounded-md bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
        </div>
        <span class="text-sm font-bold text-text-primary hidden sm:block">MP-Crawler</span>
      <% end %>
    </div>

    <% if current_user %>
      <div class="flex items-center gap-1">
        <div class="relative" data-controller="dropdown">
          <button data-action="click->dropdown#toggle" class="h-9 flex items-center gap-2 px-2 sm:px-3 rounded-md hover:bg-bg-secondary transition">
            <div class="w-7 h-7 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center text-white text-xs font-bold">
              <%= current_user.email_address[0].upcase %>
            </div>
            <span class="text-sm font-medium hidden sm:block"><%= current_user.name.presence || current_user.email_address.split('@').first %></span>
            <svg class="w-3.5 h-3.5 text-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>

          <div data-dropdown-target="panel" class="hidden absolute right-0 top-12 w-64 max-h-[calc(100vh-4rem)] overflow-y-auto bg-bg-card rounded-lg border border-border-primary shadow-lg z-50">
            <div class="flex items-center gap-3 px-4 py-3 border-b border-border-primary">
              <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center text-white font-bold">
                <%= current_user.email_address[0].upcase %>
              </div>
              <div class="min-w-0 flex-1">
                <p class="font-semibold text-sm truncate"><%= current_user.name.presence || current_user.email_address.split('@').first %></p>
                <p class="text-xs text-text-secondary truncate"><%= current_user.email_address %></p>
              </div>
            </div>

            <!-- 账户 -->
            <div class="py-1">
              <p class="px-4 pb-1 text-xs font-semibold text-text-secondary uppercase tracking-wider">账户</p>
              <%= link_to edit_profile_path, class: "w-full flex items-center gap-3 px-4 py-2 text-sm hover:bg-bg-secondary transition" do %>
                <svg class="w-4 h-4 text-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                个人资料
              <% end %>
            </div>

            <div class="border-t border-border-primary py-1">
              <%= button_to session_path, method: :delete, class: "w-full flex items-center gap-3 px-4 py-2 text-sm hover:bg-bg-secondary transition text-left" do %>
                <svg class="w-4 h-4 text-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                </svg>
                <span class="text-error">退出登录</span>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% else %>
      <%= link_to new_session_path, class: "btn btn-default" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
        </svg>
        登录
      <% end %>
    <% end %>
  </div>
</header>
