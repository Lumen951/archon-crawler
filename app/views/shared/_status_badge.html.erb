<%
  badge_class = case status.to_s
                when 'completed', 'active', 'sent'
                  'success'
                when 'running', 'pending'
                  'info'
                when 'paused'
                  'warning'
                when 'failed', 'inactive'
                  'error'
                when 'stale', 'skipped'
                  'secondary'
                else
                  'secondary'
                end
  status_label = case status.to_s
                 when 'completed'
                   '已完成'
                 when 'running'
                   '运行中'
                 when 'paused'
                   '已暂停'
                 when 'pending'
                   '待处理'
                 when 'failed'
                   '失败'
                 when 'active'
                   '启用'
                 when 'inactive'
                   '停用'
                 when 'stale'
                   '已过期'
                 when 'sent'
                   '已发送'
                 when 'skipped'
                   '已跳过'
                 else
                   status.to_s.humanize
                 end
%>
<span class="status-badge <%= badge_class %>">
  <%= status_label %>
</span>
