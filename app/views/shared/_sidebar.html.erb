%>

<nav class="flex min-h-full flex-col px-3 pt-3 pb-8" aria-label="主导航">
  <ul class="space-y-0.5">
    <li>
      <%= link_to root_path, class: "sidebar-link #{'active' if request.path == '/'}" do %>
        <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        <span>工作台</span>
      <% end %>
    </li>
  </ul>

  <p class="sidebar-section-title">内容与追踪</p>
  <ul class="space-y-0.5">
    <% content_items.each do |item| %>
      <li>
        <%= link_to item[:path], class: "sidebar-link #{'active' if item[:active]}" do %>
          <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="<%= item[:icon] %>"/></svg>
          <span><%= item[:label] %></span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <p class="sidebar-section-title">开发者</p>
  <ul class="space-y-0.5">
    <% developer_items.each do |item| %>
      <li>
        <%= link_to item[:path], class: "sidebar-link #{'active' if item[:active]}" do %>
          <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="<%= item[:icon] %>"/></svg>
          <span><%= item[:label] %></span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <% if current_user_is_admin? %>
    <p class="sidebar-section-title">管理</p>
    <ul class="space-y-0.5">
      <% admin_items.each do |item| %>
        <li>
          <%= link_to item[:path], class: "sidebar-link #{'active' if item[:active]}", target: item[:path] == "/admin/jobs" ? "_blank" : nil do %>
            <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="<%= item[:icon] %>"/></svg>
            <span><%= item[:label] %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</nav>
